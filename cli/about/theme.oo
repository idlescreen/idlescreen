// # About Theme Link - ootheme Resolution
//
// Logline: Resolves the active ootheme (--theme, OOTHEME, ootheme/current, OODA_THEME) and NO_COLOR.
// Setup: Requires FsReadCap for the theme file and the environ block, ProcessCap for the parent-environ probe.
// Beats:
//   1. idlescreen_ootheme_extract strips --theme/--theme= from argv before verb parsing.
//   2. idlescreen_theme_pick applies flag > OOTHEME > current file > OODA_THEME > legacy file precedence.
//   3. idlescreen_ootheme_suppressed reports NO_COLOR, OO_NO_COLOR, or OODA_NO_COLOR.

import "oostd/fs/os/fs/fs.oo";
import "core/environ.oo";

type OothemeLink = struct {
    args: List[String],
    theme: String
};

fn theme_env(fs_r: &FsReadCap, proc: &ProcessCap, key: String) -> String {
    return host_env(fs_r, proc, key);
}

fn theme_home(fs_r: &FsReadCap, proc: &ProcessCap) -> String {
    let h: String = theme_env(fs_r, proc, "HOME");
    if h != "" { return h; }
    return theme_env(fs_r, proc, "OODA_HOME");
}

fn theme_kv(line: String) -> String {
    let t: String = str_trim(line);
    if !str_starts_with(t, "theme") { return ""; }
    let rest: String = str_trim(str_slice(t, 5, chars_len(t)));
    if !str_starts_with(rest, "=") { return ""; }
    let mut v: String = str_trim(str_slice(rest, 1, chars_len(rest)));
    let vn: Int = chars_len(v);
    if vn >= 2 && str_starts_with(v, "\"") && str_ends_with(v, "\"") {
        v = str_slice(v, 1, vn - 1);
    }
    return v;
}

fn theme_file(fs_r: &FsReadCap, path: String) -> String {
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return ""; }
    let content: String = str_trim(match r { Ok(s) => s, Err(_) => "" });
    if content == "" { return ""; }
    if str_contains(content, "=") {
        let mut cur: String = "";
        let mut i: Int = 0;
        let n: Int = chars_len(content);
        while i < n {
            let c: String = char_at(content, i);
            if c == "\n" {
                let t: String = theme_kv(cur);
                if t != "" { return t; }
                cur = "";
            } else if c != "\r" {
                cur = cur + c;
            }
            i = i + 1;
        }
        return theme_kv(cur);
    }
    return content;
}

pub fn idlescreen_ootheme_extract(args: List[String]) -> OothemeLink {
    let mut out: List[String] = list_new();
    let mut theme: String = "";
    let mut stop: Bool = false;
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if stop {
            out = list_push(out, a);
        } else if a == "--" {
            stop = true;
            out = list_push(out, a);
        } else if a == "--theme" {
            if i + 1 < list_len(args) {
                theme = list_get(args, i + 1);
                i = i + 1;
            }
        } else if str_starts_with(a, "--theme=") {
            theme = str_slice(a, 8, chars_len(a));
        } else {
            out = list_push(out, a);
        }
        i = i + 1;
    }
    return OothemeLink { args: out, theme: theme };
}

pub fn idlescreen_theme_pick(fs_r: &FsReadCap, proc: &ProcessCap, flag_theme: String) -> String {
    if flag_theme != "" { return flag_theme; }
    let ot: String = theme_env(fs_r, proc, "OOTHEME");
    if ot != "" { return ot; }
    let home: String = theme_home(fs_r, proc);
    if home != "" {
        let cur: String = if str_ends_with(home, "/") {
            home + ".config/ootheme/current"
        } else {
            home + "/.config/ootheme/current"
        };
        let t: String = theme_file(fs_r, cur);
        if t != "" { return t; }
    }
    let od: String = theme_env(fs_r, proc, "OODA_THEME");
    if od != "" { return od; }
    if home != "" {
        let leg: String = if str_ends_with(home, "/") {
            home + ".openooda/theme.oot"
        } else {
            home + "/.openooda/theme.oot"
        };
        let t2: String = theme_file(fs_r, leg);
        if t2 != "" { return t2; }
    }
    return "";
}

pub fn idlescreen_ootheme_suppressed(fs_r: &FsReadCap, proc: &ProcessCap) -> Bool {
    if theme_env(fs_r, proc, "NO_COLOR") != "" { return true; }
    if theme_env(fs_r, proc, "OO_NO_COLOR") != "" { return true; }
    return theme_env(fs_r, proc, "OODA_NO_COLOR") != "";
}
