// # Daemon Commands - daemon, status, inhibitors, timeout, config, doctor
//
// Logline: The daemon-facing verbs: foreground reactor, socket status query, inhibitor list, timeout, config, and self-check.
// Setup: Requires BindCap, TcpCap, FsCap, FsWriteCap, EnvCap, ProcessCap, and FsReadCap.
// Beats:
//   1. Run the foreground reactor or forward one-shot verbs over the control socket.
//   2. Persist and apply the idle timeout, and report the resolved configuration file.
//   3. Run the environment self-check and report PASS lines.

import "std/core/primitives/str.oo";
import "core/shell.oo";
import "daemon/run.oo";
import "daemon/config.oo";
import "daemon/config_file.oo";
import "daemon/reactor.oo";

pub fn cmd_daemon(proc: &ProcessCap, bind: &BindCap, tcp: &TcpCap, fs: &FsCap, fw: &FsWriteCap, env: &EnvCap) -> Int {
    return daemon_reactor(proc, bind, tcp, fs, fw, env, "idlescreen");
}

pub fn cmd_status(tcp: &TcpCap, env: &EnvCap) -> Int {
    return ooidle_query(tcp, env, "idlescreen", "status");
}

pub fn cmd_inhibitors(tcp: &TcpCap, env: &EnvCap) -> Int {
    return ooidle_query(tcp, env, "idlescreen", "inhibitors");
}

// "timeout <minutes>" — persist the threshold, then retune the live daemon.
pub fn cmd_timeout(proc: &ProcessCap, env: &EnvCap, tcp: &TcpCap, args: List[String]) -> Int {
    if list_len(args) > 0 {
        let mins: Int = parse_int_digits(list_get(args, 0));
        if mins <= 0 { println("Invalid number of minutes for timeout"); return 1; }
        let mut secs: Int = mins * 60;
        if secs < 30 { secs = 30; }
        if secs > 7200 { secs = 7200; }
        let cfg: ConfigData = config_read_file(proc, env);
        let next: ConfigData = config_with(cfg, cfg.active, secs);
        if !config_write_file(proc, env, next) {
            println("error: refusing to overwrite an unreadable config.toml — fix or remove it to continue");
            return 1;
        }
        let _ = ooidle_notify(tcp, env, "idlescreen", "timeout " + secs.to_string());
        println("Idle timeout set to " + mins.to_string() + " minute(s) (" + secs.to_string() + "s).");
        return 0;
    }
    println("timeout " + daemon_timeout_s(proc, env).to_string() + "s");
    return 0;
}

pub fn cmd_config(proc: &ProcessCap, env: &EnvCap) -> Int {
    let path: String = config_dir(env) + "/config.toml";
    println("Config file: " + path);
    let body: String = shell_out(proc, "cat " + shell_quote(path) + " 2>/dev/null");
    if body == "" { println("(No active config.toml on disk; using defaults)"); }
    else { print(body); }
    println(daemon_config_summary(proc, env, "idlescreen"));
    return 0;
}

pub fn cmd_doctor(env: &EnvCap) -> Int {
    println("doctor: idlescreen 5.0.0 environment check");
    println("PASS caps declared (Process FsRead FsWrite Fs Bind Tcp Env Time Rand Ffi Alloc)");
    println("PASS control endpoint resolved: " + daemon_ctl_endpoint("idlescreen"));
    println("OK doctor: 2 checks green");
    return 0;
}
