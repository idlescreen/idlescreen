// # Preview Commands - batch and interactive scene rendering
//
// Logline: Render scene frames in batch mode or drive the live interactive preview with keyboard scene switching.
// Setup: Requires FsReadCap/ProcessCap for config, FfiCap for terminal I/O, TimeCap for pacing, and ArenaCap for frame buffers.
// Beats:
//   1. Parse preview arguments fail-closed: unknown flags, missing values, and non-digit numerics are ERR replies.
//   2. Bound numerics (frames <= 10000, cols/rows <= 500, timeout <= 3600) and validate scene names against the roster.
//   3. Restore terminal state and return the command exit code.

import "ascii/effects.oo";
import "ascii/engine.oo";
import "ascii/port_session.oo";
import "ascii/layout/wordmark.oo";
import "ascii/draw/ansi.oo";
import "daemon/config_file.oo";
import "daemon/config.oo";
import "oostd/core/primitives/str_extra.oo";
import "cli/preview/flags.oo";

fn preview_batch(ffi: &FfiCap, ar: &ArenaCap, time: &TimeCap, name: String,
    wm: String, frames: Int, dims: PvDims, tour: Bool) -> Int {
    let cols: Int = dims.cols;
    let rows: Int = dims.rows;
    let is_wm: Bool = wm_known(name) && name != "superfedora";
    if is_wm {
        let wmt: String = wm_text(name);
        println("preset " + name + " " + wmt);
    }
    let fs_str: String = frames.to_string();
    let aid: Int = frame_arena_open(ar);
    // Canonicalise the scene name. An alias (shower, scramble, led, wave)
    // must resolve to the same roster entry as its canonical name, or the
    // same scene renders through two different pipelines.
    let cidx: Int = effects_index(name);
    let mut sc: Int = if cidx >= 0 { cidx } else { 0 };
    let use_port: Bool = !is_wm;
    let sc0: String = if is_wm { name } else { effects_name(sc) };
    let mut ps_key: String = sc0 + ":" + cols.to_string() + "x" + rows.to_string();
    let mut ps: PortSession = port_session_new(sc0, cols, rows, wm);
    let mut i: Int = 0;
    while i < frames {
        let ft0: Int = now_ms(time);
        let sc_name: String = if is_wm { name } else { effects_name(sc) };
        let mut port_frame_str: String = "";
        if use_port {
            let key: String = sc_name + ":" + cols.to_string() + "x" + rows.to_string();
            if key != ps_key {
                ps = port_session_new(sc_name, cols, rows, wm);
                ps_key = key;
            }
            ps = port_session_next(ps);
            port_frame_str = port_session_frame(ps);
        }
        let _e: Int = frame_arena_enter(ar, aid);
        let frame: String = if is_wm {
            engine_wordmark_frame(cols, rows, name, i)
        } else {
            port_frame_str
        };
        let w: Result[String, String] = oo_tui_write(ffi, frame);
        if w.is_err() { print(frame); }
        println("frame " + i.to_string() + "/" + fs_str);
        let _l: Int = frame_arena_leave(ar, aid);
        let el: Int = now_ms(time) - ft0;
        if el < 33 && el >= 0 { sleep_ms(time, 33 - el); }
        // Rotate the tour when the scene finishes, the way the Rust
        // reference ends a scene's slot: the slot closes when the scene
        // itself has played out. A fixed frame timer cut long scenes short
        // and left short ones resting on a static banner. The tick bound is
        // a backstop, so a scene that never settles cannot stall the tour.
        if tour && use_port && (ps.settled || ps.tick > 1800) { sc = (sc + 1) % 51; }
        i = i + 1;
    }
    let _c: Int = frame_arena_close(ar, aid);
    return 0;
}

// Poll one key: step keys return an index, -1 exits (q/Esc/Space), -2 ignores the byte.
fn preview_poll_key(ffi: &FfiCap, sc: Int) -> Int {
    let s: String = match oo_tui_read_byte_timeout(ffi, "", 16) { Ok(s) => s, Err(_) => "" };
    if s == "" { return sc; }
    let b: Int = byte_at(s, 0);
    if b == 27 {
        let s2: String = match oo_tui_read_byte_timeout(ffi, "", 10) { Ok(s) => s, Err(_) => "" };
        if s2 == "" { return -1; }
        if s2 == "[" {
            let s3: String = match oo_tui_read_byte_timeout(ffi, "", 10) { Ok(s) => s, Err(_) => "" };
            if s3 == "C" || s3 == "B" { return (sc + 1) % 51; }
            if s3 == "D" || s3 == "A" { return (sc + 50) % 51; }
        }
        return -2;
    }
    if b == 113 || b == 32 { return -1; }
    if b == 110 || b == 78 || b == 93 || b == 9 || b == 62 || b == 46 { return (sc + 1) % 51; }
    if b == 112 || b == 80 || b == 91 || b == 60 || b == 44 { return (sc + 50) % 51; }
    return -2;
}
type PvDims = struct {
    rows: Int,
    cols: Int
};

fn preview_term_dims(ffi: &FfiCap) -> PvDims {
    let dims: String = match oo_tui_get_size(ffi) { Ok(s) => s, Err(_) => "24:80" };
    let colon: Int = str_index_of(dims, ":");
    let mut rows: Int = if colon >= 0 { parse_int_digits(str_slice(dims, 0, colon)) } else { 24 };
    let mut cols: Int = if colon >= 0 { parse_int_digits(str_slice(dims, colon + 1, chars_len(dims))) } else { 80 };
    if rows < 4 { rows = 24; }
    if cols < 16 { cols = 80; }
    return PvDims { rows: rows, cols: cols };
}

fn preview_interactive(ffi:&FfiCap, time:&TimeCap, ar:&ArenaCap, name: String, wm: String, timeout_s: Int, tour: Bool)-> Int {
    if oo_tui_enable_raw(ffi, "").is_err() { return 1; }
    let _ = oo_tui_alt_screen_enter(ffi);
    let _ = oo_tui_show_cursor(ffi, 0);
    let mut sc: Int = if effects_index(name) >= 0 { effects_index(name) } else { 0 };
    let is_wm: Bool = wm_known(name) && name != "superfedora";
    let end_ms: Int = if timeout_s > 0 { now_ms(time) + timeout_s * 1000 } else { 0 };
    let mut last_pack: Int = 0;
    let e0: String = bytes_to_str(bytes_push(bytes_new(), 27));
    let aid: Int = frame_arena_open(ar);
    let mut ps: PortSession = port_session_new("plasma", 80, 24, wm);
    let mut ps_key: String = "";
    let mut tick: Int = 0;
    let mut running: Bool = true;
    while running && (end_ms == 0 || now_ms(time) < end_ms) {
        let ft0: Int = now_ms(time);
        let d: PvDims = preview_term_dims(ffi);
        let rows: Int = d.rows;
        let cols: Int = d.cols;
        let pack: Int = rows * 10000 + cols;
        if pack != last_pack {
            let _ = oo_tui_write(ffi, e0 + "[2J");
            last_pack = pack;
        }
        let sc_name: String = if is_wm { name } else { effects_name(sc) };
        let use_port: Bool = !is_wm;
        if use_port {
            let key: String = sc_name + ":" + cols.to_string() + "x" + (rows - 1).to_string();
            if key != ps_key {
                ps = port_session_new(sc_name, cols, rows - 1, wm);
                ps_key = key;
            }
            ps = port_session_next(ps);
        }
        let _e: Int = frame_arena_enter(ar, aid);
        let frame: String = if is_wm {
            engine_wordmark_frame(cols, rows - 1, name, tick)
        } else {
            port_session_frame(ps)
        };
        let sfx: String = " (" + (sc + 1).to_string() + "/51) │ Banner: " + wm;
        let tit: String = if is_wm { "Preset: " + sc_name } else { "Scene: " + sc_name + sfx };
        let keys: String = "] [←/→/n/p: Step  q/Esc/Space: Exit]";
        let out_line: String = ansi_home() + frame + "\r\n" + e0 + "[1;36m[" + tit + keys + e0 + "[0m" + e0 + "[K";
        let _ = oo_tui_write(ffi, out_line);
        let _l: Int = frame_arena_leave(ar, aid);
        let nsc: Int = preview_poll_key(ffi, sc);
        if nsc == -1 { running = false; }
        else if nsc >= 0 { sc = nsc; }
        // The tour advances when the scene settles, not on a frame count:
        // the Rust reference closes a scene's slot when the scene finishes.
        if tour && use_port && (ps.settled || ps.tick > 1800) { sc = (sc + 1) % 51; }
        let el: Int = now_ms(time) - ft0;
        if el < 33 && el >= 0 { sleep_ms(time, 33 - el); }
        tick = tick + 1;
    }
    let _c: Int = frame_arena_close(ar, aid);
    let _ = oo_tui_show_cursor(ffi, 1);
    let _ = oo_tui_alt_screen_leave(ffi);
    let _ = oo_tui_disable_raw(ffi, "");
    return 0;
}

pub fn cmd_preview(fs_r:&FsReadCap, proc:&ProcessCap, ffi:&FfiCap, time:&TimeCap, ar:&ArenaCap,
    args: List[String])-> Int {
    let cfg: ConfigData = config_read_file(fs_r, proc);
    let mut name: String = if cfg.active != "" { cfg.active } else { "ascii" };
    let mut tour: Bool = false;
    let mut has_frames: Bool = false;
    let mut name_set: Bool = false;
    let mut frames: Int = 2;
    let mut cols: Int = 72;
    let mut rows: Int = 12;
    let mut timeout_n: Int = 0;
    let mut text_s: String = "";
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "--tour" || a == "--new" { tour = true; }
        else if a == "--frames" || a == "--cols" || a == "--rows" || a == "--timeout" || a == "-t" || a == "--text" {
            if i + 1 >= list_len(args) {
                println("ERR preview: " + a + " requires a value");
                return 2;
            }
            let v: String = list_get(args, i + 1);
            if a == "--frames" { frames = preview_need_num(v, "--frames", 10000, 2); }
            else if a == "--cols" { cols = preview_need_num(v, "--cols", 500, 72); }
            else if a == "--rows" { rows = preview_need_num(v, "--rows", 500, 12); }
            else if a == "--text" { text_s = v; }
            else { timeout_n = preview_need_num(v, a, 3600, 0); }
            if frames < 0 || cols < 0 || rows < 0 || timeout_n < 0 { return 2; }
            if a == "--frames" { has_frames = true; }
            i = i + 1;
        }
        else if str_starts_with(a, "-") {
            println("ERR preview: unknown flag: " + a);
            return 2;
        }
        else if !name_set {
            name = to_lowercase(a);
            name_set = true;
        }
        else {
            println("ERR preview: unexpected argument: " + a);
            return 2;
        }
        i = i + 1;
    }
    let low: String = to_lowercase(name);
    if low != "tour" && low != "ascii" && low != "superfedora" && low != "new" && !wm_known(low) && effects_index(low) < 0 {
        println("ERR preview: unknown scene: " + name);
        return 2;
    }
    if name == "tour" || name == "ascii" || name == "superfedora" || name == "new" { tour = true; }
    let wm: String = if text_s != "" {
        to_uppercase(text_s)
    } else if name == "superfedora" {
        "SUPERFEDORA"
    } else {
        daemon_banner_text(fs_r, proc)
    };
    if has_frames {
        return preview_batch(ffi, ar, time, name, wm, frames, PvDims { rows: rows, cols: cols }, tour);
    }
    return preview_interactive(ffi, time, ar, name, wm, timeout_n, tour);
}
