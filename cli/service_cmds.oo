// # Service Commands - Service Management and Daemon Control
//
// Logline: Real service management verbs and daemon socket control commands across the supported init systems.
// Setup: Requires ProcessCap for systemctl and unit installation, FsCap/FsWriteCap and EnvCap for daemon socket control.
// Beats:
//   1. Forward interactive control frames to the daemon socket.
//   2. Install, enable, disable, restart, and toggle the service on systemd, dinit, or XDG autostart.
//   3. Cleanly remove unit configuration on uninstall with zero residual symlinks.

import "oostd/core/primitives/str.oo";
import "core/shell.oo";
import "daemon/run.oo";
import "daemon/config.oo";
import "daemon_cmds.oo";
import "service_unit.oo";

pub fn cmd_saver_ctl(fs_r: &FsReadCap, fs: &FsCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, verb: String) -> Int {
    return ooidle_query(fs_r, fs, fw, proc, env, "idlescreen", verb);
}

// The service counts as active when systemd reports it or the daemon answers.
pub fn service_is_active(fs_r: &FsReadCap, fs: &FsCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap) -> Bool {
    if shell_out(proc, "systemctl --user is-active --quiet idlescreen.service 2>/dev/null && echo yes") != "" { return true; }
    if service_has_systemd(proc) { return false; }
    return ooidle_notify(fs_r, fs, fw, proc, env, "idlescreen", "ping");
}

pub fn service_enable(fs_r: &FsReadCap, proc: &ProcessCap, env: &EnvCap) -> Int {
    let unit: String = service_unit_dir(fs_r, proc, env) + "/idlescreen.service";
    if shell_out(proc, "test -f " + shell_quote(unit) + " 2>/dev/null && echo yes") == "" {
        let inst: Int = service_install(fs_r, proc, env);
        if inst != 0 { return inst; }
    }
    if service_has_systemd(proc) {
        let _r: String = shell_out(proc, "systemctl --user daemon-reload 2>/dev/null || true");
        if shell_out(proc, "systemctl --user enable --now idlescreen.service 2>/dev/null && echo ok") == "" {
            println("Error: systemctl failed to enable idlescreen.service.");
            return 1;
        }
        println("IdleScreen service enabled and started.");
        return 0;
    }
    if shell_out(proc, "dinitctl enable idlescreen 2>/dev/null && echo ok") != "" {
        println("IdleScreen service enabled via dinit.");
        return 0;
    }
    println("IdleScreen autostart entry installed; starts at next login.");
    return 0;
}

pub fn service_disable(fs_r: &FsReadCap, proc: &ProcessCap, env: &EnvCap) -> Int {
    if service_has_systemd(proc) {
        if shell_out(proc, "systemctl --user disable --now idlescreen.service 2>/dev/null && echo ok") == "" {
            println("Error: systemctl failed to disable idlescreen.service.");
            return 1;
        }
        println("IdleScreen service disabled and stopped.");
        return 0;
    }
    let _i: String = shell_out(proc, "dinitctl disable idlescreen 2>/dev/null || true");
    let desk: String = service_autostart_dir(fs_r, proc, env) + "/idlescreen.desktop";
    if shell_out(proc, "rm -f " + shell_quote(desk) + " 2>/dev/null && echo ok") == "" {
        println("Error: failed to remove the autostart entry.");
        return 1;
    }
    println("IdleScreen service disabled and stopped.");
    return 0;
}

pub fn service_restart(fs_r: &FsReadCap, proc: &ProcessCap, env: &EnvCap) -> Int {
    if service_has_systemd(proc) {
        let _r: String = shell_out(proc, "systemctl --user daemon-reload 2>/dev/null || true");
        if shell_out(proc, "systemctl --user restart idlescreen.service 2>/dev/null && echo ok") == "" {
            println("Error: systemctl failed to restart idlescreen.service.");
            return 1;
        }
        println("IdleScreen service restarted.");
        return 0;
    }
    if shell_out(proc, "dinitctl restart idlescreen 2>/dev/null && echo ok") != "" {
        println("IdleScreen service restarted via dinit.");
        return 0;
    }
    println("Error: no systemd user manager or dinit to restart.");
    return 1;
}

pub fn service_uninstall(fs_r: &FsReadCap, proc: &ProcessCap, env: &EnvCap) -> Int {
    let dd: Int = service_disable(fs_r, proc, env);
    if dd != 0 { return dd; }
    let unit: String = service_unit_dir(fs_r, proc, env) + "/idlescreen.service";
    if shell_out(proc, "rm -f " + shell_quote(unit) + " 2>/dev/null && echo ok") == "" {
        println("Error: failed to remove the systemd user unit.");
        return 1;
    }
    let _rl: String = shell_out(proc, "systemctl --user daemon-reload 2>/dev/null || true");
    println("IdleScreen service uninstalled.");
    return 0;
}

pub fn cmd_service(fs_r: &FsReadCap, fs: &FsCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, verb: String) -> Int {
    if verb == "install" { return service_install(fs_r, proc, env); }
    if verb == "enable" || verb == "start" { return service_enable(fs_r, proc, env); }
    if verb == "disable" || verb == "stop" { return service_disable(fs_r, proc, env); }
    if verb == "restart" || verb == "reload" { return service_restart(fs_r, proc, env); }
    if verb == "status" { return cmd_status(fs_r, fs, fw, proc, env); }
    if verb == "toggle" {
        if service_is_active(fs_r, fs, fw, proc, env) {
            if service_disable(fs_r, proc, env) != 0 { return 1; }
            println("IdleScreen standby: Service disabled (stay-awake ON)");
        } else {
            if service_enable(fs_r, proc, env) != 0 { return 1; }
            println("IdleScreen standby: Service enabled (idle monitoring ACTIVE)");
        }
        return 0;
    }
    if verb == "uninstall" { return service_uninstall(fs_r, proc, env); }
    if verb == "service" {
        println("usage: idlescreen service <install|enable|disable|restart|reload|toggle|status|uninstall>");
        return 0;
    }
    println("unknown service verb " + verb);
    return 1;
}
