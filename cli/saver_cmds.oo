// # Saver Commands - list, text, preview, set
//
// Logline: The scene-facing command verbs: roster listing, wordmark text configuration, interactive preview, and scene selection.
// Setup: Requires ProcessCap and EnvCap for OS/config resolution, FfiCap for terminal emission, and TimeCap for interactive frame pacing.
// Beats:
//   1. List the 53-scene roster in text or JSON format.
//   2. Render wordmark presets or configure/report ASCII banner text targets.
//   3. Run full-screen interactive preview with live scene switching, OS/custom wordmark overlay, and timeout.

import "ascii/effects.oo";
import "ascii/engine.oo";
import "ascii/layout/wordmark.oo";
import "ascii/scenes/anchor.oo";
import "ascii/draw/ansi.oo";
import "core/cell.oo";
import "core/grid.oo";
import "daemon/config_file.oo";
import "daemon/config.oo";

fn arg_num(args: List[String], flag: String, dflt: Int) -> Int {
    let mut i: Int = 0;
    while i < list_len(args) - 1 {
        if list_get(args, i) == flag {
            let v: String = list_get(args, i + 1);
            let mut acc: Int = 0;
            let mut j: Int = 0;
            while j < chars_len(v) { let b: Int = byte_at(v, j); if b >= 48 && b <= 57 { acc = acc * 10 + b - 48; } j = j + 1; }
            if acc > 0 { return acc; }
        }
        i = i + 1;
    }
    return dflt;
}

fn arg_str(args: List[String], flag: String, dflt: String) -> String {
    let mut i: Int = 0;
    while i < list_len(args) - 1 {
        if list_get(args, i) == flag { return list_get(args, i + 1); }
        i = i + 1;
    }
    return dflt;
}

pub fn cmd_list(args: List[String]) -> Int {
    let mut json: Bool = false;
    let mut i: Int = 0;
    while i < list_len(args) { if list_get(args, i) == "--json" { json = true; } i = i + 1; }
    if json {
        let mut out: String = "{\"count\":53,\"scenes\":[";
        let mut j: Int = 0;
        while j < 53 {
            if j > 0 { out = out + ","; }
            out = out + "\"" + effects_name(j) + "\"";
            j = j + 1;
        }
        out = out + "]}";
        println(out);
        return 0;
    }
    let mut k: Int = 0;
    while k < 53 {
        println((k + 1).to_string() + " " + effects_name(k));
        k = k + 1;
    }
    return 0;
}

pub fn cmd_text(proc: &ProcessCap, env: &EnvCap, ffi: &FfiCap, args: List[String]) -> Int {
    let cur_wm: String = daemon_banner_text(proc, env);
    let a0: String = if list_len(args) > 0 { str_trim(list_get(args, 0)) } else { "" };
    if a0 == "" || to_lowercase(a0) == "status" {
        let frame: String = engine_wordmark_frame(72, 12, cur_wm, 4);
        let w: Result[String, String] = oo_tui_write(ffi, frame);
        if w.is_err() { print(frame); }
        println("\nIdleScreen ASCII Text Configuration:");
        println("  Resolved brand word: [" + cur_wm + "]");
        println("  preset: " + to_lowercase(cur_wm) + " " + cur_wm);
        return 0;
    }
    let low: String = to_lowercase(a0);
    let mut cfg: ConfigData = config_read_file(proc, env);
    if low == "os" || low == "host" {
        cfg.use_os_brand = true;
    } else if !wm_known(low) {
        cfg.use_os_brand = false;
        cfg.custom_text = a0;
    }
    let _ = config_write_file(proc, env, cfg);
    let disp_name: String = if low == "os" || low == "host" { daemon_banner_text(proc, env) } else { a0 };
    let frame: String = engine_wordmark_frame(72, 12, disp_name, 4);
    let wmt: String = wm_text(disp_name);
    let msg: String = frame + "\npreset: " + low + " " + wmt + "\n";
    let w: Result[String, String] = oo_tui_write(ffi, msg);
    if w.is_err() { print(msg); }
    return 0;
}

fn preview_batch(ffi: &FfiCap, name: String, wm: String, frames: Int, cols: Int, rows: Int, tour: Bool) -> Int {
    let is_wm: Bool = wm_known(name) && name != "superfedora";
    if is_wm {
        let wmt: String = wm_text(name);
        println("preset " + name + " " + wmt);
    }
    let fs_str: String = frames.to_string();
    let mut i: Int = 0;
    while i < frames {
        let frame: String = if is_wm { engine_wordmark_frame(cols, rows, name, i) } else { engine_preview_wordmark(cols, rows, name, i, tour, wm) };
        let w: Result[String, String] = oo_tui_write(ffi, frame);
        if w.is_err() { print(frame); }
        println("frame " + i.to_string() + "/" + fs_str);
        i = i + 1;
    }
    return 0;
}

fn preview_poll_key(ffi: &FfiCap, sc: Int) -> Int {
    let s: String = match oo_tui_read_byte_timeout(ffi, "", 16) { Ok(v) => v, Err(_) => "" };
    if s == "" { return sc; }
    let b: Int = byte_at(s, 0);
    if b == 27 {
        let s2: String = match oo_tui_read_byte_timeout(ffi, "", 10) { Ok(v) => v, Err(_) => "" };
        let s3: String = if s2 == "[" { match oo_tui_read_byte_timeout(ffi, "", 10) { Ok(v) => v, Err(_) => "" } } else { "" };
        if s3 == "C" || s3 == "B" { return (sc + 1) % 53; }
        if s3 == "D" || s3 == "A" { return (sc + 52) % 53; }
        return -1;
    }
    if b == 110 || b == 78 || b == 93 || b == 9 || b == 62 || b == 46 { return (sc + 1) % 53; }
    if b == 112 || b == 80 || b == 91 || b == 60 || b == 44 { return (sc + 52) % 53; }
    return -1;
}

fn preview_interactive(ffi: &FfiCap, time: &TimeCap, name: String, wm: String, timeout_s: Int, tour: Bool) -> Int {
    if oo_tui_enable_raw(ffi, "").is_err() { return 1; }
    let _ = oo_tui_alt_screen_enter(ffi);
    let _ = oo_tui_show_cursor(ffi, 0);
    let mut sc: Int = if effects_index(name) >= 0 { effects_index(name) } else { 0 };
    let is_wm: Bool = wm_known(name) && name != "superfedora";
    let end_ms: Int = if timeout_s > 0 { now_ms(time) + timeout_s * 1000 } else { 0 };
    let mut last_pack: Int = 0;
    let mut eb: List[Int] = bytes_new(); eb = bytes_push(eb, 27);
    let e0: String = bytes_to_str(eb);
    let mut tick: Int = 0;
    let mut running: Bool = true;
    while running && (end_ms == 0 || now_ms(time) < end_ms) {
        let dims: String = match oo_tui_get_size(ffi) { Ok(s) => s, Err(_) => "24:80" };
        let colon: Int = str_index_of(dims, ":");
        let mut rows: Int = if colon >= 0 { parse_int_digits(str_slice(dims, 0, colon)) } else { 24 };
        let mut cols: Int = if colon >= 0 { parse_int_digits(str_slice(dims, colon + 1, chars_len(dims))) } else { 80 };
        if rows < 4 { rows = 24; }
        if cols < 16 { cols = 80; }
        let pack: Int = rows * 10000 + cols;
        if pack != last_pack { let _ = oo_tui_write(ffi, e0 + "[2J"); last_pack = pack; }
        let sc_name: String = if is_wm { name } else { effects_name(sc) };
        let frame: String = if is_wm { engine_wordmark_frame(cols, rows - 1, name, tick) } else { engine_preview_wordmark(cols, rows - 1, sc_name, tick, tour, wm) };
        let tit: String = if is_wm { "Preset: " + sc_name } else { "Scene: " + sc_name + " (" + (sc + 1).to_string() + "/53) │ Banner: " + wm };
        let out_line: String = ansi_home() + frame + "\r\n" + e0 + "[1;36m[" + tit + "] [←/→/n/p: Step  q/Esc/Space: Exit]" + e0 + "[0m" + e0 + "[K";
        let _ = oo_tui_write(ffi, out_line);
        let nsc: Int = preview_poll_key(ffi, sc);
        if nsc < 0 { running = false; } else { sc = nsc; }
        if tour && (tick % 180 == 179) { sc = (sc + 1) % 53; }
        tick = tick + 1;
    }
    let _ = oo_tui_show_cursor(ffi, 1);
    let _ = oo_tui_alt_screen_leave(ffi);
    let _ = oo_tui_disable_raw(ffi, "");
    return 0;
}

pub fn cmd_preview(proc: &ProcessCap, env: &EnvCap, ffi: &FfiCap, time: &TimeCap, args: List[String]) -> Int {
    let cfg: ConfigData = config_read_file(proc, env);
    let mut name: String = if cfg.active != "" { cfg.active } else { "ascii" };
    let mut tour: Bool = false;
    let mut has_frames: Bool = false;
    let mut name_set: Bool = false;
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "--tour" || a == "--new" { tour = true; }
        else if a == "--frames" { has_frames = true; i = i + 1; }
        else if a == "--cols" || a == "--rows" || a == "--timeout" || a == "-t" || a == "--text" || a == "--mode" || a == "-m" || a == "--dwell" || a == "-d" { i = i + 1; }
        else if !str_starts_with(a, "-") && !name_set { name = to_lowercase(a); name_set = true; }
        i = i + 1;
    }
    if name == "tour" || name == "ascii" || name == "superfedora" || name == "new" { tour = true; }
    let txt_flag: String = arg_str(args, "--text", "");
    let wm: String = if txt_flag != "" { to_uppercase(txt_flag) } else if name == "superfedora" { "SUPERFEDORA" } else { daemon_banner_text(proc, env) };
    if has_frames {
        let frames: Int = arg_num(args, "--frames", 2);
        let cols: Int = arg_num(args, "--cols", 72);
        let rows: Int = arg_num(args, "--rows", 12);
        return preview_batch(ffi, name, wm, frames, cols, rows, tour);
    }
    let timeout_s: Int = arg_num(args, "--timeout", arg_num(args, "-t", 0));
    return preview_interactive(ffi, time, name, wm, timeout_s, tour);
}
