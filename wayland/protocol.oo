// # Wayland Protocol - Display Socket and Wire Encoding
//
// Logline: Resolves the Wayland display socket and encodes/decodes the little-endian wire format.
// Setup: Requires FsReadCap, ProcessCap, and EnvCap to resolve XDG_RUNTIME_DIR and WAYLAND_DISPLAY under the FS jail.
// Beats:
//   1. Resolve the display socket path from the launch environment.
//   2. Encode u32 and string arguments into message byte lists.
//   3. Decode message headers and string arguments from received buffers.

import "core/environ.oo";

pub type WlSession = struct {
    runtime_dir: String,
    display: String,
    socket_path: String,
    connected: Bool,
    slot: Int
};

pub type WlMsg = struct {
    object_id: Int,
    opcode: Int,
    size: Int,
    ok: Bool
};

pub fn wl_socket_path(fs_r: &FsReadCap, proc: &ProcessCap) -> String {
    let rd: String = runtime_dir(fs_r, proc);
    let mut dp: String = host_env_fs(fs_r, proc, "WAYLAND_DISPLAY");
    if dp == "" {
        dp = shell_out(proc, "for s in " + shell_quote(rd) + "/wayland-*; do [ -S \"$s\" ] && basename \"$s\" && break; done");
    }
    if dp == "" { return ""; }
    if str_starts_with(dp, "/") { return dp; }
    return rd + "/" + dp;
}

pub fn wl_session_open(fs: &FsReadCap) -> WlSession {
    let dp: String = self_env(fs, "OO_WAYLAND_DISPLAY");
    return WlSession { runtime_dir: "", display: dp, socket_path: "", connected: false, slot: -1 };
}

pub fn wl_put_u32(b: List[Int], v: Int) -> List[Int] {
    let mut out: List[Int] = b;
    out = bytes_push(out, v % 256);
    out = bytes_push(out, (v / 256) % 256);
    out = bytes_push(out, (v / 65536) % 256);
    out = bytes_push(out, (v / 16777216) % 256);
    return out;
}

pub fn wl_put_header(b: List[Int], object_id: Int, opcode: Int, size: Int) -> List[Int] {
    let mut out: List[Int] = wl_put_u32(b, object_id);
    out = bytes_push(out, opcode % 256);
    out = bytes_push(out, (opcode / 256) % 256);
    out = bytes_push(out, size % 256);
    out = bytes_push(out, (size / 256) % 256);
    return out;
}

pub fn wl_put_string(b: List[Int], s: String) -> List[Int] {
    let n: Int = bytes_len(s);
    let total: Int = n + 1;
    let padded: Int = (total + 3) / 4 * 4;
    let mut out: List[Int] = wl_put_u32(b, total);
    let mut i: Int = 0;
    while i < n {
        out = bytes_push(out, byte_at(s, i));
        i = i + 1;
    }
    let mut p: Int = n;
    while p < padded {
        out = bytes_push(out, 0);
        p = p + 1;
    }
    return out;
}

pub fn wl_get_u32(s: String, off: Int) -> Int {
    if off < 0 || off + 4 > bytes_len(s) { return -1; }
    return byte_at(s, off) + byte_at(s, off + 1) * 256 + byte_at(s, off + 2) * 65536 + byte_at(s, off + 3) * 16777216;
}

pub fn wl_get_string(s: String, off: Int) -> String {
    let n: Int = wl_get_u32(s, off);
    if n <= 0 || off + 4 + n > bytes_len(s) { return ""; }
    return byte_slice(s, off + 4, off + 4 + n - 1);
}

pub fn wl_next_msg(s: String, off: Int) -> WlMsg {
    if off < 0 || off + 8 > bytes_len(s) { return WlMsg { object_id: 0, opcode: 0, size: 0, ok: false }; }
    let oid: Int = wl_get_u32(s, off);
    let op: Int = byte_at(s, off + 4) + byte_at(s, off + 5) * 256;
    let sz: Int = byte_at(s, off + 6) + byte_at(s, off + 7) * 256;
    if sz < 8 || off + sz > bytes_len(s) { return WlMsg { object_id: oid, opcode: op, size: sz, ok: false }; }
    return WlMsg { object_id: oid, opcode: op, size: sz, ok: true };
}
