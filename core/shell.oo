// # Shell Argument Quoting - POSIX-safe Command Building
//
// Logline: Escapes strings so they survive a POSIX shell as exactly one literal argument each.
// Setup: Pure string transformation plus a thin ProcessCap exec wrapper. Zero ambient authority.
// Beats:
//   1. Wrap the argument in single quotes so the shell performs no expansion on it.
//   2. Close and reopen the quote around each embedded single quote so it stays literal.
//   3. Keep hostile content inside one argument instead of letting it reach the command line.
//   4. Run a command and return its trimmed stdout, or an empty string when it fails.

import "std/core/primitives/str.oo";
import "std/fs/process/process.oo";

// Quote one argument so the shell treats it as a single literal word.
pub fn shell_quote(s: String) -> String {
    return "'" + str_replace(s, "'", "'\\''") + "'";
}

// Run a command and return its trimmed stdout, or an empty string on failure.
pub fn shell_out(proc: &ProcessCap, cmd: String) -> String {
    let res: Result[String, String] = process_exec(proc, cmd);
    if res.is_err() { return ""; }
    return str_trim(match res { Ok(v) => v, Err(_) => "" });
}

pub fn frame_arena_open(ar: &ArenaCap) -> Int {
    let res: Result[String, String] = arena_create(ar, 67108864);
    if res.is_err() { return -1; }
    let s: String = match res { Ok(v) => v, Err(_) => "" };
    if str_starts_with(s, "arena:") {
        return parse_int_digits(str_slice(s, 6, chars_len(s)));
    }
    return parse_int_digits(s);
}

pub fn frame_arena_enter(ar: &ArenaCap, id: Int) -> Int {
    if id < 0 { return 0; }
    let _: Result[String, String] = arena_alloc(ar, id, 0);
    return 0;
}

pub fn frame_arena_leave(ar: &ArenaCap, id: Int) -> Int {
    if id < 0 { return 0; }
    let _: Result[String, String] = arena_alloc(ar, 0, -1);
    let _: Result[String, String] = arena_reset(ar, id);
    return 0;
}

pub fn frame_arena_close(ar: &ArenaCap, id: Int) -> Int {
    if id < 0 { return 0; }
    let _: Result[String, String] = arena_destroy(ar, id);
    return 0;
}
