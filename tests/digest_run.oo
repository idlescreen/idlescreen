// # digest_run — parity run contract for .oo scene ports
//
// Logline: Shared digest types and the per-frame hash step every scene
// port uses to reproduce the Rust scene_digest stream bit-for-bit.
// Setup: Pure. Imports the paint-cell serializer and FNV-1a-64 module.
// Beats:
//   1. DigestRun carries per-frame digests, composite, last frame cells.
//   2. digest_paint_cells hashes one frame's cell list.
//   3. run_push folds a frame digest into the run accumulators.

import "tests/oo/grid_cells.oo";
import "tests/fnv1a64.oo";

pub type DigestRun = struct {
    frames: List[Int],
    composite: Int,
    last: List[PaintCell]
};

pub fn digest_run_new() -> DigestRun {
    let _r1 = DigestRun { frames: list_new(), composite: fnv1a64_new(), last: list_new() };
    return _r1;
}

fn hash_cell(h: Int, c: PaintCell) -> Int {
    let mut cur: Int = fnv1a64_int(h, c.ord);
    cur = fnv1a64_update(cur, 44);
    cur = fnv1a64_int(cur, c.fr);
    cur = fnv1a64_update(cur, 44);
    cur = fnv1a64_int(cur, c.fg);
    cur = fnv1a64_update(cur, 44);
    cur = fnv1a64_int(cur, c.fb);
    cur = fnv1a64_update(cur, 44);
    cur = fnv1a64_int(cur, c.br);
    cur = fnv1a64_update(cur, 44);
    cur = fnv1a64_int(cur, c.bg);
    cur = fnv1a64_update(cur, 44);
    cur = fnv1a64_int(cur, c.bb);
    cur = fnv1a64_update(cur, 44);
    cur = fnv1a64_int(cur, c.bold);
    return fnv1a64_update(cur, 59);
}

pub fn digest_paint_cells(pcs: List[PaintCell]) -> Int {
    let mut h: Int = fnv1a64_new();
    let n: Int = list_len(pcs);
    let mut i: Int = 0;
    while i < n {
        h = hash_cell(h, list_get(pcs, i));
        i = i + 1;
    }
    return h;
}

pub fn run_push(run: DigestRun, d: Int, pcs: List[PaintCell]) -> DigestRun {
    let _r3 = DigestRun {
        frames: list_push(run.frames, d),
        composite: fnv1a64_combine(run.composite, d),
        last: pcs
    };
    return _r3;
}
