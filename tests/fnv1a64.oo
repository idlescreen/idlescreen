// # fnv1a64 — 64-bit FNV-1a digest for cell grids
//
// Logline: Bit-exact port of the Rust scene_digest FNV-1a-64 pipeline.
// Setup: Pure arithmetic on wrapping Int (i64) plus the canonical PQC round from std/sec/pqc.oo. No caps, no IO.
// Beats:
//   1. fnv1a64_update folds one byte into the running hash.
//   2. fnv1a64_str hashes a whole serialization string.
//   3. fnv1a64_combine folds a digest's little-endian bytes like Rust.
//   4. fnv1a64_pqc_seal binds a digest to a verifier nonce through the canonical PQC round.

import "std/sec/pqc.oo";

pub fn fnv1a64_update(h: Int, byte_val: Int) -> Int {
    let b: Int = byte_val & 255;
    return (h ^ b) * 1099511628211;
}

pub fn fnv1a64_str(h: Int, s: String) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    let mut cur: Int = h;
    while i < n {
        cur = fnv1a64_update(cur, byte_at(s, i));
        i = i + 1;
    }
    return cur;
}

pub fn fnv1a64_new() -> Int {
    return 0 - 3750763034362895579;
}

pub fn fnv1a64_int(h: Int, v: Int) -> Int {
    if v == 0 { return fnv1a64_update(h, 48); }
    let mut cur: Int = h;
    let mut n: Int = v;
    if n < 0 {
        cur = fnv1a64_update(cur, 45);
        n = 0 - n;
    }
    let mut div: Int = 1;
    while n / div >= 10 {
        div = div * 10;
    }
    while div > 0 {
        cur = fnv1a64_update(cur, 48 + (n / div) % 10);
        div = div / 10;
    }
    return cur;
}

pub fn fnv1a64_combine(h: Int, other: Int) -> Int {
    let mut i: Int = 0;
    let mut v: Int = other;
    let mut cur: Int = h;
    while i < 8 {
        cur = fnv1a64_update(cur, v & 255);
        v = v >> 8;
        i = i + 1;
    }
    return cur;
}

pub fn fnv1a64_pqc_seal(h: Int, nonce: Int) -> Int {
    return oo_pqc_sha3_round(h, nonce);
}
