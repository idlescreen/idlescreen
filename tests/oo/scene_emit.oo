// # scene_emit — deterministic scene digest emitter
//
// Logline: Runs a ported scene over the fixed probe grid and prints the same `frame\t<idx>\t<hash>` / `done\t<n>\t<hash>` stream as the Rust scene_digest example, for golden parity comparison.
//
// Setup: Pure compute plus println. argv[1] selects the scene; all other probe parameters are pinned to the golden configuration (80x24, seed 42, 60fps, art "IDLESCREEN\nSCREENSAVER").
//
// Beats:
//   1. Split the pinned art into lines and build canvas cells.
//   2. Dispatch the scene port through scene_dispatch and collect digests.
//   3. Print per-frame digest lines, optional cell dump, and composite.

import "tests/oo/canvas_cells.oo";
import "tests/oo/grid_cells.oo";
import "tests/digest_run.oo";
import "tests/scene_dispatch.oo";

fn art_lines() -> List[String] {
    let mut lines: List[String] = list_new();
    let mut cur: String = "";
    let art: String = "IDLESCREEN\nSCREENSAVER";
    let n: Int = chars_len(art);
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(art, i);
        if ord(ch) == 10 {
            lines = list_push(lines, cur);
            cur = "";
        } else {
            cur = cur + ch;
        }
        i = i + 1;
    }
    lines = list_push(lines, cur);
    return lines;
}

fn scene_name(args: List[String]) -> String {
    if list_len(args) > 0 { let _r1 = list_get(args, 0);
    return _r1; }
    return "plasma";
}



fn dump_idx(s: String) -> Int {
    let mut v: Int = 0 - 1;
    let mut i: Int = 0;
    while i < chars_len(s) {
        let o: Int = ord(char_at(s, i));
        if o < 48 || o > 57 { return 0 - 1; }
        if v < 0 { v = 0; }
        v = v * 10 + o - 48;
        i = i + 1;
    }
    return v;
}

pub fn main(alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    let name: String = scene_name(args);
    let info0: CanvasInfo = canvas_info(80, 24);
    let lines: List[String] = art_lines();
    let info: CanvasInfo = art_block(lines, info0);
    let cells: List[CellGeom] = canvas_cells(info, lines);
    let dr: Result[DigestRun, String] = dispatch_scene(name, cells, info, lines);
    let run: DigestRun = match dr { Ok(r) => r, Err(e) => return Err(e) };
    let nf: Int = list_len(run.frames);
    let mut idx: Int = 0;
    while idx < nf {
        let d: Int = list_get(run.frames, idx);
        println("frame\t" + idx.to_string() + "\t" + d.to_string());
        idx = idx + 1;
    }
    if list_len(args) > 2 && list_get(args, 1) == "dump" {
        let mut src: List[PaintCell] = run.last;
        let fi: Int = dump_idx(list_get(args, 2));
        if fi >= 0 && fi < list_len(run.pc_frames) {
            let pf0: PcFrame = list_get(run.pc_frames, fi);
            src = pf0.cells;
        }
        let dn: Int = list_len(src);
        let mut di: Int = 0;
        while di < dn {
            println("cell\t" + di.to_string() + "\t" + paint_cell_record(list_get(src, di)));
            di = di + 1;
        }
    }
    println("done\t" + nf.to_string() + "\t" + run.composite.to_string());
    return Ok(0);
}
