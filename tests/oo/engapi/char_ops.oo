// # char_ops — per-char path/event/appearance API for scene drivers
//
// Logline: The remaining EffectCharacter surface: new_path/new_waypoint,
// register_event, set_appearance, activate_scene/path, deactivate, and
// coordinate/layer/visibility setters, all as pure World transitions.
// Setup: Same encodings as engine_core (action kinds 0-7, event kinds 0-2,
// caller kinds 0-1). w_appear resolves symbol -1 to the input glyph like
// set_appearance's Option unwrap.
// Beats:
//   1. w_path/w_wp provision Motion paths with the auto-id probe.
//   2. w_reg appends (event, caller) registrations in upstream order.
//   3. w_appear/w_aset/w_pset/w_deact/w_pos/w_lay mirror ctx setters.

import "tests/oo/kernel/engine_ops.oo";
import "tests/oo/kernel/path_ops.oo";
import "tests/oo/kernel/anim_ops.oo";
import "tests/oo/kernel/world_ops.oo";

fn ch_evs(ch: Char, evs: List[Ev]) -> Char {
    let _r1 = Char { sym: ch.sym, col0: ch.col0, row0: ch.row0, fill: ch.fill,
        uses_pre: ch.uses_pre, vis: ch.vis, layer: ch.layer, cc: ch.cc, cr: ch.cr,
        pc: ch.pc, pr: ch.pr, v_ord: ch.v_ord, v_fg: ch.v_fg, v_bg: ch.v_bg, v_bold: ch.v_bold,
        a_scene: ch.a_scene, sids: ch.sids, scenes: ch.scenes, a_path: ch.a_path,
        done_path: ch.done_path, pids: ch.pids, paths: ch.paths, evs: evs };
    return _r1;
}

pub fn w_path(w: World, i: Int, cfg: WpCfg, pid: String) -> World {
    let ch: Char = list_get(w.chars, i);
    let mut id: String = pid;
    if id == "" { id = w_auto_id(ch.pids); }
    let p: Path = path_new(cfg.speed, cfg.ease_on, cfg.e, cfg.layer, cfg.hold, cfg.loop_);
    let _r2 = w_put(
        w,
        i,
        ch_pa(ch, list_push(ch.pids, id), list_push(ch.paths, p))
    );
    return _r2;
}

pub fn w_wp(w: World, i: Int, pi: Int, col: Int, row: Int, bez: List[Int]) -> World {
    let ch: Char = list_get(w.chars, i);
    let p: Path = wp_add(list_get(ch.paths, pi), col, row, bez);
    let _r3 = w_put(w, i, ch_pa(ch, ch.pids, list_set(ch.paths, pi, p)));
    return _r3;
}

pub fn w_reg(w: World, i: Int, ev: Int, ck: Int, cid: String, act: EvAct) -> World {
    let ch: Char = list_get(w.chars, i);
    let mut evs: List[Ev] = ch.evs;
    let mut found: Int = 0;
    let mut k: Int = 0;
    while k < list_len(evs) {
        let e: Ev = list_get(evs, k);
        if e.ev == ev && e.ck == ck && e.cid == cid {
            evs = list_set(evs, k, Ev { ev: e.ev, ck: e.ck, cid: e.cid, acts: list_push(e.acts, act) });
            found = 1;
        }
        k = k + 1;
    }
    if found == 0 { evs = list_push(evs, Ev { ev: ev, ck: ck, cid: cid, acts: list_push(list_new(), act) }); }
    let _r4 = w_put(w, i, ch_evs(ch, evs));
    return _r4;
}

pub fn w_appear(w: World, i: Int, ord: Int, fg: Int, bg: Int, bold: Int) -> World {
    let ch: Char = list_get(w.chars, i);
    let mut o: Int = ord;
    if o < 0 { o = ch.sym; }
    let _r5 = w_put(w, i, Char { sym: ch.sym, col0: ch.col0, row0: ch.row0, fill: ch.fill,
        uses_pre: ch.uses_pre, vis: ch.vis, layer: ch.layer, cc: ch.cc, cr: ch.cr,
        pc: ch.pc, pr: ch.pr, v_ord: o, v_fg: fg, v_bg: bg, v_bold: bold,
        a_scene: ch.a_scene, sids: ch.sids, scenes: ch.scenes, a_path: ch.a_path,
        done_path: ch.done_path, pids: ch.pids, paths: ch.paths, evs: ch.evs });
    return _r5;
}

pub fn w_aset(w: World, i: Int, si: Int) -> World {
    let ch: Char = list_get(w.chars, i);
    let sc: Scene = list_get(ch.scenes, si);
    let f: SFrame = list_get(sc.af, list_get(sc.fr, 0));
    let _r6 = w_put(w, i, Char { sym: ch.sym, col0: ch.col0, row0: ch.row0, fill: ch.fill,
        uses_pre: ch.uses_pre, vis: ch.vis, layer: ch.layer, cc: ch.cc, cr: ch.cr,
        pc: ch.pc, pr: ch.pr, v_ord: f.ord, v_fg: f.fg, v_bg: f.bg, v_bold: f.bold,
        a_scene: si, sids: ch.sids, scenes: ch.scenes, a_path: ch.a_path,
        done_path: ch.done_path, pids: ch.pids, paths: ch.paths, evs: ch.evs });
    return _r6;
}

pub fn w_pos(w: World, i: Int, col: Int, row: Int) -> World {
    let ch: Char = list_get(w.chars, i);
    let _r7 = w_put(w, i, Char { sym: ch.sym, col0: ch.col0, row0: ch.row0, fill: ch.fill,
        uses_pre: ch.uses_pre, vis: ch.vis, layer: ch.layer, cc: col, cr: row,
        pc: ch.pc, pr: ch.pr, v_ord: ch.v_ord, v_fg: ch.v_fg, v_bg: ch.v_bg, v_bold: ch.v_bold,
        a_scene: ch.a_scene, sids: ch.sids, scenes: ch.scenes, a_path: ch.a_path,
        done_path: ch.done_path, pids: ch.pids, paths: ch.paths, evs: ch.evs });
    return _r7;
}

pub fn w_lay(w: World, i: Int, layer: Int) -> World {
    let ch: Char = list_get(w.chars, i);
    let _r8 = w_put(w, i, Char { sym: ch.sym, col0: ch.col0, row0: ch.row0, fill: ch.fill,
        uses_pre: ch.uses_pre, vis: ch.vis, layer: layer, cc: ch.cc, cr: ch.cr,
        pc: ch.pc, pr: ch.pr, v_ord: ch.v_ord, v_fg: ch.v_fg, v_bg: ch.v_bg, v_bold: ch.v_bold,
        a_scene: ch.a_scene, sids: ch.sids, scenes: ch.scenes, a_path: ch.a_path,
        done_path: ch.done_path, pids: ch.pids, paths: ch.paths, evs: ch.evs });
    return _r8;
}
