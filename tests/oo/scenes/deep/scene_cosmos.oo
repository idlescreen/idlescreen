// # scene_cosmos — spiral galaxy + starfield port
//
// Logline: Bit-exact port of Cosmos::next_frame for the parity harness.
//
// Setup: Built over canvas_cells geometry + math_paint shared helpers. frame counts 1..=64; frame 64 settles text cells to bevel colors.
//
// Beats:
//   1. cosmos_new builds the 60-step palette and 3-stop final spectrum.
//   2. cosmos_next computes spiral arm, core, and star intensity per cell.
//   3. cosmos_run drives the loop and returns the digest stream.

import "tests/oo/canvas_cells.oo";
import "tests/oo/grid_cells.oo";
import "tests/oo/gradient_spectrum.oo";
import "tests/oo/math_paint.oo";
import "tests/shade_float.oo";
import "tests/digest_run.oo";

pub type Cosmos = struct {
    cells: List[CellGeom],
    palette: List[Int],
    final_spec: List[Int],
    frame: Int,
    frame_f: Float,
    info: CanvasInfo
};

fn cosmos_stops5() -> List[Int] {
    let mut s: List[Int] = list_new();
    s = list_push(s, 20 * 65536 + 10 * 256 + 56);
    s = list_push(s, 60 * 65536 + 27 * 256 + 122);
    s = list_push(s, 142 * 65536 + 36 * 256 + 170);
    s = list_push(s, 0 * 65536 + 216 * 256 + 255);
    s = list_push(s, 255 * 65536 + 248 * 256 + 231);
    return s;
}

fn cosmos_stops3() -> List[Int] {
    let mut s: List[Int] = list_new();
    s = list_push(s, 142 * 65536 + 36 * 256 + 170);
    s = list_push(s, 0 * 65536 + 216 * 256 + 255);
    s = list_push(s, 255 * 65536 + 248 * 256 + 231);
    return s;
}

pub fn cosmos_new(cells: List[CellGeom], info: CanvasInfo) -> Cosmos {
    let _r1 = Cosmos {
        cells: cells,
        palette: spectrum_build(cosmos_stops5(), 12),
        final_spec: spectrum_build(cosmos_stops3(), 12),
        frame: 0,
        frame_f: 0.0,
        info: info
    };
    return _r1;
}

fn fmaxf(a: Float, b: Float) -> Float {
    if a > b { return a; }
    return b;
}

fn cosmos_cell(m: Cosmos, c: CellGeom, t: Float, fill_fade: Float, reveal_r: Float) -> PaintCell {
    let mut locked: Int = 0;
    if c.fill == 0 && c.dist <= reveal_r { locked = 1; }
    let r: Float = c.dist;
    let arm_angle: Float = 2.0 * (c.angle - t * 1.5) + 6.8 * r;
    let ca: Float = cos(arm_angle);
    let arm_base: Float = 0.5 + 0.5 * ca;
    let arm: Float = arm_base * arm_base * arm_base * exp(0.0 - r * 1.15);
    let core: Float = exp(0.0 - r * 3.8);
    let star_hash: Int = ((c.col * 73856093) ^ (c.row * 19349663)) % 97;
    let mut star: Float = 0.0;
    if star_hash == 0 { star = 0.55 + 0.45 * sin(t * 4.0 + int_to_f(c.col)); }
    let intensity: Float = clamp_f(fmaxf(arm * 0.85 + core * 0.95, star), 0.0, 1.0);
    let _r2 = math_paint_cell(c, m.info, m.palette, m.final_spec, intensity, locked, fill_fade);
    return _r2;
}

pub fn cosmos_next(m: Cosmos) -> List[PaintCell] {
    let mut out: List[PaintCell] = list_new();
    if m.frame >= 64 { return out; }
    let frame: Int = m.frame + 1;
    let n: Int = list_len(m.cells);
    if frame == 64 {
        let mut i: Int = 0;
        while i < n {
            out = list_push(out, settle_paint_cell(list_get(m.cells, i), m.info));
            i = i + 1;
        }
        return out;
    }
    let frame_f: Float = m.frame_f + 1.0;
    let progress: Float = frame_f / 64.0;
    let t: Float = frame_f * 0.08;
    let mut fill_fade: Float = 1.0;
    if progress > 0.72 { fill_fade = clamp_f((1.0 - progress) / 0.28, 0.0, 1.0); }
    let reveal_r: Float = progress * 1.85;
    let mut j: Int = 0;
    while j < n {
        out = list_push(out, cosmos_cell(m, list_get(m.cells, j), t, fill_fade, reveal_r));
        j = j + 1;
    }
    return out;
}

pub fn cosmos_advance(m: Cosmos) -> Cosmos {
    let _r3 = Cosmos {
        cells: m.cells,
        palette: m.palette,
        final_spec: m.final_spec,
        frame: m.frame + 1,
        frame_f: m.frame_f + 1.0,
        info: m.info
    };
    return _r3;
}

pub fn cosmos_run(cells: List[CellGeom], info: CanvasInfo) -> DigestRun {
    let mut m: Cosmos = cosmos_new(cells, info);
    let mut run: DigestRun = digest_run_new();
    while true {
        let pcs: List[PaintCell] = cosmos_next(m);
        if list_len(pcs) == 0 { break; }
        run = run_push(run, digest_paint_cells(pcs), pcs);
        m = cosmos_advance(m);
    }
    return run;
}
