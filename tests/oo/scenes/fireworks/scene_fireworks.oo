// # scene_fireworks — shell launch/bloom/fall port
//
// Logline: Bit-exact port of Fireworks::build/next_frame: shells of
// 2 chars launch on OutExpo apex paths, explode along OutCirc bezier
// blooms, then fall home InOutQuart, chaining paths and scenes via
// PathComplete/PathActivated events at layer 2 (0 on landing).
// Setup: One shell launches per launch_delay cycle from the END of
// the shells list; delay resets to int(15 * uniform(0.5,1.5)) and
// decrements every frame. Shell colors draw once per shell (the
// leading empty shell included) in prepare_scenes order.
// Beats:
//   1. fw_scenes seeds launch (looping), bloom (step-synced), fall.
//   2. fireworks_run pops shells on delay and ticks until drained.

import "tests/oo/canvas_cells.oo";
import "tests/oo/grid_cells.oo";
import "tests/oo/kernel/world_ops.oo";
import "tests/oo/kernel/engine_ops.oo";
import "tests/oo/kernel/engine_tick.oo";
import "tests/oo/kernel/engine_render.oo";
import "tests/oo/engapi/input_arena.oo";
import "tests/oo/engapi/char_ops.oo";
import "tests/oo/engine/easing_fns.oo";
import "tests/oo/engine/gradient_map.oo";
import "tests/oo/engine/float_conv.oo";
import "tests/oo/engine/rng_xoshiro.oo";
import "tests/oo/engine/rng_helpers.oo";
import "tests/oo/scenes/fireworks/fw_geom.oo";
import "tests/digest_run.oo";

fn fw_shell_color(r: Rng) -> DR {
    let d: DR = rng_pick(r, 5);
    let mut c: Int = 8976354;
    if d.v == 1 { c = 4510866; }
    if d.v == 2 { c = 16116583; }
    if d.v == 3 { c = 16752988; }
    if d.v == 4 { c = 16393022; }
    let _r1 = DR { v: c, r: d.r };
    return _r1;
}

fn fw_scenes(w: World, info: CanvasInfo, shells: List[FwSh]) -> World {
    let fstops: List[Int] = list_push(list_push(list_push(list_new(), 9044106), 53759), 16777215);
    let fspec: List[Int] = gradient_new(fstops, list_push(list_new(), 12), 0);
    let cmap: List[Int] = cmap_h(fspec, info.tl, info.tr);
    let mut w2: World = w;
    let mut si: Int = 0;
    while si < list_len(shells) {
        let shell: FwSh = list_get(shells, si);
        let dc: DR = fw_shell_color(w2.rng);
        w2 = w_rng(w2, dc.r);
        let sgrad: List[Int]= gradient_new(
            list_push(list_push(list_push(list_new(), dc.v), 16777215), dc.v),
            list_push(list_new(), 5),
            0
        );
        let mut m: Int = 0;
        while m < list_len(shell.chars) {
            let id: Int = list_get(shell.chars, m);
            let ch: Char = list_get(w2.chars, id);
            let ffg: Int = list_get(cmap, ch.col0 - info.tl);
            w2 = w_scene(w2, id, 1, 0, 0, ez(0), "");
            w2 = w_frame(w2, id, 0, 111, 2, dc.v, 0 - 1, 0 - 1);
            w2 = w_frame(w2, id, 0, 111, 1, 16777215, 0 - 1, 0 - 1);
            w2 = w_scene(w2, id, 0, 1, 0, ez(0), "");
            let mut c: Int = 0;
            while c < list_len(sgrad) {
                w2 = w_frame(w2, id, 1, ch.sym, 2, list_get(sgrad, c), 0 - 1, 0 - 1);
                c = c + 1;
            }
            w2 = w_scene(w2, id, 0, 0, 0, ez(0), "fall_scn");
            let fg2: List[Int] = gradient_new(list_push(list_push(list_new(), dc.v), ffg), list_push(list_new(), 15), 0);
            w2 = w_grad(w2, id, 2, list_push(list_new(), ch.sym), 10, fg2, list_new());
            w2 = w_aset(w2, id, 0);
            w2 = w_reg(w2, id, 1, 1, "apex_pth", EvAct { kind: 1, sid: "1", num: 0, carg: 0 });
            w2 = w_reg(w2, id, 0, 1, "input_pth", EvAct { kind: 1, sid: "fall_scn", num: 0, carg: 0 });
            m = m + 1;
        }
        si = si + 1;
    }
    return w2;
}

pub fn fireworks_run(cells: List[CellGeom], info: CanvasInfo, lines: List[String]) -> DigestRun {
    let b: FwB = fw_waypoints(w_input(info, lines, rng_seed(42)), info);
    let mut w: World = fw_scenes(b.w, info, b.shells);
    let mut shells: List[FwSh] = b.shells;
    let mut delay: Int = 0;
    let mut run: DigestRun = digest_run_new();
    let _ = cells;
    while list_len(shells) > 0 || list_len(w.active) > 0 {
        if list_len(shells) > 0 && delay <= 0 {
            let shell: FwSh = list_get(shells, list_len(shells) - 1);
            shells = list_slice(shells, 0, list_len(shells) - 1);
            let mut m: Int = 0;
            while m < list_len(shell.chars) {
                let id: Int = list_get(shell.chars, m);
                w = w_set_vis(w, id, 1);
                w = w_active_add(w, id);
                m = m + 1;
            }
            let du: DRF = rng_unif(w.rng, 0.5, 1.5);
            w = w_rng(w, du.r);
            delay = trunc_i(15.0 * du.v);
        }
        delay = delay - 1;
        w = eng_update(w);
        let pcs: List[PaintCell] = eng_render(w, info.cols, info.rows);
        run = run_push(run, digest_paint_cells(pcs), pcs);
    }
    return run;
}
