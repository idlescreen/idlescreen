// # fw_parts — fireworks geometry and shell provisioning
//
// Logline: Bit-exact helpers for the Fireworks port: ellipse-disc
// coords (find_coords_in_circle), ray extrapolation past the target,
// and prepare_waypoints (shells of 2, apex/explode/input path chains
// with bezier bloom and fall control points, PathComplete links).
// Setup: RNG mirrors Rust per char: at shell boundaries randrange
// origin_x then origin_y, then per char uniform explode speed and a
// choice over the disc coords. Shells list includes the initial
// empty shell exactly as upstream pushes it.
// Beats:
//   1. fw_disc enumerates disc coords in upstream x-major order.
//   2. fw_ray extrapolates origin->target by the given offset.
//   3. fw_waypoints builds shells, paths, and path-chain events.

import "tests/oo/canvas_cells.oo";
import "tests/oo/kernel/world_ops.oo";
import "tests/oo/kernel/engine_core.oo";
import "tests/oo/engapi/char_ops.oo";
import "tests/oo/engapi/char_groups.oo";
import "tests/oo/engine/easing_fns.oo";
import "tests/oo/engine/geometry_fns.oo";
import "tests/oo/engine/float_conv.oo";
import "tests/oo/engine/rng_xoshiro.oo";
import "tests/oo/engine/rng_helpers.oo";
import "tests/shade_float.oo";

pub type FwSh = struct { chars: List[Int] };
pub type FwB = struct { w: World, shells: List[FwSh] };

pub fn fw_disc(h: Int, k: Int, diam: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    if diam == 0 { return out; }
    let a2: Float = pow(int_to_f(diam), 2.0);
    let b2: Float = pow(int_to_f(diam) / 2.0, 2.0);
    let mut x: Int = h - diam;
    while x <= h + diam {
        let xc: Float = pow(int_to_f(x - h), 2.0) / a2;
        let myo: Int = trunc_i(pow(b2 * (1.0 - xc), 0.5));
        let mut y: Int = k - myo;
        while y <= k + myo {
            out = list_push(list_push(out, x), y);
            y = y + 1;
        }
        x = x + 1;
    }
    return out;
}

pub fn fw_ray(oc: Int, orow: Int, tc: Int, trow: Int, off: Float) -> List[Int] {
    let base: Float = len_line(oc, orow, tc, trow, 0);
    let total: Float = base + off;
    if total == 0.0 || (oc == tc && orow == trow) {
        let _r1 = list_push(list_push(list_new(), tc), trow);
        return _r1;
    }
    let _r2 = coord_on_line(oc, orow, tc, trow, total / base);
    return _r2;
}

fn fw_char_paths(w: World, id: Int, ox: Int, oy: Int, disc: List[Int], diam: Int, info: CanvasInfo) -> World {
    let ch: Char = list_get(w.chars, id);
    let mut w2: World = w_pos(w, id, ox, info.bottom);
    w2 = w_path(w2, id, 0.65, 1, ez(17), 2, 0, 0, "apex_pth");
    w2 = w_wp(w2, id, 0, ox, oy, list_new());
    let sp: DRF = rng_unif(w2.rng, 0.5, 0.9);
    w2 = w_rng(w2, sp.r);
    w2 = w_path(w2, id, sp.v, 1, ez(20), 2, 0, 0, "");
    let dp: DR = rng_pick(w2.rng, list_len(disc) / 2);
    w2 = w_rng(w2, dp.r);
    let ec: Int = list_get(disc, dp.v * 2);
    let er: Int = list_get(disc, dp.v * 2 + 1);
    w2 = w_wp(w2, id, 1, ec, er, list_new());
    let bcp: List[Int] = fw_ray(ox, oy, ec, er, int_to_f(diam / 2));
    let mut brow: Int = list_get(bcp, 1) - 7;
    if brow < 1 { brow = 1; }
    w2 = w_wp(w2, id, 1, list_get(bcp, 0), brow, bcp);
    w2 = w_path(w2, id, 0.9, 1, ez(12), 2, 0, 0, "input_pth");
    w2 = w_wp(w2, id, 2, ch.col0, ch.row0, list_push(list_push(list_new(), list_get(bcp, 0)), 1));
    w2 = w_reg(w2, id, 1, 1, "apex_pth", EvAct { kind: 0, sid: "1", num: 0, carg: 0 });
    w2 = w_reg(w2, id, 1, 1, "1", EvAct { kind: 0, sid: "input_pth", num: 0, carg: 0 });
    w2 = w_reg(w2, id, 1, 1, "input_pth", EvAct { kind: 5, sid: "", num: 0, carg: 0 });
    w2 = eng_act_path(w2, id, 0);
    return w2;
}

pub fn fw_waypoints(w: World, info: CanvasInfo) -> FwB {
    let ids: List[Int] = sort_ids(w, collect_ids(w, 1), info.cols, info.rows, 0);
    let mut vol: Int = round_he(0.08 * int_to_f(list_len(ids)));
    if vol < 1 { vol = 1; }
    let mut diam: Int = round_he(int_to_f(info.right) * 0.2);
    if diam < 1 { diam = 1; }
    if diam > 15 { diam = 15; }
    let mut w2: World = w;
    let mut shells: List[FwSh] = list_new();
    let mut shell: List[Int] = list_new();
    let mut ox: Int = 0;
    let mut oy: Int = 0;
    let mut disc: List[Int] = list_new();
    let mut k: Int = 0;
    while k < list_len(ids) {
        let id: Int = list_get(ids, k);
        if list_len(shell) == vol || list_len(shell) == 0 {
            let dx: DR = rng_range(w2.rng, 0, info.right);
            w2 = w_rng(w2, dx.r);
            ox = dx.v;
            shells = list_push(shells, FwSh { chars: shell });
            shell = list_new();
            let dy: DR = rng_range(w2.rng, list_get(w2.chars, id).row0, info.top + 1);
            w2 = w_rng(w2, dy.r);
            oy = dy.v;
            disc = fw_disc(ox, oy, diam);
        }
        w2 = fw_char_paths(w2, id, ox, oy, disc, diam, info);
        shell = list_push(shell, id);
        k = k + 1;
    }
    if list_len(shell) > 0 { shells = list_push(shells, FwSh { chars: shell }); }
    let _r3 = FwB { w: w2, shells: shells };
    return _r3;
}
