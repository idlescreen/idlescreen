// # bn_parts — PrimsSimple spanning-tree machinery for the burn port
//
// Logline: Bit-exact port of PrimsSimple (random start inside the text
// boundary, then random-edge Prim growth until every in-text char is
// linked) reduced to lists: edge_chars, a linked bitmap, and the FIFO
// char_link_order the burn driver consumes per frame.
// Setup: Pure over List[Int]. Char ids are grid positions:
// id = (rows - row) * cols + (col - 1). Neighbors scan N,E,S,W then
// apply the text-boundary and unlinked filters, matching upstream.
// Beats:
//   1. bn_at/bn_col/bn_row translate between grid coords and char ids.
//   2. bn_nbs gathers unlinked in-text neighbors in upstream order.
//   3. bn_step replays one PrimsSimple.step (up to two randrange draws).
//   4. bn_link seeds the start char; the driver runs steps to completion.

import "tests/oo/canvas_cells.oo";
import "tests/oo/engine/rng_xoshiro.oo";
import "tests/oo/engine/rng_helpers.oo";

pub type BnSt = struct {
    edges: List[Int],
    linked: List[Int],
    order: List[Int],
    rng: Rng
};

pub fn bn_at(info: CanvasInfo, c: Int, r: Int) -> Int {
    return (info.rows - r) * info.cols + c - 1;
}

fn bn_col(info: CanvasInfo, i: Int) -> Int {
    return i % info.cols + 1;
}

fn bn_row(info: CanvasInfo, i: Int) -> Int {
    return info.rows - i / info.cols;
}

fn bn_intext(info: CanvasInfo, c: Int, r: Int) -> Int {
    if c < info.tl || c > info.tr { return 0; }
    if r < info.tb || r > info.tt { return 0; }
    return 1;
}

fn bn_nbs(info: CanvasInfo, c: Int, r: Int, linked: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut d: Int = 0;
    while d < 4 {
        let mut nc: Int = c;
        let mut nr: Int = r;
        if d == 0 { nr = r + 1; }
        if d == 1 { nc = c + 1; }
        if d == 2 { nr = r - 1; }
        if d == 3 { nc = c - 1; }
        if nc >= 1 && nc <= info.cols && nr >= 1 && nr <= info.rows {
            if bn_intext(info, nc, nr) == 1 {
                let id: Int = bn_at(info, nc, nr);
                if list_get(linked, id) == 0 { out = list_push(out, id); }
            }
        }
        d = d + 1;
    }
    return out;
}

fn bn_rm(xs: List[Int], i: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut k: Int = 0;
    while k < list_len(xs) {
        if k != i { out = list_push(out, list_get(xs, k)); }
        k = k + 1;
    }
    return out;
}

pub fn bn_step(info: CanvasInfo, st: BnSt) -> BnSt {
    let d1: DR = rng_range(st.rng, 0, list_len(st.edges));
    let mut edges: List[Int] = bn_rm(st.edges, d1.v);
    let cur: Int = list_get(st.edges, d1.v);
    let mut linked: List[Int] = st.linked;
    let mut order: List[Int] = st.order;
    let mut r: Rng = d1.r;
    let nbs: List[Int] = bn_nbs(info, bn_col(info, cur), bn_row(info, cur), linked);
    if list_len(nbs) > 0 {
        let d2: DR = rng_range(r, 0, list_len(nbs));
        r = d2.r;
        let nxt: Int = list_get(nbs, d2.v);
        let nbs2: List[Int] = bn_rm(nbs, d2.v);
        linked = list_set(linked, cur, 1);
        linked = list_set(linked, nxt, 1);
        order = list_push(order, nxt);
        if list_len(nbs2) > 0 { edges = list_push(edges, cur); }
        let nn: List[Int] = bn_nbs(info, bn_col(info, nxt), bn_row(info, nxt), linked);
        if list_len(nn) > 0 { edges = list_push(edges, nxt); }
    }
    let _r1 = BnSt { edges: edges, linked: linked, order: order, rng: r };
    return _r1;
}

pub fn bn_link(info: CanvasInfo, start: Int, rng: Rng) -> BnSt {
    let n: Int = info.cols * info.rows;
    let mut linked: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n { linked = list_push(linked, 0); i = i + 1; }
    let _r2 = BnSt {
        edges: list_push(list_new(), start),
        linked: linked,
        order: list_push(list_new(), start),
        rng: rng
    };
    return _r2;
}
