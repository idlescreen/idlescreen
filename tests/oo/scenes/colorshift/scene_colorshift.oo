// # scene_colorshift — radial spectrum rotation port
//
// Logline: Bit-exact port of ColorShift::build/next_frame: each glyph
// cycles a looped 7-stop spectrum rotated by its normalized radial
// distance from text center, twice, then settles through an 8-step
// gradient to its vertical final-gradient color. No motion, no RNG.
// Setup: SceneComplete on "gradient" enqueues a callback (kernel pend
// triple); the drain counts completions per char — first reactivates
// "gradient", second activates "final_gradient" (cycles = 2).
// Beats:
//   1. cs_build seeds both scenes and the callback registration.
//   2. cs_drain replays dispatch_callback over pending triples.
//   3. colorshift_run updates+drains until the active set empties.

import "tests/oo/canvas_cells.oo";
import "tests/oo/grid_cells.oo";
import "tests/oo/kernel/world_ops.oo";
import "tests/oo/kernel/engine_ops.oo";
import "tests/oo/kernel/engine_tick.oo";
import "tests/oo/kernel/engine_render.oo";
import "tests/oo/kernel/engine_core.oo";
import "tests/oo/engapi/input_arena.oo";
import "tests/oo/engapi/char_ops.oo";
import "tests/oo/engapi/char_groups.oo";
import "tests/oo/engine/easing_fns.oo";
import "tests/oo/engine/gradient_map.oo";
import "tests/oo/engine/geometry_fns.oo";
import "tests/oo/engine/float_conv.oo";
import "tests/oo/engine/rng_xoshiro.oo";
import "tests/digest_run.oo";

pub type CsD = struct { w: World, counts: List[Int] };

fn cs_stops() -> List[Int] {
    let mut s: List[Int] = list_new();
    s = list_push(s, 15209494);
    s = list_push(s, 16753920);
    s = list_push(s, 16444214);
    s = list_push(s, 7979796);
    s = list_push(s, 4750823);
    s = list_push(s, 4929181);
    s = list_push(s, 7354013);
    return s;
}

fn cs_build(w: World, info: CanvasInfo) -> World {
    let stops: List[Int] = cs_stops();
    let fspec: List[Int] = gradient_new(stops, list_push(list_new(), 12), 0);
    let cmap: List[Int] = cmap_v(fspec, info.tb, info.tt);
    let spec: List[Int] = gradient_new(stops, list_push(list_new(), 12), 1);
    let ids: List[Int] = sort_ids(w, collect_ids(w, 1), info.cols, info.rows, 0);
    let mut w2: World = w;
    let mut k: Int = 0;
    while k < list_len(ids) {
        let id: Int = list_get(ids, k);
        let ch: Char = list_get(w2.chars, id);
        let ffg: Int = list_get(cmap, ch.row0 - info.tb);
        let d: Float = norm_dist_center(info.tb, info.tt, info.tl, info.tr, ch.col0, ch.row0);
        let sh: Int = trunc_i(int_to_f(list_len(spec)) * d);
        w2 = w_scene(w2, id, 0, 0, 0, ez(0), "gradient");
        let mut c: Int = 0;
        while c < list_len(spec) {
            w2 = w_frame(w2, id, 0, ch.sym, 1, list_get(spec, (sh + c) % list_len(spec)), 0 - 1, 0 - 1);
            c = c + 1;
        }
        let last: Int = list_get(spec, (sh + list_len(spec) - 1) % list_len(spec));
        w2 = w_scene(w2, id, 0, 0, 0, ez(0), "final_gradient");
        let fg: List[Int] = gradient_new(list_push(list_push(list_new(), last), ffg), list_push(list_new(), 8), 0);
        let mut c2: Int = 0;
        while c2 < list_len(fg) {
            w2 = w_frame(w2, id, 1, ch.sym, 1, list_get(fg, c2), 0 - 1, 0 - 1);
            c2 = c2 + 1;
        }
        w2 = w_aset(w2, id, 0);
        w2 = w_set_vis(w2, id, 1);
        w2 = w_active_add(w2, id);
        w2 = w_reg(w2, id, 2, 0, "gradient", EvAct { kind: 7, sid: "", num: 0, carg: 0 });
        k = k + 1;
    }
    return w2;
}

fn cs_drain(w: World, counts: List[Int]) -> CsD {
    let mut w2: World = w;
    let mut cn: List[Int] = counts;
    let mut p: Int = 0;
    while p < list_len(w2.pend) {
        let cid: Int = list_get(w2.pend, p);
        let n: Int = list_get(cn, cid) + 1;
        cn = list_set(cn, cid, n);
        if n < 2 { w2 = w_aset(w2, cid, 0); }
        else { w2 = w_aset(w2, cid, 1); }
        w2 = w_active_add(w2, cid);
        p = p + 3;
    }
    w2 = World { chars: w2.chars, active: w2.active, rng: w2.rng,
        next_id: w2.next_id, pend: list_new() };
    let _r1 = CsD { w: w2, counts: cn };
    return _r1;
}

pub fn colorshift_run(cells: List[CellGeom], info: CanvasInfo, lines: List[String]) -> DigestRun {
    let mut w: World = cs_build(w_input(info, lines, rng_seed(42)), info);
    let mut counts: List[Int] = list_new();
    let mut z: Int = 0;
    while z < list_len(w.chars) { counts = list_push(counts, 0); z = z + 1; }
    let mut run: DigestRun = digest_run_new();
    let _ = cells;
    while list_len(w.active) > 0 {
        w = eng_update(w);
        let dr: CsD = cs_drain(w, counts);
        w = dr.w;
        counts = dr.counts;
        let pcs: List[PaintCell] = eng_render(w, info.cols, info.rows);
        run = run_push(run, digest_paint_cells(pcs), pcs);
    }
    return run;
}
