// # scene_aurora — boreal aurora harmonic ribbon curtain port
//
// Logline: Bit-exact port of Aurora::next_frame for the parity harness.
//
// Setup: Reuses the production ascii/scenes/veil/aurora.oo stateful step API; aurora_run tapes every frame into a DigestRun.
//
// Beats:
//   1. aurora_run drives aurora_new/next/advance and returns the digest stream.

import "ascii/scenes/veil/aurora.oo";
import "tests/digest_run.oo";

pub fn aurora_run(cells: List[CellGeom], info: CanvasInfo) -> DigestRun {
    let mut a: Aurora = aurora_new(cells, info);
    let mut run: DigestRun = digest_run_new();
    while true {
        let pcs: List[PaintCell] = aurora_next(a);
        if list_len(pcs) == 0 { break; }
        run = run_push(run, digest_paint_cells(pcs), pcs);
        a = aurora_advance(a);
    }
    return run;
}
