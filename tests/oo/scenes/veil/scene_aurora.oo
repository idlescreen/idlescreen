// # scene_aurora — boreal aurora harmonic ribbon curtain port
//
// Logline: Bit-exact port of Aurora::next_frame for the parity harness.
//
// Setup: Built over canvas_cells geometry + math_paint shared helpers. frame counts 1..=64; frame 64 settles text cells to bevel colors.
//
// Beats:
//   1. aurora_new builds the 60-step palette and 3-stop final spectrum.
//   2. aurora_next computes ribbon curtain intensity per cell.
//   3. aurora_run drives the loop and returns the digest stream.

import "tests/oo/canvas_cells.oo";
import "tests/oo/grid_cells.oo";
import "tests/oo/gradient_spectrum.oo";
import "tests/oo/math_paint.oo";
import "tests/shade_float.oo";
import "tests/digest_run.oo";

pub type Aurora = struct {
    cells: List[CellGeom],
    palette: List[Int],
    final_spec: List[Int],
    frame: Int,
    frame_f: Float,
    info: CanvasInfo
};

fn aurora_stops5() -> List[Int] {
    let mut s: List[Int] = list_new();
    s = list_push(s, 0 * 65536 + 59 * 256 + 36);
    s = list_push(s, 0 * 65536 + 229 * 256 + 117);
    s = list_push(s, 0 * 65536 + 216 * 256 + 255);
    s = list_push(s, 122 * 65536 + 40 * 256 + 255);
    s = list_push(s, 224 * 65536 + 176 * 256 + 255);
    return s;
}

fn aurora_stops3() -> List[Int] {
    let mut s: List[Int] = list_new();
    s = list_push(s, 0 * 65536 + 229 * 256 + 117);
    s = list_push(s, 0 * 65536 + 216 * 256 + 255);
    s = list_push(s, 224 * 65536 + 176 * 256 + 255);
    return s;
}

pub fn aurora_new(cells: List[CellGeom], info: CanvasInfo) -> Aurora {
    let _r1 = Aurora {
        cells: cells,
        palette: spectrum_build(aurora_stops5(), 12),
        final_spec: spectrum_build(aurora_stops3(), 12),
        frame: 0,
        frame_f: 0.0,
        info: info
    };
    return _r1;
}

fn aurora_cell(a: Aurora, c: CellGeom, t: Float, fill_fade: Float, reveal_y: Float) -> PaintCell {
    let mut locked: Int = 0;
    if c.fill == 0 && c.ny <= reveal_y { locked = 1; }
    let ribbon1: Float = 0.38 + 0.20 * sin(c.nx * 5.2 + t * 1.9) + 0.10 * cos(c.nx * 11.5 - t * 1.3);
    let ribbon2: Float = 0.64 + 0.18 * cos(c.nx * 4.1 - t * 1.6) + 0.09 * sin((c.nx + c.ny) * 8.4 + t * 2.3);
    let d1: Float = abs_f(c.ny - ribbon1);
    let d2: Float = abs_f(c.ny - ribbon2);
    let curtain: Float = max_f(exp(0.0 - d1 * 6.0), exp(0.0 - d2 * 6.5) * 0.88);
    let shimmer: Float = 0.55 + 0.45 * sin(c.nx * 18.0 + t * 3.4);
    let intensity: Float = clamp_f(curtain * shimmer, 0.0, 1.0);
    let _r2 = math_paint_cell(c, a.info, a.palette, a.final_spec, intensity, locked, fill_fade);
    return _r2;
}

pub fn aurora_next(a: Aurora) -> List[PaintCell] {
    let mut out: List[PaintCell] = list_new();
    if a.frame >= 64 { return out; }
    let frame: Int = a.frame + 1;
    let n: Int = list_len(a.cells);
    if frame == 64 {
        let mut i: Int = 0;
        while i < n {
            out = list_push(out, settle_paint_cell(list_get(a.cells, i), a.info));
            i = i + 1;
        }
        return out;
    }
    let frame_f: Float = a.frame_f + 1.0;
    let progress: Float = frame_f / 64.0;
    let t: Float = frame_f * 0.09;
    let mut fill_fade: Float = 1.0;
    if progress > 0.72 { fill_fade = clamp_f((1.0 - progress) / 0.28, 0.0, 1.0); }
    let reveal_y: Float = clamp_f(progress * 1.35 - 0.15, 0.0, 1.0);
    let mut j: Int = 0;
    while j < n {
        out = list_push(out, aurora_cell(a, list_get(a.cells, j), t, fill_fade, reveal_y));
        j = j + 1;
    }
    return out;
}

pub fn aurora_advance(a: Aurora) -> Aurora {
    let _r3 = Aurora {
        cells: a.cells,
        palette: a.palette,
        final_spec: a.final_spec,
        frame: a.frame + 1,
        frame_f: a.frame_f + 1.0,
        info: a.info
    };
    return _r3;
}

pub fn aurora_run(cells: List[CellGeom], info: CanvasInfo) -> DigestRun {
    let mut a: Aurora = aurora_new(cells, info);
    let mut run: DigestRun = digest_run_new();
    while true {
        let pcs: List[PaintCell] = aurora_next(a);
        if list_len(pcs) == 0 { break; }
        run = run_push(run, digest_paint_cells(pcs), pcs);
        a = aurora_advance(a);
    }
    return run;
}
