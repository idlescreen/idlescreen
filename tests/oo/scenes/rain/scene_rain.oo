// # scene_rain — falling-drop reveal port
//
// Logline: Bit-exact port of Rain::build/next_frame for the parity
// harness: each input glyph falls from the canvas top as a random
// rain symbol along an InExpo path, then fades through a 7-step
// gradient into the diagonal final-gradient color.
// Setup: Characters release from the lowest input row group upward,
// 1-2 random pending chars per frame. RNG draws mirror Rust build
// order per char: rain color choice, rain symbol choice, speed
// uniform; then per frame randint(1,2) and index randints.
// Beats:
//   1. rn_build seeds scenes, paths, and the PathComplete event.
//   2. rn_release pops random pending chars from the current group.
//   3. rain_run drives frames until groups+pending+active drain.

import "tests/oo/canvas_cells.oo";
import "tests/oo/grid_cells.oo";
import "tests/oo/kernel/world_ops.oo";
import "tests/oo/kernel/engine_ops.oo";
import "tests/oo/kernel/engine_tick.oo";
import "tests/oo/kernel/engine_render.oo";
import "tests/oo/kernel/engine_core.oo";
import "tests/oo/engapi/input_arena.oo";
import "tests/oo/engapi/char_ops.oo";
import "tests/oo/engapi/char_groups.oo";
import "tests/oo/engine/easing_fns.oo";
import "tests/oo/engine/gradient_map.oo";
import "tests/oo/engine/rng_xoshiro.oo";
import "tests/oo/engine/rng_helpers.oo";
import "tests/digest_run.oo";
import "tests/oo/kernel/path_ops.oo";

pub type RnQ = struct { w: World, pend: List[Int] };

fn rn_colors() -> List[Int] {
    let mut s: List[Int] = list_new();
    s = list_push(s, 12636);
    s = list_push(s, 19599);
    s = list_push(s, 30171);
    s = list_push(s, 4166105);
    s = list_push(s, 7911922);
    s = list_push(s, 10143989);
    s = list_push(s, 12114168);
    s = list_push(s, 14938108);
    return s;
}

fn rn_syms() -> List[Int] {
    let mut s: List[Int] = list_new();
    s = list_push(s, 111);
    s = list_push(s, 46);
    s = list_push(s, 44);
    s = list_push(s, 42);
    s = list_push(s, 124);
    return s;
}

fn rn_build(w: World, info: CanvasInfo) -> World {
    let ids: List[Int] = sort_ids(w, collect_ids(w, 1), info.cols, info.rows, 0);
    let stops: List[Int] = list_push(list_push(list_push(list_new(), 4754431), 11724766), 5761783);
    let spec: List[Int] = gradient_new(stops, list_push(list_new(), 12), 0);
    let cmap: List[Int] = cmap_d(spec, info.tb, info.tt, info.tl, info.tr);
    let cols: List[Int] = rn_colors();
    let syms: List[Int] = rn_syms();
    let mut w2: World = w;
    let mut k: Int = 0;
    while k < list_len(ids) {
        let id: Int = list_get(ids, k);
        let ch: Char = list_get(w2.chars, id);
        let ci: Int = (ch.row0 - info.tb) * (info.tr - info.tl + 1) + (ch.col0 - info.tl);
        let ffg: Int = list_get(cmap, ci);
        let dc: DR = rng_pick(w2.rng, 8);
        w2 = w_rng(w2, dc.r);
        let rcol: Int = list_get(cols, dc.v);
        w2 = w_scene(w2, id, 0, 0, 0, ez(0), "");
        let ds: DR = rng_pick(w2.rng, 5);
        w2 = w_rng(w2, ds.r);
        w2 = w_frame(w2, id, 0, list_get(syms, ds.v), 1, rcol, 0 - 1, 0 - 1);
        w2 = w_scene(w2, id, 0, 0, 0, ez(0), "");
        let g: List[Int] = gradient_new(list_push(list_push(list_new(), rcol), ffg), list_push(list_new(), 7), 0);
        w2 = w_grad(w2, id, 1, list_push(list_new(), ch.sym), 3, g, list_new());
        w2 = w_aset(w2, id, 0);
        let sp: DRF = rng_unif(w2.rng, 0.6, 1.1);
        w2 = w_rng(w2, sp.r);
        w2 = w_pos(w2, id, ch.col0, info.top);
        w2 = w_path(w2, id, wp_cfg(sp.v, 1, ez(16), 0 - 1, 0, 0), "");
        w2 = w_wp(w2, id, 0, ch.col0, ch.row0, list_new());
        w2 = w_reg(w2, id, 1, 1, "0", EvAct { kind: 1, sid: "1", num: 0, carg: 0 });
        w2 = eng_act_path(w2, id, 0);
        k = k + 1;
    }
    return w2;
}

fn rn_rm(xs: List[Int], i: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut k: Int = 0;
    while k < list_len(xs) {
        if k != i { out = list_push(out, list_get(xs, k)); }
        k = k + 1;
    }
    return out;
}

fn rn_release(w: World, pend: List[Int]) -> RnQ {
    let mut w2: World = w;
    let mut p2: List[Int] = pend;
    let dn: DR = rng_int(w2.rng, 1, 2);
    w2 = w_rng(w2, dn.r);
    let mut t: Int = 0;
    while t < dn.v {
        if list_len(p2) > 0 {
            let di: DR = rng_int(w2.rng, 0, list_len(p2) - 1);
            w2 = w_rng(w2, di.r);
            let id: Int = list_get(p2, di.v);
            p2 = rn_rm(p2, di.v);
            w2 = w_set_vis(w2, id, 1);
            w2 = w_active_add(w2, id);
        }
        t = t + 1;
    }
    let _r1 = RnQ { w: w2, pend: p2 };
    return _r1;
}

pub fn rain_run(cells: List[CellGeom], info: CanvasInfo, lines: List[String]) -> DigestRun {
    let mut w: World = rn_build(w_input(info, lines, rng_seed(42)), info);
    let g: Groups = groups_of(w, collect_ids(w, 1), 1, 0, 0, 0);
    let mut gi: Int = 0;
    let mut pend: List[Int] = list_new();
    let mut run: DigestRun = digest_run_new();
    let _ = cells;
    while gi < list_len(g.keys) || list_len(pend) > 0 || list_len(w.active) > 0 {
        if list_len(pend) == 0 && gi < list_len(g.keys) {
            pend = grp_win(g, gi);
            gi = gi + 1;
        }
        if list_len(pend) > 0 {
            let q: RnQ = rn_release(w, pend);
            w = q.w;
            pend = q.pend;
        }
        w = eng_update(w);
        let pcs: List[PaintCell] = eng_render(w, info.cols, info.rows);
        run = run_push(run, digest_paint_cells(pcs), pcs);
    }
    return run;
}
