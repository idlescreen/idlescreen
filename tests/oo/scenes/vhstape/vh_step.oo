// # vh_step — vhstape next_frame: glitch wave, glitch lines, noise, redraw
// Logline: One frame of the VHS tape effect — wave band slides, stray lines
//   glitch, noise snows the canvas, then lines redraw to stable colors.
// Setup: Draw order mirrors vhstape_build.rs; the wave only rolls its two
//   floats while populated; steps >= 90 restores everything.
// Beats: vh_wave, vh_glitching, vh_noise, vh_redraw, vh_frame.
import "tests/oo/scenes/vhstape/vh_sim.oo";
import "tests/oo/engine/float_conv.oo";
import "tests/oo/engine/rng_xoshiro.oo";
import "tests/oo/engine/rng_helpers.oo";
import "tests/oo/canvas_cells.oo";



pub fn vh_has(xs: List[Int], v: Int) -> Int {
    let mut i: Int = 0;
    while i < list_len(xs) {
        if list_get(xs, i) == v { return 1; }
        i = i + 1;
    }
    return 0;
}

pub fn vh_wave(s: VhS, info: CanvasInfo) -> VhS {
    let mut w: World = s.w;
    let mut top: Int = s.top;
    let mut wave: List[Int] = s.wave;
    let th: Int = info.tt - info.tb + 1;
    if top == 0 - 1 || top == 0 {
        if th >= 3 {
            let mut lo: Int = round_he(int_to_f(th) * 0.5);
            if lo < 3 { lo = 3; }
            let d: DR = rng_int(w.rng, lo, th);
            w = w_rng(w, d.r);
            top = info.tb + d.v;
        } else {
            let _r1 = VhS { w: w, g: s.g, top: top, wave: wave, gl: s.gl,
                steps: s.steps, phase: s.phase, redraw: s.redraw, redrawing: s.redrawing };
            return _r1;
        }
    }
    let mut all_done: Int = 1;
    let mut i: Int = 0;
    while i < list_len(wave) {
        if vh_mdone(w, grp_win(s.g, list_get(wave, i))) == 0 { all_done = 0; }
        i = i + 1;
    }
    if all_done == 1 {
        let t: VhS = vh_wave_move(VhS { w: w, g: s.g, top: top, wave: wave,
            gl: s.gl, steps: s.steps, phase: s.phase, redraw: s.redraw,
            redrawing: s.redrawing }, info);
        return t;
    }
    let _r2 = VhS { w: w, g: s.g, top: top, wave: wave, gl: s.gl,
        steps: s.steps, phase: s.phase, redraw: s.redraw, redrawing: s.redrawing };
    return _r2;
}

pub fn vh_wave_move(s: VhS, info: CanvasInfo) -> VhS {
    let mut w: World = s.w;
    let mut top: Int = s.top;
    let mut wave: List[Int] = s.wave;
    if list_len(wave) > 0 {
        let f1: DRF = rng_random(w.rng);
        w = w_rng(w, f1.r);
        let mut delta: Int = 0;
        if f1.v < 0.3 {
            let f2: DRF = rng_random(w.rng);
            w = w_rng(w, f2.r);
            delta = if f2.v < 0.3 { 1 } else { 0 - 1 };
        }
        top = top + delta;
        if top < 2 { top = 2; }
        if top > info.tt { top = info.tt; }
    }
    let mut nw: List[Int] = list_new();
    let mut li: Int = top - 2;
    while li <= top {
        let adj: Int = li - (info.tb - 1);
        if adj >= 0 && adj < list_len(s.g.keys) { nw = list_push(nw, adj); }
        li = li + 1;
    }
    let mut j: Int = 0;
    while j < list_len(wave) {
        let idx: Int = list_get(wave, j);
        if vh_has(nw, idx) == 0 {
            w = vh_restore(w, grp_win(s.g, idx));
            w = vh_insert(w, grp_win(s.g, idx));
        }
        j = j + 1;
    }
    wave = nw;
    if top < info.tb + 2 {
        let mut k: Int = 0;
        while k < list_len(wave) {
            w = vh_restore(w, grp_win(s.g, list_get(wave, k)));
            w = vh_insert(w, grp_win(s.g, list_get(wave, k)));
            k = k + 1;
        }
        wave = list_new();
        top = 0 - 1;
    } else {
        let pids: List[String] = list_push(list_push(list_push(list_new(),
            "glitch_wave_mid"), "glitch_wave_end"), "glitch_wave_mid");
        let mut k2: Int = 0;
        while k2 < list_len(wave) && k2 < 3 {
            let idx2: Int = list_get(wave, k2);
            w = vh_line_act(w, grp_win(s.g, idx2), list_get(pids, k2));
            w = vh_insert(w, grp_win(s.g, idx2));
            k2 = k2 + 1;
        }
    }
    let _r3 = VhS { w: w, g: s.g, top: top, wave: wave, gl: s.gl,
        steps: s.steps, phase: s.phase, redraw: s.redraw, redrawing: s.redrawing };
    return _r3;
}

pub fn vh_glitching(s: VhS, info: CanvasInfo) -> VhS {
    let mut t: VhS = s;
    let mut wave_done: Int = 1;
    if list_len(s.wave) > 0 {
        let mut i: Int = 0;
        while i < list_len(s.wave) {
            if vh_mdone(s.w, grp_win(s.g, list_get(s.wave, i))) == 0 { wave_done = 0; }
            i = i + 1;
        }
    }
    if list_len(s.wave) == 0 || wave_done == 1 { t = vh_wave(s, info); }
    let mut gl: List[Int] = list_new();
    let mut j: Int = 0;
    while j < list_len(t.gl) {
        let idx: Int = list_get(t.gl, j);
        if vh_mdone(t.w, grp_win(t.g, idx)) == 0 { gl = list_push(gl, idx); }
        j = j + 1;
    }
    let mut w: World = t.w;
    let f1: DRF = rng_random(w.rng);
    w = w_rng(w, f1.r);
    if f1.v < 0.22 && list_len(gl) < 3 {
        let d1: DR = rng_pick(w.rng, list_len(t.g.keys));
        w = w_rng(w, d1.r);
        if vh_has(t.wave, d1.v) == 0 && vh_has(gl, d1.v) == 0 {
            let d2: DR = rng_int(w.rng, 20, 75);
            w = w_rng(w, d2.r);
            w = vh_hold(w, grp_win(t.g, d1.v), d2.v);
            gl = list_push(gl, d1.v);
            w = vh_glitch(w, grp_win(t.g, d1.v), 0);
            w = vh_insert(w, grp_win(t.g, d1.v));
        }
    }
    let f2: DRF = rng_random(w.rng);
    w = w_rng(w, f2.r);
    if f2.v < 0.025 {
        let mut k: Int = 0;
        while k < list_len(t.g.keys) {
            w = vh_snow(w, grp_win(t.g, k));
            if vh_has(t.wave, k) == 0 && vh_has(gl, k) == 0 {
                w = vh_insert(w, grp_win(t.g, k));
            }
            k = k + 1;
        }
    }
    let _r3 = vh_wind(VhS { w: w, g: t.g, top: t.top, wave: t.wave, gl: gl,
        steps: t.steps + 1, phase: t.phase, redraw: t.redraw, redrawing: t.redrawing });
    return _r3;
}

pub fn vh_wind(t: VhS) -> VhS {
    let mut w: World = t.w;
    let mut phase: Int = t.phase;
    if t.steps >= 90 {
        let mut m: Int = 0;
        while m < list_len(t.wave) {
            w = vh_restore(w, grp_win(t.g, list_get(t.wave, m)));
            m = m + 1;
        }
        let mut m2: Int = 0;
        while m2 < list_len(t.gl) {
            w = vh_restore(w, grp_win(t.g, list_get(t.gl, m2)));
            m2 = m2 + 1;
        }
        phase = 1;
    }
    let _r4 = VhS { w: w, g: t.g, top: t.top, wave: t.wave, gl: t.gl,
        steps: t.steps, phase: phase, redraw: t.redraw, redrawing: t.redrawing };
    return _r4;
}
