// # scene_bouncyballs — bouncing drop reveal port
//
// Logline: Bit-exact port of BouncyBalls::build/next_frame: glyphs
// drop from int(top * uniform(1.0,1.5)) as random ball symbols along
// OutBounce paths at 0.75 speed, then gradient 10 steps (6 frames
// each) from ball color to the diagonal final color.
// Setup: Release mirrors rain's min-row groups, but bursts of
// randint(2,6) fire only every ball_delay+1 frames (delay 2). RNG
// per char in build: ball color choice, ball symbol choice, drop
// uniform; PathComplete activates the final scene.
// Beats:
//   1. bb_build seeds ball/final scenes, paths, and the event.
//   2. bb_release pops random pending chars when the delay lapses.
//   3. bouncyballs_run drives until groups+pending+active drain.

import "tests/oo/canvas_cells.oo";
import "tests/oo/grid_cells.oo";
import "tests/oo/kernel/world_ops.oo";
import "tests/oo/kernel/engine_ops.oo";
import "tests/oo/kernel/engine_tick.oo";
import "tests/oo/kernel/engine_render.oo";
import "tests/oo/kernel/engine_core.oo";
import "tests/oo/engapi/input_arena.oo";
import "tests/oo/engapi/char_ops.oo";
import "tests/oo/engapi/char_groups.oo";
import "tests/oo/engine/easing_fns.oo";
import "tests/oo/engine/gradient_map.oo";
import "tests/oo/engine/float_conv.oo";
import "tests/oo/engine/rng_xoshiro.oo";
import "tests/oo/engine/rng_helpers.oo";
import "tests/digest_run.oo";

pub type BbQ = struct { w: World, pend: List[Int], delay: Int };

fn bb_colors() -> List[Int] {
    let mut s: List[Int] = list_new();
    s = list_push(s, 13759653);
    s = list_push(s, 9888420);
    s = list_push(s, 5950889);
    return s;
}

fn bb_syms() -> List[Int] {
    let mut s: List[Int] = list_new();
    s = list_push(s, 42);
    s = list_push(s, 111);
    s = list_push(s, 79);
    s = list_push(s, 48);
    s = list_push(s, 46);
    return s;
}

fn bb_build(w: World, info: CanvasInfo) -> World {
    let stops: List[Int] = list_push(list_push(list_new(), 16318382), 4441772);
    let spec: List[Int] = gradient_new(stops, list_push(list_new(), 12), 0);
    let cmap: List[Int] = cmap_d(spec, info.tb, info.tt, info.tl, info.tr);
    let cols: List[Int] = bb_colors();
    let syms: List[Int] = bb_syms();
    let ids: List[Int] = sort_ids(w, collect_ids(w, 1), info.cols, info.rows, 0);
    let mut w2: World = w;
    let mut k: Int = 0;
    while k < list_len(ids) {
        let id: Int = list_get(ids, k);
        let ch: Char = list_get(w2.chars, id);
        let ci: Int = (ch.row0 - info.tb) * (info.tr - info.tl + 1) + (ch.col0 - info.tl);
        let ffg: Int = list_get(cmap, ci);
        let dc: DR = rng_pick(w2.rng, 3);
        w2 = w_rng(w2, dc.r);
        let bcol: Int = list_get(cols, dc.v);
        let ds: DR = rng_pick(w2.rng, 5);
        w2 = w_rng(w2, ds.r);
        w2 = w_scene(w2, id, 0, 0, 0, ez(0), "");
        w2 = w_frame(w2, id, 0, list_get(syms, ds.v), 1, bcol, 0 - 1, 0 - 1);
        w2 = w_scene(w2, id, 0, 0, 0, ez(0), "");
        let g: List[Int] = gradient_new(list_push(list_push(list_new(), bcol), ffg), list_push(list_new(), 10), 0);
        w2 = w_grad(w2, id, 1, list_push(list_new(), ch.sym), 6, g, list_new());
        let du: DRF = rng_unif(w2.rng, 1.0, 1.5);
        w2 = w_rng(w2, du.r);
        w2 = w_pos(w2, id, ch.col0, trunc_i(int_to_f(info.top) * du.v));
        w2 = w_path(w2, id, 0.75, 1, ez(29), 0 - 1, 0, 0, "");
        w2 = w_wp(w2, id, 0, ch.col0, ch.row0, list_new());
        w2 = eng_act_path(w2, id, 0);
        w2 = w_aset(w2, id, 0);
        w2 = w_reg(w2, id, 1, 1, "0", EvAct { kind: 1, sid: "1", num: 0, carg: 0 });
        k = k + 1;
    }
    return w2;
}

fn bb_rm(xs: List[Int], i: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut k: Int = 0;
    while k < list_len(xs) {
        if k != i { out = list_push(out, list_get(xs, k)); }
        k = k + 1;
    }
    return out;
}

fn bb_release(w: World, pend: List[Int], delay: Int) -> BbQ {
    if delay != 0 {
        let _r1 = BbQ { w: w, pend: pend, delay: delay - 1 };
        return _r1;
    }
    let mut w2: World = w;
    let mut p2: List[Int] = pend;
    let dn: DR = rng_int(w2.rng, 2, 6);
    w2 = w_rng(w2, dn.r);
    let mut t: Int = 0;
    while t < dn.v {
        if list_len(p2) > 0 {
            let di: DR = rng_int(w2.rng, 0, list_len(p2) - 1);
            w2 = w_rng(w2, di.r);
            let id: Int = list_get(p2, di.v);
            p2 = bb_rm(p2, di.v);
            w2 = w_set_vis(w2, id, 1);
            w2 = w_active_add(w2, id);
        }
        t = t + 1;
    }
    let _r2 = BbQ { w: w2, pend: p2, delay: 2 };
    return _r2;
}

pub fn bouncyballs_run(cells: List[CellGeom], info: CanvasInfo, lines: List[String]) -> DigestRun {
    let mut w: World = bb_build(w_input(info, lines, rng_seed(42)), info);
    let g: Groups = groups_of(w, collect_ids(w, 1), 1, 0, 0, 0);
    let mut gi: Int = 0;
    let mut pend: List[Int] = list_new();
    let mut delay: Int = 0;
    let mut run: DigestRun = digest_run_new();
    let _ = cells;
    while gi < list_len(g.keys) || list_len(pend) > 0 || list_len(w.active) > 0 {
        if list_len(pend) == 0 && gi < list_len(g.keys) {
            pend = grp_win(g, gi);
            gi = gi + 1;
        }
        if list_len(pend) > 0 {
            let q: BbQ = bb_release(w, pend, delay);
            w = q.w;
            pend = q.pend;
            delay = q.delay;
        }
        w = eng_update(w);
        let pcs: List[PaintCell] = eng_render(w, info.cols, info.rows);
        run = run_push(run, digest_paint_cells(pcs), pcs);
    }
    return run;
}
