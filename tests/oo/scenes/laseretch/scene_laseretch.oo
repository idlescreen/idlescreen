// # scene_laseretch — laseretch digest driver
// Logline: Bit-exact port of LaserEtchIterator.next_frame: release up to
// six pending backtracker chars per tick, skip uncolored spaces, chase the
// diagonal beam to each release, then tick, drain spark reclaims, emit.
// Setup: pending chars pop from the front; etch_delay is zero so every
// frame releases; beam chars stay active while pending remains and are
// hidden (laser_disable) once it drains.
// Beats:
//   1. Build: input, spawn scenes, backtracker order, pool, beam.
//   2. le_release pops and activates up to etch_speed pending chars.
//   3. Tick via eng_update, reclaim finished sparks, digest the frame.

import "tests/oo/kernel/engine_tick.oo";
import "tests/oo/kernel/engine_render.oo";
import "tests/oo/kernel/world_ops.oo";
import "tests/oo/engapi/char_ops.oo";
import "tests/oo/engapi/char_deact.oo";
import "tests/oo/engapi/input_arena.oo";
import "tests/oo/engine/rng_xoshiro.oo";
import "tests/oo/canvas_cells.oo";
import "tests/oo/grid_cells.oo";
import "tests/oo/scenes/laseretch/le_build.oo";
import "tests/oo/scenes/laseretch/le_laser.oo";
import "tests/digest_run.oo";

pub type LeS = struct {
    w: World,
    pend: List[Int],
    beam: List[Int],
    avail: List[Int],
    delay: Int
};

fn le_repos(w: World, beam: &List[Int], av0: List[Int], tc: Int, tr: Int) -> LeP {
    let mut w2: World = w;
    let mut k: Int = 0;
    while k < list_len(beam) {
        w2 = w_pos(w2, list_get(beam, k), tc + k, tr + k);
        k = k + 1;
    }
    let e: LeP = le_emit(w2, av0, tc, tr);
    return e;
}

fn le_release(w: World, pd: List[Int], beam: &List[Int],
              av0: List[Int]) -> LeS {
    let mut w2: World = w;
    let mut p2: List[Int] = pd;
    let mut av: List[Int] = av0;
    let mut s: Int = 0;
    while s < 6 && list_len(p2) > 0 {
        let mut nxt: Int = list_get(p2, 0);
        p2 = list_slice(p2, 1, list_len(p2));
        let mut ch: Char = list_get(w2.chars, nxt);
        let mut skip: Int = 1;
        while skip == 1 {
            if ch.sym != 32 { skip = 0; }
            if skip == 1 {
                if list_len(p2) == 0 { skip = 0; }
                if skip == 1 {
                    nxt = list_get(p2, 0);
                    p2 = list_slice(p2, 1, list_len(p2));
                    ch = list_get(w2.chars, nxt);
                }
            }
        }
        w2 = w_set_vis(w2, nxt, 1);
        w2 = w_active_add(w2, nxt);
        let rp: LeP = le_repos(w2, beam, av, ch.col0, ch.row0);
        w2 = rp.w;
        av = rp.avail;
        s = s + 1;
    }
    let bc: List[Int] = list_slice(beam, 0, list_len(beam));
    return LeS { w: w2, pend: p2, beam: bc, avail: av, delay: 0 };
}

fn le_arm(xs: List[Int], id: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut k: Int = 0;
    while k < list_len(xs) {
        if list_get(xs, k) != id { out = list_push(out, list_get(xs, k)); }
        k = k + 1;
    }
    return out;
}

fn le_reclaim(w: World, av0: List[Int], id: Int) -> LeP {
    let mut w2: World = w_set_vis(w, id, 0);
    w2 = w_deact_p(w2, id, 0 - 1);
    w2 = w_deact_s(w2, id, 0 - 1);
    w2 = World { chars: w2.chars, active: le_arm(w2.active, id), rng: w2.rng,
        next_id: w2.next_id, pend: w2.pend };
    let mut av2: List[Int] = av0;
    let mut has: Int = 0;
    let mut k: Int = 0;
    while k < list_len(av2) {
        if list_get(av2, k) == id { has = 1; }
        k = k + 1;
    }
    if has == 0 { av2 = list_push(av2, id); }
    return LeP { w: w2, avail: av2 };
}

fn le_drain(w: World, av0: List[Int]) -> LeP {
    let mut w2: World = w;
    let mut av: List[Int] = av0;
    let mut p: Int = 0;
    while p < list_len(w2.pend) {
        let cid: Int = list_get(w2.pend, p);
        let cb: Int = list_get(w2.pend, p + 1);
        if cb == 0 {
            let r: LeP = le_reclaim(w2, av, cid);
            w2 = r.w;
            av = r.avail;
        }
        p = p + 3;
    }
    w2 = World { chars: w2.chars, active: w2.active, rng: w2.rng,
        next_id: w2.next_id, pend: list_new() };
    return LeP { w: w2, avail: av };
}

pub fn laseretch_run(cells: List[CellGeom], info: CanvasInfo,
                     lines: List[String]) -> DigestRun {
    let mut w: World = w_input(info, lines, rng_seed(42));
    w = le_scenes(w, info);
    let grid: List[Int] = le_grid(w);
    let lo: LeOrder = le_pending(w, grid, info);
    w = w_rng(w, lo.r);
    let mut pend: List[Int] = lo.order;
    let lp: LeP = le_pool(w);
    let lb: LeB = le_beam(lp);
    w = lb.w;
    let mut av0: List[Int] = lb.avail;
    let beam: List[Int] = lb.beam;
    let mut k: Int = 0;
    while k < list_len(beam) {
        w = w_active_add(w, list_get(beam, k));
        k = k + 1;
    }
    let mut run: DigestRun = digest_run_new();
    let _ = cells;
    while list_len(pend) > 0 || list_len(w.active) > 0 {
        let rel: LeS = le_release(w, pend, beam, av0);
        w = rel.w;
        pend = rel.pend;
        av0 = rel.avail;
        if list_len(pend) == 0 {
            let mut b: Int = 0;
            while b < list_len(beam) {
                w = w_set_vis(w, list_get(beam, b), 0);
                b = b + 1;
            }
        } else {
            let mut b: Int = 0;
            while b < list_len(beam) {
                w = w_active_add(w, list_get(beam, b));
                b = b + 1;
            }
        }
        w = eng_update(w);
        let d: LeP = le_drain(w, av0);
        w = d.w;
        av0 = d.avail;
        let pcs: List[PaintCell] = eng_render(w, info.cols, info.rows);
        run = run_push(run, digest_paint_cells(pcs), pcs);
    }
    return run;
}
