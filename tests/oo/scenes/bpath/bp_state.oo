// # bp_state — binarypath representation state and build helpers
//
// Logline: Shared types and pure build helpers for the BinaryPath port:
// the BRep record (source id, eight binary char ids, pending list, home
// coord, active flag) plus the RNG-driven waypoint path generator and
// per-char provisioning used by the driver.
// Setup: Pure. Coords pack as col*1000+row (canvas is <=80x24). RNG draws
// mirror upstream order: 4 edge randints + pick for the start coord, one
// pick for orientation, then per-segment randints, then per-bin color.
// Beats:
//   1. bp_tab holds the two config color tables.
//   2. bp_coords replays Canvas.random_coord + the col/row walk exactly.
//   3. bp_provision wires one rep's eight binary chars (pos, path,
//      waypoints, activate, layer, color scene).
//   4. bp_scenes builds collapse/brighten scenes for each input char.

import "tests/oo/canvas_cells.oo";
import "tests/oo/kernel/world_ops.oo";
import "tests/oo/kernel/engine_ops.oo";
import "tests/oo/kernel/engine_core.oo";
import "tests/oo/engapi/char_ops.oo";
import "tests/oo/engine/easing_fns.oo";
import "tests/oo/engine/float_conv.oo";
import "tests/oo/engine/gradient_map.oo";
import "tests/oo/engine/color_ops.oo";
import "tests/oo/engine/rng_xoshiro.oo";
import "tests/oo/engine/rng_helpers.oo";
import "tests/oo/kernel/path_ops.oo";

pub type BRep = struct {
    cid: Int,
    bins: List[Int],
    pb: List[Int],
    icol: Int,
    irow: Int,
    act: Int
};

pub type CPR = struct { w: World, pts: List[Int] };
pub type ST = struct { w: World, rep: BRep };
pub type WQ = struct { w: World, q: List[Int], done: Int };
pub type BRS = struct { w: World, pend: List[BRep], max: Int };
pub type BSeg = struct { nc: Int, nr: Int, lo: Int, r: Rng };
pub type BTA = struct { w: World, pend: List[BRep], areps: List[BRep] };

pub fn bp_tab(k: Int) -> List[Int] {
    let mut s: List[Int] = list_new();
    if k == 0 {
        s = list_push(s, 54528);
        s = list_push(s, 29952);
        return s;
    }
    s = list_push(s, 282153);
    s = list_push(s, 1408568);
    s = list_push(s, 4570965);
    s = list_push(s, 9825671);
    return s;
}

pub fn bp_coords(w: World, icol: Int, irow: Int, info: CanvasInfo) -> CPR {
    let d1: DR = rng_int(w.rng, info.left, info.right);
    let d2: DR = rng_int(d1.r, info.left, info.right);
    let d3: DR = rng_int(d2.r, info.bottom, info.top);
    let d4: DR = rng_int(d3.r, info.bottom, info.top);
    let d5: DR = rng_pick(d4.r, 4);
    let mut sc: Int = d1.v;
    let mut sr: Int = info.top + 1;
    if d5.v == 1 {
        sc = d2.v;
        sr = info.bottom - 1;
    }
    if d5.v == 2 {
        sc = info.left - 1;
        sr = d3.v;
    }
    if d5.v == 3 {
        sc = info.right + 1;
        sr = d4.v;
    }
    let mut pts: List[Int] = list_push(list_new(), sc * 1000 + sr);
    let d6: DR = rng_pick(d5.r, 2);
    let mut seg: BSeg = BSeg { nc: sc, nr: sr, lo: d6.v, r: d6.r };
    while seg.nc != icol || seg.nr != irow {
        seg = bp_seg(seg, icol, irow, info);
        pts = list_push(pts, seg.nc * 1000 + seg.nr);
    }
    pts = list_push(pts, icol * 1000 + irow);
    pts = list_push(pts, icol * 1000 + irow);
    let _r1 = CPR { w: w_rng(w, seg.r), pts: pts };
    return _r1;
}

fn bp_seg(seg: BSeg, icol: Int, irow: Int, info: CanvasInfo) -> BSeg {
    let lc: Int = seg.nc;
    let lr: Int = seg.nr;
    let mut cd: Int = 0;
    if lc > icol { cd = 0 - 1; }
    if lc < icol { cd = 1; }
    let mut rd: Int = 0;
    if lr > irow { rd = 0 - 1; }
    if lr < irow { rd = 1; }
    let mut mcd: Int = lc - icol;
    if mcd < 0 { mcd = 0 - mcd; }
    let mut mrd: Int = lr - irow;
    if mrd < 0 { mrd = 0 - mrd; }
    let mut o: BSeg = BSeg { nc: icol, nr: irow, lo: seg.lo, r: seg.r };
    if seg.lo == 0 && mrd > 0 {
        let mut lim: Int = trunc_i(int_to_f(info.right) * 0.2);
        if lim < 10 { lim = 10; }
        if mrd < lim { lim = mrd; }
        let dd: DR = rng_int(seg.r, 1, lim);
        o = BSeg { nc: lc, nr: lr + dd.v * rd, lo: 1, r: dd.r };
    }
    if seg.lo == 1 && mcd > 0 {
        let mut lm: Int = mcd;
        if lm > 4 { lm = 4; }
        let dd: DR = rng_int(seg.r, 1, lm);
        o = BSeg { nc: lc + dd.v * cd, nr: lr, lo: 0, r: dd.r };
    }
    return o;
}

pub fn bp_provision(w: World, rep: BRep, pts: List[Int]) -> World {
    let mut w2: World = w;
    let mut k: Int = 0;
    while k < list_len(rep.bins) {
        let bid: Int = list_get(rep.bins, k);
        w2 = w_pos(w2, bid, list_get(pts, 0) / 1000, list_get(pts, 0) % 1000);
        w2 = w_path(w2, bid, wp_cfg(2.0, 0, ez(0), 0 - 1, 0, 0), "");
        let mut j: Int = 0;
        while j < list_len(pts) {
            w2 = w_wp(w2, bid, 0, list_get(pts, j) / 1000, list_get(pts, j) % 1000, list_new());
            j = j + 1;
        }
        w2 = eng_act_path(w2, bid, 0);
        w2 = w_lay(w2, bid, 1);
        let dc: DR = rng_pick(w2.rng, 4);
        w2 = w_rng(w2, dc.r);
        let bc: Char = list_get(w2.chars, bid);
        w2 = w_scene(w2, bid, 0, 0, 0, ez(0), "");
        w2 = w_frame(w2, bid, 0, bc.sym, 1, list_get(bp_tab(1), dc.v), 0 - 1, 0 - 1);
        w2 = w_aset(w2, bid, 0);
        k = k + 1;
    }
    return w2;
}

fn bp_rm(reps: List[BRep], i: Int) -> List[BRep] {
    let mut out: List[BRep] = list_new();
    let mut k: Int = 0;
    while k < list_len(reps) {
        if k != i { out = list_push(out, list_get(reps, k)); }
        k = k + 1;
    }
    return out;
}

pub fn bp_travel(w: World, rep: BRep) -> ST {
    if list_len(rep.pb) > 0 {
        let bid: Int = list_get(rep.pb, 0);
        let rep2: BRep = BRep { cid: rep.cid, bins: rep.bins,
            pb: list_slice(rep.pb, 1, list_len(rep.pb)),
            icol: rep.icol, irow: rep.irow, act: rep.act };
        let mut w2: World = w_active_add(w, bid);
        w2 = w_set_vis(w2, bid, 1);
        let _r2 = ST { w: w2, rep: rep2 };
        return _r2;
    }
    let mut done: Int = 1;
    let mut k: Int = 0;
    while k < list_len(rep.bins) {
        let bc: Char = list_get(w.chars, list_get(rep.bins, k));
        if bc.cc != rep.icol || bc.cr != rep.irow { done = 0; }
        k = k + 1;
    }
    let mut w3: World = w;
    let mut rep3: BRep = rep;
    if done == 1 {
        let mut j: Int = 0;
        while j < list_len(rep.bins) {
            w3 = w_set_vis(w3, list_get(rep.bins, j), 0);
            j = j + 1;
        }
        rep3 = BRep { cid: rep.cid, bins: rep.bins, pb: rep.pb, icol: rep.icol, irow: rep.irow, act: 0 };
        w3 = w_set_vis(w3, rep.cid, 1);
        w3 = w_aset(w3, rep.cid, 0);
        w3 = w_active_add(w3, rep.cid);
    }
    let _r3 = ST { w: w3, rep: rep3 };
    return _r3;
}

pub fn bp_travel_all(w: World, pend: List[BRep], areps: List[BRep], mx: Int) -> BTA {
    let mut w2: World = w;
    let mut p2: List[BRep] = pend;
    let mut a2: List[BRep] = areps;
    while list_len(a2) < mx && list_len(p2) > 0 {
        let d: DR = rng_range(w2.rng, 0, list_len(p2));
        w2 = w_rng(w2, d.r);
        a2 = list_push(a2, list_get(p2, d.v));
        p2 = bp_rm(p2, d.v);
    }
    let mut a3: List[BRep] = list_new();
    let mut k: Int = 0;
    while k < list_len(a2) {
        let stp: ST = bp_travel(w2, list_get(a2, k));
        w2 = stp.w;
        if stp.rep.act == 1 { a3 = list_push(a3, stp.rep); }
        k = k + 1;
    }
    let _r4 = BTA { w: w2, pend: p2, areps: a3 };
    return _r4;
}

pub fn bp_scenes(w: World, ids: List[Int], cmap: List[Int], info: CanvasInfo) -> World {
    let mut w2: World = w;
    let mut k: Int = 0;
    while k < list_len(ids) {
        let id: Int = list_get(ids, k);
        let ch: Char = list_get(w2.chars, id);
        let ci: Int = (ch.row0 - info.tb) * (info.tr - info.tl + 1) + (ch.col0 - info.tl);
        let ffg: Int = list_get(cmap, ci);
        let dim: Int = adjust_brightness(ffg, 0.5);
        w2 = w_scene(w2, id, 0, 0, 1, ez(4), "collapse_scn");
        let g1: List[Int] = gradient_new(list_push(list_push(list_new(), 16777215), dim), list_push(list_new(), 7), 0);
        w2 = w_grad(w2, id, 0, list_push(list_new(), ch.sym), 3, g1, list_new());
        w2 = w_scene(w2, id, 0, 0, 0, ez(0), "brighten_scn");
        let g2: List[Int] = gradient_new(list_push(list_push(list_new(), dim), ffg), list_push(list_new(), 10), 0);
        w2 = w_grad(w2, id, 1, list_push(list_new(), ch.sym), 2, g2, list_new());
        k = k + 1;
    }
    return w2;
}
