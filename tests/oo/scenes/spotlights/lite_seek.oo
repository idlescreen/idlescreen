// # lite_seek — spotlight seeker provisioning
//
// Logline: Bit-exact port of Spotlights.make_spotlights: four added
// "O" chars spawn just off-canvas, each with 11 chained looping
// InOutQuad bezier search paths (targets at least right/4 apart)
// plus an InOutSine "center" path used when the search ends.
// Setup: RNG mirrors Rust per spotlight: outside spawn coord (col,
// col, row, row draws then a 4-pick), first target (col, row), ten
// minimum-distance targets (rejection loop on doubled-row distance
// NOT applied — plain line length), then per path a uniform speed
// and an outside bezier control coord.
// Beats:
//   1. lite_outside/lite_inside replay Canvas.random_coord draws.
//   2. lite_far rejection-samples the next search target.
//   3. lite_make adds the char, its 11 search paths + chain events.

import "tests/oo/canvas_cells.oo";
import "tests/oo/kernel/world_ops.oo";
import "tests/oo/kernel/engine_ops.oo";
import "tests/oo/engapi/char_ops.oo";
import "tests/oo/engine/easing_fns.oo";
import "tests/oo/engine/geometry_fns.oo";
import "tests/oo/engine/rng_xoshiro.oo";
import "tests/oo/engine/rng_helpers.oo";
import "tests/oo/kernel/path_ops.oo";

pub type LiteB = struct { w: World, spots: List[Int] };
pub type LiteC = struct { w: World, c: Int, r: Int };

fn lite_outside(w: World, info: CanvasInfo) -> LiteC {
    let d1: DR = rng_int(w.rng, info.left, info.right);
    let d2: DR = rng_int(d1.r, info.left, info.right);
    let d3: DR = rng_int(d2.r, info.bottom, info.top);
    let d4: DR = rng_int(d3.r, info.bottom, info.top);
    let d5: DR = rng_pick(d4.r, 4);
    let mut c: Int = d1.v;
    let mut r: Int = info.top + 1;
    if d5.v == 1 {
        c = d2.v;
        r = info.bottom - 1;
    }
    if d5.v == 2 {
        c = info.left - 1;
        r = d3.v;
    }
    if d5.v == 3 {
        c = info.right + 1;
        r = d4.v;
    }
    let _r1 = LiteC { w: w_rng(w, d5.r), c: c, r: r };
    return _r1;
}

fn lite_inside(w: World, info: CanvasInfo) -> LiteC {
    let d1: DR = rng_int(w.rng, info.left, info.right);
    let d2: DR = rng_int(d1.r, info.bottom, info.top);
    let _r2 = LiteC { w: w_rng(w, d2.r), c: d1.v, r: d2.v };
    return _r2;
}

fn lite_far(w: World, info: CanvasInfo, oc: Int, orow: Int, mind: Int) -> LiteC {
    let mut cur: LiteC = lite_inside(w, info);
    while len_line(oc, orow, cur.c, cur.r, 0) < int_to_f(mind) {
        cur = lite_inside(cur.w, info);
    }
    return cur;
}

fn lite_one(w: World, info: CanvasInfo) -> LiteC {
    let spawn: LiteC = lite_outside(w, info);
    let mut w2: World = spawn.w;
    w2 = w_add_char(w2, 79, spawn.c, spawn.r);
    let sid: Int = list_len(w2.chars) - 1;
    let mind: Int = info.right / 4;
    let first: LiteC = lite_inside(w2, info);
    w2 = first.w;
    let mut targets: List[Int] = list_push(list_push(list_new(), first.c), first.r);
    let mut lc: Int = first.c;
    let mut lr: Int = first.r;
    let mut t: Int = 0;
    while t < 10 {
        let nx: LiteC = lite_far(w2, info, lc, lr, mind);
        w2 = nx.w;
        targets = list_push(list_push(targets, nx.c), nx.r);
        lc = nx.c;
        lr = nx.r;
        t = t + 1;
    }
    let mut p: Int = 0;
    while p < 11 {
        let sp: DRF = rng_unif(w2.rng, 0.85, 1.6);
        w2 = w_rng(w2, sp.r);
        w2 = w_path(w2, sid, wp_cfg(sp.v, 1, ez(6), 0 - 1, 0, 0), p.to_string());
        let bez: LiteC = lite_outside(w2, info);
        w2 = bez.w;
        w2 = w_wp(w2, sid, p, list_get(targets, p * 2), list_get(targets, p * 2 + 1),
            list_push(list_push(list_new(), bez.c), bez.r));
        p = p + 1;
    }
    let mut q: Int = 1;
    while q < 11 {
        w2 = w_reg(w2, sid, 1, 1, (q - 1).to_string(), EvAct { kind: 0, sid: q.to_string(), num: 0, carg: 0 });
        q = q + 1;
    }
    w2 = w_reg(w2, sid, 1, 1, "10", EvAct { kind: 0, sid: "0", num: 0, carg: 0 });
    let mut crow: Int = info.top / 2;
    if crow < info.bottom { crow = info.bottom; }
    if info.top % 2 != 0 && info.top > 1 { crow = crow + 1; }
    let mut ccol: Int = info.right / 2;
    if ccol < info.left { ccol = info.left; }
    if info.right % 2 != 0 && info.right > 1 { ccol = ccol + 1; }
    w2 = w_path(w2, sid, wp_cfg(0.5, 1, ez(3), 0 - 1, 0, 0), "center");
    w2 = w_wp(w2, sid, 11, ccol, crow, list_new());
    let _r3 = LiteC { w: w2, c: sid, r: 0 };
    return _r3;
}

pub fn lite_make(w: World, info: CanvasInfo) -> LiteB {
    let mut w2: World = w;
    let mut spots: List[Int] = list_new();
    let mut s: Int = 0;
    while s < 4 {
        let one: LiteC = lite_one(w2, info);
        w2 = one.w;
        spots = list_push(spots, one.c);
        s = s + 1;
    }
    let _r4 = LiteB { w: w2, spots: spots };
    return _r4;
}
