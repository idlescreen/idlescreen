// # mx_geom — matrix rain-column state, spectra, and column constructor
// Logline: RainColumn records, the rain glyph alphabet, the rain and final
//   colour spectra, and the final gradient map over the canvas.
// Setup: Pure constructors and gradient maps; per-column layout (groups_of
//   bucketing and mx_cols) lives in mx_setup.oo.
// Beats: MxCol/MxT/MxL records, mx_rsyms alphabet, mx_rcol spectrum,
//   mx_fspec/mx_fmap final gradient, mx_col_new constructor.
import "tests/oo/kernel/world_ops.oo";
import "tests/oo/engine/gradient_map.oo";
import "tests/oo/canvas_cells.oo";



pub type MxCol = struct {
    chars: List[Int], pend: List[Int], vis: List[Int],
    phase: Int, drop: Int, bd: Int, ad: Int, len: Int, hold: Int
};

pub type MxT = struct { w: World, c: MxCol };

pub type MxL = struct { w: World, ls: List[MxCol] };

pub fn mx_rsyms() -> List[Int] {
    let s0: List[Int] = list_push(list_push(list_push(list_push(list_new(), 50), 53), 57), 56);
    let s1: List[Int] = list_push(list_push(list_push(list_push(s0, 90), 42), 41), 58);
    let s2: List[Int] = list_push(list_push(list_push(list_push(s1, 46), 34), 61), 43);
    let o0: List[Int] = list_push(list_push(list_push(s2, 45), 166), 124);
    let o1: List[Int] = list_push(o0, 95);
    let o2: List[Int] = list_push(list_push(list_push(list_push(o1, 65382), 65393), 65395), 65396);
    let o3: List[Int] = list_push(list_push(list_push(list_push(o2, 65397), 65398), 65399), 65401);
    let o4: List[Int] = list_push(list_push(list_push(list_push(o3, 65402), 65403), 65404), 65405);
    let o5: List[Int] = list_push(list_push(list_push(o4, 65406), 65407), 65408);
    let o6: List[Int] = list_push(list_push(o5, 65410), 65411);
    let p0: List[Int] = list_push(list_push(list_push(list_push(o6, 65413), 65414), 65415), 65416);
    let p1: List[Int] = list_push(list_push(list_push(list_push(p0, 65418), 65419), 65422), 65423);
    let p2: List[Int] = list_push(list_push(list_push(list_push(p1, 65424), 65425), 65426), 65427);
    let p3: List[Int] = list_push(list_push(list_push(list_push(p2, 65428), 65429), 65431), 65432);
    let _r1 = list_push(p3, 65436);
    return _r1;
}

pub fn mx_rcol() -> List[Int] {
    let st: List[Int] = list_push(list_push(list_new(), 9617042), 1594136);
    let _r2 = gradient_new(st, list_push(list_new(), 6), 0);
    return _r2;
}

pub fn mx_fspec() -> List[Int] {
    let st: List[Int] = list_push(list_push(list_new(), 9617042), 3369779);
    let _r3 = gradient_new(st, list_push(list_new(), 12), 0);
    return _r3;
}

pub fn mx_fmap(spec: List[Int], info: CanvasInfo) -> List[Int] {
    let _r4 = cmap_r(spec, info.tb, info.tt, info.tl, info.tr);
    return _r4;
}

pub fn mx_col_new(chars: List[Int]) -> MxCol {
    let _r5 = MxCol { chars: chars, pend: list_new(), vis: list_new(),
        phase: 0, drop: 0, bd: 0, ad: 0, len: 0, hold: 0 };
    return _r5;
}
