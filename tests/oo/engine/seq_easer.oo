// # seq_easer — ttfx EasingTracker and SequenceEaser stepping
//
// Logline: Bit-exact tracker stepping (progress ratio, eased value, delta)
// and the SequenceEaser added/removed window computed by int() truncation
// on eased*len, used by the wipe-family group reveals.
// Setup: Pure. The sequence is a List[Int] of character ids (the only
// element type the probe scenes ease). clamp is always on, matching
// SequenceEaser::new.
// Beats:
//   1. trk_new/trk_step reproduce EasingTracker with clamped eased value.
//   2. seq_step reproduces SequenceEaser.step's add/remove windows.
//   3. seq_complete/trk_complete report tracker completion.

import "tests/oo/engine/easing_fns.oo";
import "tests/oo/engine/float_conv.oo";
import "tests/shade_float.oo";

pub type Trk = struct { e: Ease, total: Int, cur: Int, eased: Float, last: Float };
pub type SeqStep = struct { add: List[Int], rem: List[Int], trk: Trk };

pub fn trk_new(e: Ease, total: Int) -> Trk {
    return Trk { e: e, total: total, cur: 0, eased: 0.0, last: 0.0 };
}

pub fn trk_complete(t: Trk) -> Int {
    if t.cur >= t.total { return 1; }
    return 0;
}

pub fn trk_step(t: Trk) -> Trk {
    if t.cur >= t.total { return t; }
    let cur: Int = t.cur + 1;
    let ratio: Float = int_to_f(cur) / int_to_f(t.total);
    let mut eased: Float = ease_val(t.e, ratio);
    if eased > 1.0 { eased = 1.0; }
    if eased < 0.0 { eased = 0.0; }
    return Trk { e: t.e, total: t.total, cur: cur, eased: eased, last: t.eased };
}

pub fn seq_step(seq: List[Int], t: Trk) -> SeqStep {
    let prev: Float = t.eased;
    let t2: Trk = trk_step(t);
    let n: Int = list_len(seq);
    let len: Int = trunc_i(t2.eased * int_to_f(n));
    let plen: Int = trunc_i(prev * int_to_f(n));
    let mut add: List[Int] = list_new();
    let mut rem: List[Int] = list_new();
    if len > plen {
        let mut i: Int = plen;
        while i < len { add = list_push(add, list_get(seq, i)); i = i + 1; }
    }
    if len < plen {
        let mut j: Int = len;
        while j < plen { rem = list_push(rem, list_get(seq, j)); j = j + 1; }
    }
    return SeqStep { add: add, rem: rem, trk: t2 };
}
