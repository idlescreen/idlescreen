// # float_conv — exact f64 <-> i64 conversions and u64 bit ops
//
// Logline: Bit-exact conversions oodac lacks natively: u53->f64 by exact
// doubling, Python round() half-to-even, int() truncation, and logical right
// shift plus rotate-left for u64 words riding in signed Ints.
// Setup: Pure arithmetic. No caps. u53_to_f reproduces `(v >> 11) as f64`
// exactly (each step is an exact double below 2^53).
// Beats:
//   1. u53_to_f rebuilds a <=53-bit int as Float via acc*2+bit from MSB.
//   2. round_he is Python round(): ties go to the even neighbour.
//   3. trunc_i is int(): truncation toward zero (probe magnitudes < 4096).
//   4. lshr/rotl give u64 semantics under either Int >> flavour.

import "tests/shade_float.oo";

pub fn u53_to_f(v: Int) -> Float {
    let mut acc: Float = 0.0;
    let mut i: Int = 52;
    while i >= 0 {
        let b: Int = (v >> i) & 1;
        acc = acc * 2.0 + int_to_f(b);
        i = i - 1;
    }
    return acc;
}

fn floor_i(x: Float) -> Int {
    if x >= 0.0 { return float_idx(x); }
    let nx: Float = 0.0 - x;
    let t: Int = float_idx(nx);
    if nx - int_to_f(t) > 0.0 { return 0 - t - 1; }
    return 0 - t;
}

pub fn round_he(x: Float) -> Int {
    let f: Int = floor_i(x);
    let diff: Float = x - int_to_f(f);
    if diff > 0.5 { return f + 1; }
    if diff < 0.5 { return f; }
    if f % 2 == 0 { return f; }
    return f + 1;
}

pub fn trunc_i(x: Float) -> Int {
    if x >= 0.0 { return float_idx(x); }
    return 0 - float_idx(0.0 - x);
}

pub fn lshr(x: Int, n: Int) -> Int {
    if n <= 0 { return x; }
    if n >= 64 { return 0; }
    return (x >> n) & ((1 << (64 - n)) - 1);
}

pub fn rotl(x: Int, k: Int) -> Int {
    return (x << k) | lshr(x, 64 - k);
}
