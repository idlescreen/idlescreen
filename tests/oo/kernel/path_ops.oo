// # path_ops — ttfx Path construction and activation
//
// Logline: Bit-exact path provisioning: waypoint segments with bezier or
// line distances, and the activate_path origin-segment rewrite with
// total/max-steps recomputation and layer adoption.
// Setup: Pure transitions over Char/Path. segs[0] with s=-1 is the
// synthetic origin segment; its start coord lives in oc/orow.
// Beats:
//   1. path_new/wp_add build paths and recompute totals + max_steps.
//   2. path_activate installs the origin segment like activate_path.

import "tests/oo/kernel/world_ops.oo";
import "tests/oo/engine/geometry_fns.oo";
import "tests/oo/engine/easing_fns.oo";
import "tests/oo/engine/float_conv.oo";

pub type WpCfg = struct {
    speed: Float, ease_on: Int, e: Ease, layer: Int, hold: Int, loop_: Int
};

pub fn wp_cfg(speed: Float, ease_on: Int, e: Ease, layer: Int, hold: Int, loop_: Int) -> WpCfg {
    return WpCfg { speed: speed, ease_on: ease_on, e: e, layer: layer, hold: hold, loop_: loop_ };
}

pub fn path_new(speed: Float, ease_on: Int, e: Ease, layer: Int, hold: Int, loop_: Int) -> Path {
    let _r1 = Path { speed: speed, ease_on: ease_on, ease: e, layer: layer, hold: hold,
        loop_: loop_, segs: list_new(), wps: list_new(), total: 0.0, cur: 0,
        msteps: 0, hrem: hold, ldist: 0.0, oc: 0, orow: 0, has_org: 0 };
    return _r1;
}

pub fn wp_add(p: Path, c: Int, r: Int, bez: List[Int]) -> Path {
    let wps: List[Wp] = list_push(p.wps, Wp { c: c, r: r, bez: bez });
    if list_len(wps) < 2 {
        let _r2 = Path { speed: p.speed, ease_on: p.ease_on, ease: p.ease, layer: p.layer,
            hold: p.hold, loop_: p.loop_, segs: p.segs, wps: wps, total: p.total,
            cur: p.cur, msteps: p.msteps, hrem: p.hrem, ldist: p.ldist,
            oc: p.oc, orow: p.orow, has_org: p.has_org };
        return _r2;
    }
    let prev: Wp = list_get(wps, list_len(wps) - 2);
    let cur: Wp = list_get(wps, list_len(wps) - 1);
    let mut d: Float = len_line(prev.c, prev.r, cur.c, cur.r, 1);
    if list_len(cur.bez) > 0 { d = len_bez(prev.c, prev.r, cur.bez, cur.c, cur.r); }
    let total: Float = p.total + d;
    let _r3 = Path { speed: p.speed, ease_on: p.ease_on, ease: p.ease, layer: p.layer,
        hold: p.hold, loop_: p.loop_,
        segs: list_push(p.segs, Seg { s: list_len(wps) - 2, e: list_len(wps) - 1, d: d }),
        wps: wps, total: total, cur: p.cur,
        msteps: round_he(total / p.speed), hrem: p.hrem, ldist: p.ldist,
        oc: p.oc, orow: p.orow, has_org: p.has_org };
    return _r3;
}

pub fn path_put(p: Path, segs: List[Seg], st: PathCur)-> Path {
    let _r4 = Path { speed: p.speed, ease_on: p.ease_on, ease: p.ease, layer: p.layer,
        hold: p.hold, loop_: p.loop_, segs: segs, wps: p.wps, total: st.total,
        cur: st.cur, msteps: st.msteps, hrem: st.hrem, ldist: st.ldist, oc: st.oc, orow: st.orow, has_org: st.has_org };
    return _r4;
}

pub fn path_activate(ch: Char, pi: Int) -> Char {
    let p: Path = list_get(ch.paths, pi);
    let w0: Wp = list_get(p.wps, 0);
    let mut d: Float = len_line(ch.cc, ch.cr, w0.c, w0.r, 1);
    if list_len(w0.bez) > 0 { d = len_bez(ch.cc, ch.cr, w0.bez, w0.c, w0.r); }
    let nseg: Seg = Seg { s: 0 - 1, e: 0, d: d };
    let mut segs: List[Seg] = p.segs;
    let mut total: Float = p.total + d;
    if p.has_org == 1 {
        total = total - list_get(segs, 0).d;
        segs = list_set(segs, 0, nseg);
    } else {
        segs = list_push(list_new(), nseg);
        let mut i: Int = 0;
        while i < list_len(p.segs) {
            segs = list_push(segs, list_get(p.segs, i));
            i = i + 1;
        }
    }
    let p2: Path = path_put(p, segs, PathCur { total: total, cur: 0, msteps: round_he(total / p.speed),
        hrem: p.hold, ldist: p.ldist, oc: ch.cc, orow: ch.cr, has_org: 1 });
    let layer: Int = if p.layer >= 0 { p.layer } else { ch.layer };
    let _r5 = Char { sym: ch.sym, col0: ch.col0, row0: ch.row0, fill: ch.fill,
        uses_pre: ch.uses_pre, vis: ch.vis, layer: layer, cc: ch.cc, cr: ch.cr, pc: ch.pc, pr: ch.pr,
        v_ord: ch.v_ord, v_fg: ch.v_fg, v_bg: ch.v_bg, v_bold: ch.v_bold,
        a_scene: ch.a_scene, sids: ch.sids, scenes: ch.scenes, a_path: pi,
        done_path: ch.done_path, pids: ch.pids, paths: list_set(ch.paths, pi, p2), evs: ch.evs };
    return _r5;
}
