// # shade_float — exact f64 helpers for parity probes
//
// Logline: Bit-exact f64 helpers the math scenes need; oodac has no `as` numeric casts so conversions use exact bounded loops.
//
// Setup: Pure functions over Float and Int. No caps. int_to_f/float_idx are exact for |n| < 4096 (all probe uses qualify).
//
// Beats:
//   1. int_to_f converts small Ints to Float by exact +1.0 accumulation.
//   2. float_idx truncates a non-negative Float via repeated -1.0.
//   3. round_f/clamp_f/abs_f/max_f mirror Rust f64 scalar semantics.

pub fn int_to_f(n: Int) -> Float {
    let mut acc: Float = 0.0;
    let mut i: Int = 0;
    let mut k: Int = n;
    if k < 0 { k = 0 - k; }
    while i < k {
        acc = acc + 1.0;
        i = i + 1;
    }
    if n < 0 { return 0.0 - acc; }
    return acc;
}

pub fn float_idx(v: Float) -> Int {
    if v < 0.0 { return 0; }
    let mut n: Int = 0;
    let mut r: Float = v;
    while r >= 1.0 {
        r = r - 1.0;
        n = n + 1;
        if n > 4096 { return n; }
    }
    return n;
}

pub fn clamp_f(x: Float, lo: Float, hi: Float) -> Float {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

pub fn round_f(x: Float) -> Float {
    let mut neg: Int = 0;
    let mut v: Float = x;
    if v < 0.0 { v = 0.0 - v; neg = 1; }
    let mut t: Float = 0.0;
    let mut r: Float = v;
    while r >= 1.0 {
        r = r - 1.0;
        t = t + 1.0;
    }
    let mut out: Float = t;
    if r >= 0.5 { out = t + 1.0; }
    if neg == 1 { return 0.0 - out; }
    return out;
}

pub fn floor_f(x: Float) -> Float {
    if x >= 0.0 { return int_to_f(float_idx(x)); }
    let nx: Float = 0.0 - x;
    let t: Float = int_to_f(float_idx(nx));
    if nx - t > 0.0 { return 0.0 - t - 1.0; }
    return 0.0 - t;
}

pub fn rem_euclid_f(x: Float, m: Float) -> Float {
    return x - m * floor_f(x / m);
}

pub fn abs_f(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn max_f(a: Float, b: Float) -> Float {
    if a > b { return a; }
    return b;
}
