// # ooidle Persona - Idle Daemon Entrypoint
//
// Logline: The ooidle persona: foreground idle daemon with a control-socket query path for the CLI verbs.
// Setup: Requires BindCap, FsCap, FsWriteCap, FsReadCap, ProcessCap, EnvCap, TimeCap, and RandCap.
// Beats:
//   1. Parse daemon verbs from the argument list.
//   2. Run the blocking reactor for daemon/run verbs, or serve one-shot queries over the Unix control socket.
//   3. Exit 0 on clean shutdown, 69 on bind failure.

import "oostd/net/unix_grp/unix_socket.oo";
import "core/environ.oo";
import "reactor.oo";

// One request/response round trip over the Unix control socket.
pub fn ctl_roundtrip(
    fs_r:&FsReadCap,
    fs:&FsCap,
    fw:&FsWriteCap,
    proc:&ProcessCap,
    prog: String,
    frame: String
)-> Result[String, String]{
    let path: String = ctl_socket_path(fs_r, proc, prog);
    let c: Result[UnixConnection, String] = unix_socket_connect(fs, fw, path);
    if c.is_err() { return Err("connect failed"); }
    let conn: UnixConnection = match c { Ok(v) => v, Err(_) => UnixConnection { slot: -1, path: path, is_open: false } };
    let _w: Int = unix_socket_write(fs, conn, frame + "\n");
    let rd: Result[String, String] = unix_socket_read_timeout(fs, conn, 2000, 4096);
    let _x: Int = unix_socket_close_connection(fs, conn);
    if rd.is_err() { return Err("no reply"); }
    return Ok(match rd { Ok(s) => s, Err(_) => "" });
}

pub fn ooidle_query(
    fs_r:&FsReadCap,
    fs:&FsCap,
    fw:&FsWriteCap,
    proc:&ProcessCap,
    prog: String,
    verb: String
)-> Int {
    let r: Result[String, String] = ctl_roundtrip(fs_r, fs, fw, proc, prog, verb);
    if r.is_err() {
        if verb == "status" {
            println(prog + " inactive (no daemon listener at " + ctl_socket_path(fs_r, proc, prog) + ")");
            return 0;
        }
        if verb == "inhibitors" {
            println("[]");
            return 0;
        }
        println(prog + " daemon not running");
        return 1;
    }
    let reply: String = match r { Ok(s) => s, Err(_) => "" };
    if reply == "" {
        println(prog + " no reply");
        return 1;
    }
    print(reply);
    return 0;
}

// Send one control frame to the daemon without printing the reply.
pub fn ooidle_notify(
    fs_r:&FsReadCap,
    fs:&FsCap,
    fw:&FsWriteCap,
    proc:&ProcessCap,
    prog: String,
    frame: String
)-> Bool {
    return ooidle_ask(fs_r, fs, fw, proc, prog, frame) != "";
}

// Send one control frame and return the trimmed reply, or "" on any failure.
pub fn ooidle_ask(
    fs_r:&FsReadCap,
    fs:&FsCap,
    fw:&FsWriteCap,
    proc:&ProcessCap,
    prog: String,
    frame: String
)-> String {
    let r: Result[String, String] = ctl_roundtrip(fs_r, fs, fw, proc, prog, frame);
    if r.is_err() { return ""; }
    let reply: String = str_trim(match r { Ok(s) => s, Err(_) => "" });
    if reply == "" || str_starts_with(reply, "ERR") { return ""; }
    return reply;
}

// Wake-up ticker: the reactor blocks in accept, so a sibling process sends
// a "tick" frame every second to let it poll the Wayland idle socket.
// Exits after three consecutive failed rounds (daemon gone).
pub fn ctl_tick_loop(
    fs_r:&FsReadCap,
    fs:&FsCap,
    fw:&FsWriteCap,
    proc:&ProcessCap,
    time:&TimeCap,
    prog: String
)-> Int {
    let mut fails: Int = 0;
    while fails < 3 {
        let ok: Bool = ooidle_notify(fs_r, fs, fw, proc, prog, "tick");
        if ok {
            fails = 0;
        } else {
            fails = fails + 1;
        }
        if fails < 3 { sleep_ms(time, 1000); }
    }
    return 0;
}

pub fn ooidle_persona_run(fs_r:&FsReadCap, fs_w:&FsWriteCap, fs:&FsCap, proc:&ProcessCap,
    bind:&BindCap, time:&TimeCap, args: List[String])-> Int {
    let mut verb: String = "run";
    if list_len(args) > 0 {
        verb = to_lowercase(str_trim(list_get(args, 0)));
    }
    if verb == "--version" || verb == "version" || verb == "-V" {
        println("ooidle 5.0.3");
        return 0;
    }
    if verb == "--help" || verb == "help" || verb == "-h" {
        println("ooidle 5.0.3 — idle daemon persona");
        println("usage: ooidle [run|status|inhibitors|start|stop|toggle|quit|inhibit NAME|uninhibit NAME|scene NAME|sleep]");
        return 0;
    }
    if verb == "daemon" || verb == "run" || verb == "serve" || verb == "start-daemon" {
        return daemon_reactor(fs_r, proc, bind, fs, fs_w, time, "ooidle");
    }
    let arg2: String = if list_len(args) > 1 { list_get(args, 1) } else { "" };
    let frame: String = if arg2 != "" { verb + " " + arg2 } else { verb };
    return ooidle_query(fs_r, fs, fs_w, proc, "ooidle", frame);
}
