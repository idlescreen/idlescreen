// # ooidle Persona - Idle Daemon Entrypoint
//
// Logline: The ooidle persona: foreground idle daemon with a status query path for the CLI verbs.
// Setup: Requires BindCap, TcpCap, FsCap, FsWriteCap, FsReadCap, EnvCap, TimeCap, and RandCap.
// Beats:
//   1. Parse daemon verbs from the argument list.
//   2. Run the blocking reactor for daemon/run verbs, or serve one-shot queries locally.
//   3. Exit 0 on clean shutdown, 1 on bind failure.

import "std/core/primitives/str.oo";
import "config.oo";
import "reactor.oo";

fn ctl_slot_of(raw: String) -> Int {
    if !str_starts_with(raw, "fd:") { return -1; }
    return parse_int_digits(str_slice(raw, 3, chars_len(raw)));
}

pub fn ooidle_query(tcp: &TcpCap, env: &EnvCap, prog: String, verb: String) -> Int {
    let c: Result[String, String] = tcp_connect(tcp, "127.0.0.1", daemon_ctl_port(prog));
    if c.is_err() {
        if verb == "status" {
            println(prog + " inactive (no daemon listener at " + daemon_ctl_endpoint(prog) + ")");
            return 0;
        }
        if verb == "inhibitors" {
            println("[]");
            return 0;
        }
        println(prog + " daemon not running");
        return 1;
    }
    let conn: Int = ctl_slot_of(match c { Ok(s) => s, Err(_) => "" });
    if conn < 0 { println(prog + " connect slot invalid"); return 1; }
    let wverb: String = verb + "\n";
    let _ = tcp_write(tcp, conn, wverb);
    let rd: Result[String, String] = tcp_read(tcp, conn, 4096);
    let reply: String = match rd { Ok(s) => s, Err(_) => "" };
    let _ = tcp_close(tcp, conn);
    if reply == "" { println(prog + " no reply"); return 1; }
    print(reply);
    return 0;
}

// Send one control frame to the daemon without printing the reply.
pub fn ooidle_notify(tcp: &TcpCap, env: &EnvCap, prog: String, frame: String) -> Bool {
    let c: Result[String, String] = tcp_connect(tcp, "127.0.0.1", daemon_ctl_port(prog));
    if c.is_err() { return false; }
    let raw: String = match c { Ok(v) => v, Err(_) => "" };
    if !str_starts_with(raw, "fd:") { return false; }
    let conn: Int = ctl_slot_of(raw);
    if conn < 0 { return false; }
    let wframe: String = frame + "\n";
    let _ = tcp_write(tcp, conn, wframe);
    let rd: Result[String, String] = tcp_read(tcp, conn, 4096);
    let _ = tcp_close(tcp, conn);
    let reply: String = match rd { Ok(v) => str_trim(v), Err(_) => "" };
    if reply == "" { return false; }
    return !str_starts_with(reply, "ERR");
}

pub fn ooidle_persona_run(fs_r: &FsReadCap, fs_w: &FsWriteCap, fs: &FsCap, proc: &ProcessCap, bind: &BindCap, tcp: &TcpCap, env: &EnvCap, time: &TimeCap, rand: &RandCap, args: List[String]) -> Int {
    let mut verb: String = "run";
    if list_len(args) > 0 {
        verb = to_lowercase(str_trim(list_get(args, 0)));
    }
    if verb == "--version" || verb == "version" || verb == "-V" {
        println("ooidle 5.0.2");
        return 0;
    }
    if verb == "--help" || verb == "help" || verb == "-h" {
        println("ooidle 5.0.2 — idle daemon persona");
        println("usage: ooidle [run|status|inhibitors|start|stop|toggle|quit|inhibit NAME|uninhibit NAME|scene NAME|sleep]");
        return 0;
    }
    if verb == "daemon" || verb == "run" || verb == "serve" || verb == "start-daemon" {
        return daemon_reactor(proc, bind, tcp, fs, fs_w, env, "ooidle");
    }
    let arg2: String = if list_len(args) > 1 { list_get(args, 1) } else { "" };
    let frame: String = if arg2 != "" { verb + " " + arg2 } else { verb };
    return ooidle_query(tcp, env, "ooidle", frame);
}
