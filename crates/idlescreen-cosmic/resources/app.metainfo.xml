<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.idlescreen.CosmicApplet</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name>IdleScreen</name>
  <summary>IdleScreen screensaver applet for COSMIC</summary>
  <description>
    <p>
      Optional COSMIC Desktop panel applet for the IdleScreen Wayland idle
      and ambient screensaver daemon. Toggle the user service, idle
      activation, timeout, render scale, FPS overlay, and preview plugins.
    </p>
  </description>
  <icon type="stock">io.github.idlescreen.CosmicApplet-symbolic</icon>
  <url type="vcs-browser">https://github.com/idlescreen/idle-cosmic</url>
  <url type="homepage">https://idlescreen.github.io</url>
  <launchable type="desktop-id">io.github.idlescreen.CosmicApplet.desktop</launchable>
  <provides>
    <id>io.github.idlescreen.CosmicApplet</id>
    <binaries>
      <binary>idlescreen-applet</binary>
    </binaries>
  </provides>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <categories>
    <category>COSMIC</category>
  </categories>
  <keywords>
    <keyword>COSMIC</keyword>
    <keyword>IdleScreen</keyword>
    <keyword>screensaver</keyword>
  </keywords>
  <content_rating type="oars-1.1" />
</component>
