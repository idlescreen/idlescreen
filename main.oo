// # idlescreen Multi-Call Entrypoint
//
// Logline: Multi-call entrypoint that resolves the invoked persona from argv[0] or --persona and dispatches to it.
// Setup: Declared capabilities: Process, FsRead, FsWrite, Fs, Bind, Tcp, Env, Time, Rand, Ffi. sys_argv0 under ProcessCap authorises the persona probe; the persona owns the rest.
// Beats:
//   1. Read the invoked program basename under ProcessCap and resolve the persona with the dispatch table.
//   2. Fail closed on an unknown persona selector.
//   3. Hand the resolved persona and its stripped arguments to the persona host.

import "cli/dispatch.oo";
import "daemon/run.oo";
import "std/fs/process/process.oo";

pub fn idlescreen_persona_resolve(prog: String) -> String {
    let mut base: String = prog;
    while str_index_of(base, "/") >= 0 {
        base = str_slice(base, str_index_of(base, "/") + 1, chars_len(base));
    }
    if base == "ooidle" { return "ooidle"; }
    if str_index_of(base, "ooidle") >= 0 { return "ooidle"; }
    return "idlescreen";
}

pub fn main(
    fs_r: &FsReadCap,
    fs_w: &FsWriteCap,
    fs: &FsCap,
    bind: &BindCap,
    tcp: &TcpCap,
    env: &EnvCap,
    proc: &ProcessCap,
    time: &TimeCap,
    rand: &RandCap,
    ffi: &FfiCap,
    args: List[String]
) -> Result[Int, String] {
    let prog: String = sys_argv0(proc);
    let persona: String = idlescreen_persona_resolve(prog);
    if persona == "ooidle" {
        return Ok(ooidle_persona_run(fs_r, fs_w, fs, bind, tcp, env, time, rand, args));
    }
    return Ok(idlescreen_cli_run(fs_r, fs_w, fs, bind, tcp, env, proc, time, rand, ffi, args));
}
