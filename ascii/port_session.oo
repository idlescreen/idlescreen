pub type PortSession = struct {
    name: String,
    cols: Int,
    rows: Int,
    last: List[PaintCell],
    settled: Bool,
    tick: Int,
    wm: String,
    pf: List[PcFrame],
    plasma: Plasma,
    ripple: Ripple,
    aurora: Aurora,
    chaos: Chaos,
    metaballs: Metaballs,
    moire: Moire,
    cosmos: Cosmos,
    radar: Radar,
    tunnel: Tunnel,
    mystify: Mystify
};

fn port_run_all(name: String, cells: List[CellGeom], info: CanvasInfo, lines: List[String]) -> DigestRun {
    if name == "expand" { return expand_run(cells, info, lines); }
    if name == "wipe" { return wipe_run(cells, info, lines); }
    if name == "sweep" { return sweep_run(cells, info, lines); }
    if name == "slide" { return slide_run(cells, info, lines); }
    if name == "middleout" { return middleout_run(cells, info, lines); }
    if name == "binarypath" { return binarypath_run(cells, info, lines); }
    if name == "burn" { return burn_run(cells, info, lines); }
    if name == "blackhole" { return blackhole_run(cells, info, lines); }
    if name == "rain" { return rain_run(cells, info, lines); }
    if name == "scattered" { return scattered_run(cells, info, lines); }
    if name == "pour" { return pour_run(cells, info, lines); }
    if name == "slice" { return slice_run(cells, info, lines); }
    if name == "colorshift" { return colorshift_run(cells, info, lines); }
    if name == "highlight" { return highlight_run(cells, info, lines); }
    if name == "spray" { return spray_run(cells, info, lines); }
    if name == "overflow" { return overflow_run(cells, info, lines); }
    if name == "bouncyballs" { return bouncyballs_run(cells, info, lines); }
    if name == "decrypt" { return decrypt_run(cells, info, lines); }
    if name == "fireworks" { return fireworks_run(cells, info, lines); }
    if name == "spotlights" { return spotlights_run(cells, info, lines); }
    if name == "errorcorrect" { return errorcorrect_run(cells, info, lines); }
    if name == "crumble" { return crumble_run(cells, info, lines); }
    if name == "smoke" { return smoke_run(cells, info, lines); }
    if name == "randomsequence" { return randomsequence_run(cells, info, lines); }
    if name == "orbittingvolley" { return orbittingvolley_run(cells, info, lines); }
    if name == "bubbles" { return bubbles_run(cells, info, lines); }
    if name == "beams" { return beams_run(cells, info, lines); }
    if name == "laseretch" { return laseretch_run(cells, info, lines); }
    if name == "print" { return print_run(cells, info, lines); }
    if name == "rings" { return rings_run(cells, info, lines); }
    if name == "synthgrid" { return synthgrid_run(cells, info, lines); }
    if name == "matrix" { return matrix_run(cells, info, lines); }
    if name == "vhstape" { return vhstape_run(cells, info, lines); }
    if name == "breakout" { return breakout_run(cells, info); }
    if name == "life" { return life_run(cells, info); }
    if name == "pipes" { return pipes_run(cells, info); }
    if name == "tetris" { return tetris_run(cells, info); }
    if name == "waves" { return waves_run(cells, info, lines); }
    if name == "swarm" { return swarm_run(cells, info, lines); }
    if name == "unstable" { return unstable_run(cells, info, lines); }
    if name == "thunderstorm" { return thunderstorm_run(cells, info, lines); }
    return digest_run_new();
}

pub fn port_session_new(name: String, cols: Int, rows: Int, wordmark: String) -> PortSession {
    let lines: List[String] = port_lines(wordmark, cols, rows);
    let info: CanvasInfo = art_block(lines, canvas_info(cols, rows));
    let cells: List[CellGeom] = canvas_cells(info, lines);
    let run: DigestRun = port_run_all(name, cells, info, lines);
    let pf: List[PcFrame] = run.pc_frames;
    let mut first: List[PaintCell] = list_new();
    if list_len(pf) > 0 {
        let f0: PcFrame = list_get(pf, 0);
        first = f0.cells;
    }
    return PortSession {
        name: name, cols: cols, rows: rows,
        last: first, settled: list_len(pf) == 1,
        tick: 0 - 1, wm: wordmark, pf: pf,
        plasma: plasma_new(cells, info), ripple: ripple_new(cells, info),
        aurora: aurora_new(cells, info), chaos: chaos_new(cells, info),
        metaballs: metaballs_new(cells, info), moire: moire_new(cells, info),
        cosmos: cosmos_new(cells, info), radar: radar_new(cells, info),
        tunnel: tunnel_new(cells, info), mystify: mystify_new(cells, info)
    };
}

fn port_step_world(s: PortSession, out: PortSession) -> PortSession {
    let mut o: PortSession = out;
    let mut pcs: List[PaintCell] = list_new();
    if s.name == "plasma" {
        pcs = plasma_next(s.plasma);
        o.plasma = plasma_advance(s.plasma);
    }
    else if s.name == "ripple" {
        pcs = ripple_next(s.ripple);
        o.ripple = ripple_advance(s.ripple);
    }
    else if s.name == "aurora" {
        pcs = aurora_next(s.aurora);
        o.aurora = aurora_advance(s.aurora);
    }
    else if s.name == "chaos" {
        pcs = chaos_next(s.chaos);
        o.chaos = chaos_advance(s.chaos);
    }
    else if s.name == "metaballs" {
        pcs = metaballs_next(s.metaballs);
        o.metaballs = metaballs_advance(s.metaballs);
    }
    else if s.name == "moire" {
        pcs = moire_next(s.moire);
        o.moire = moire_advance(s.moire);
    }
    else if s.name == "cosmos" {
        pcs = cosmos_next(s.cosmos);
        o.cosmos = cosmos_advance(s.cosmos);
    }
    else if s.name == "radar" {
        pcs = radar_next(s.radar);
        o.radar = radar_advance(s.radar);
    }
    else if s.name == "tunnel" {
        pcs = tunnel_next(s.tunnel);
        o.tunnel = tunnel_advance(s.tunnel);
    }
    else if s.name == "mystify" {
        pcs = mystify_next(s.mystify);
        o.mystify = mystify_advance(s.mystify);
    }
    if list_len(pcs) == 0 {
        o.settled = true;
        return o;
    }
    o.last = pcs;
    return o;
}

pub fn port_session_next(s: PortSession) -> PortSession {
    let mut out: PortSession = s;
    out.tick = s.tick + 1;
    let n: Int = list_len(s.pf);
    if n > 0 {
        if s.settled { return out; }
        let idx: Int = if out.tick >= n { n - 1 } else { out.tick };
        let fr: PcFrame = list_get(s.pf, idx);
        out.last = fr.cells;
        if out.tick >= n - 1 { out.settled = true; }
        return out;
    }
    if s.settled { return out; }
    return port_step_world(s, out);
}

pub fn port_session_frame(s: &PortSession) -> String {
    return port_compose(&s.last, s.cols, s.rows, s.tick, s.settled, s.wm);
}
