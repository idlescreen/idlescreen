// # Wordmark Renderer - 3-Tier Progressive Bevelled Banner onto the Cell Grid
//
// Logline: Rasterizes OS/custom wordmark banners with 3-tier scaling (22-row SuperFedora, scaled 5x5, 3x3) and 16-bit SNES bevel + gleam.
// Setup: Pure draw over CellGrid using the 5x5, 3x3, and SuperFedora font atlases. Zero ambient authority.
// Beats:
//   1. Select the progressive layout tier (SuperFedora 22-row, scaled 5x5, 1x 5x5, or 3x3 condensed) for the grid dimensions.
//   2. Centre the composed banner lines horizontally and vertically in the grid.
//   3. Stamp the 16-bit SNES vertical chrome bevel, diagonal specular gleam, and drop shadow.

import "core/cell.oo";
import "core/grid.oo";
import "fonts.oo";
import "wordmark.oo";
import "oostd/core/text/utf8_codepoint_length_law.oo";
import "oostd/core/text/utf8_stream.oo";

pub fn wm_measure(name: String) -> Int {
    let t: String = wm_text(name);
    if t == "" { return 0; }
    return chars_len(t) * 6 - 1;
}

fn wm_build_3x3(word: String) -> List[String] {
    let mut r0: String = "";
    let mut r1: String = "";
    let mut r2: String = "";
    let n: Int = chars_len(word);
    let mut i: Int = 0;
    while i < n {
        let pat: List[String] = font3_rows(char_at(word, i));
        let sep: String = if i + 1 < n { " " } else { "" };
        r0 = r0 + list_get(pat, 0) + sep;
        r1 = r1 + list_get(pat, 1) + sep;
        r2 = r2 + list_get(pat, 2) + sep;
        i = i + 1;
    }
    return list_push(list_push(list_push(list_new(), r0), r1), r2);
}

fn wm_build_5x5_scaled(word: String, scale: Int) -> List[String] {
    let sp: String = if scale >= 4 { "   " } else if scale >= 2 { "  " } else { " " };
    let n: Int = chars_len(word);
    let mut out: List[String] = list_new();
    let mut r: Int = 0;
    while r < 5 {
        let mut line: String = "";
        let mut ci: Int = 0;
        while ci < n {
            let pat: List[String] = font5_rows(char_at(word, ci));
            let base: String = list_get(pat, r);
            let blen: Int = bytes_len(base);
            let mut k: Int = 0;
            while k < blen {
                let b0: Int = byte_at(base, k);
                let bl: Int = utf8_lead_byte_len(b0);
                let step: Int = if bl > 0 { bl } else { 1 };
                let ch: String = if byte_at(base, k) == 32 { " " } else { "█" };
                let mut s: Int = 0;
                while s < scale {
                    line = line + ch;
                    s = s + 1;
                }
                k = k + step;
            }
            if ci + 1 < n { line = line + sp; }
            ci = ci + 1;
        }
        let mut sr: Int = 0;
        while sr < scale {
            out = list_push(out, line);
            sr = sr + 1;
        }
        r = r + 1;
    }
    return out;
}

pub fn wm_banner_lines(name: String, cols: Int, rows: Int) -> List[String] {
    let t: String = wm_text(name);
    let n: Int = chars_len(t);
    if n == 0 || cols < 1 || rows < 1 { return list_new(); }
    if t == "SUPERFEDORA" {
        if cols >= 90 && rows >= 22 { return font_sf_art(); }
        if cols >= 23 && rows >= 7 {
            let sup: List[String] = wm_build_3x3("SUPER");
            let fed: List[String] = wm_build_3x3("FEDORA");
            let mut sf: List[String] = list_push(sup, "");
            sf = list_push(sf, list_get(fed, 0));
            sf = list_push(sf, list_get(fed, 1));
            sf = list_push(sf, list_get(fed, 2));
            return sf;
        }
    }
    if cols >= 60 && rows >= 5 {
        if rows >= 40 && n * 20 + (n - 1) * 3 + 4 <= cols { return wm_build_5x5_scaled(t, 4); }
        if rows >= 30 && n * 15 + (n - 1) * 2 + 4 <= cols { return wm_build_5x5_scaled(t, 3); }
        if rows >= 24 && n * 10 + (n - 1) * 2 + 4 <= cols { return wm_build_5x5_scaled(t, 2); }
        let mut max_c: Int = (cols - 4) / 6;
        if max_c < 1 { max_c = 1; }
        let sub: String = if n > max_c { str_slice(t, 0, max_c) } else { t };
        return wm_build_5x5_scaled(sub, 1);
    }
    if cols >= 25 && rows >= 3 {
        let mut b3: Int = (cols - 2) / 4;
        if b3 < 1 { b3 = 1; }
        let sub3: String = if n > b3 { (if b3 > 1 { str_slice(t, 0, b3 - 1) + "." } else { str_slice(t, 0, 1) }) } else { t };
        return wm_build_3x3(sub3);
    }
    let max_v: Int = if rows > 4 { rows - 4 } else { 1 };
    let v_str: String = if t == "SUPERFEDORA" { "SUPER FEDORA" } else { t };
    let mut v_out: List[String] = list_new();
    let mut vi: Int = 0;
    while vi < chars_len(v_str) && vi < max_v {
        let vc: String = char_at(v_str, vi);
        v_out = list_push(v_out, if vc == " " { " " } else { "█" });
        vi = vi + 1;
    }
    return v_out;
}

fn wm_stamp_line(g: CellGrid, line: String, ox: Int, y: Int, min_y: Int, max_y: Int, is_sf: Bool, gleam_pos: Int) -> CellGrid {
    let mut out: CellGrid = g;
    let base_fg: Int = wm_bevel_color(y, min_y, max_y, is_sf);
    let shad_fg: Int = wm_shadow_color();
    let len: Int = bytes_len(line);
    let mut i: Int = 0;
    let mut ci: Int = 0;
    while i < len {
        let b0: Int = byte_at(line, i);
        let bl: Int = utf8_lead_byte_len(b0);
        let step: Int = if bl > 0 { bl } else { 1 };
        let ch: String = str_slice(line, i, i + step);
        let x: Int = ox + ci;
        if x >= 0 && x < out.cols {
            let cur: TerminalCell = grid_get(out, x, y);
            if ch != " " {
                let diag: Int = x + y * 2;
                let dist: Int = if diag - gleam_pos < 0 { gleam_pos - diag } else { diag - gleam_pos };
                let fg: Int = if dist == 0 {
                    rgb(245, 255, 255)
                } else if dist == 1 {
                    rgb(255, 225, 110)
                } else if dist == 2 {
                    rgb(130, 235, 255)
                } else {
                    base_fg
                };
                out = grid_set(out, x, y, cell_new(ch, fg, cur.bg, true));
                if x + 1 < out.cols && y + 1 < out.rows {
                    let sc: TerminalCell = grid_get(out, x + 1, y + 1);
                    out = grid_set(out, x + 1, y + 1, cell_new("░", shad_fg, sc.bg, false));
                }
            } else if cur.ch != "░" {
                out = grid_set(out, x, y, cell_new(" ", shad_fg, cur.bg, false));
            }
        }
        i = i + step;
        ci = ci + 1;
    }
    return out;
}

pub fn wm_render_at(g: CellGrid, name: String, oy: Int, tick: Int) -> CellGrid {
    let lines: List[String] = wm_banner_lines(name, g.cols, g.rows);
    let h: Int = list_len(lines);
    if h == 0 { return g; }
    let mut max_w: Int = 0;
    let mut i: Int = 0;
    while i < h {
        let lw: Int = utf8_codepoint_count(list_get(lines, i));
        if lw > max_w { max_w = lw; }
        i = i + 1;
    }
    let ox: Int = if g.cols > max_w { (g.cols - max_w) / 2 } else { 0 };
    let is_sf: Bool = wm_text(name) == "SUPERFEDORA" && (h == 22 || h == 7);
    let gleam_span: Int = if g.cols + g.rows * 2 + 28 > 0 { g.cols + g.rows * 2 + 28 } else { 1 };
    let gleam_pos: Int = (tick * 3) % gleam_span;
    let mut out: CellGrid = g;
    let mut r: Int = 0;
    while r < h {
        let y: Int = oy + r;
        if y >= 0 && y < out.rows {
            out = wm_stamp_line(out, list_get(lines, r), ox, y, oy, oy + h - 1, is_sf, gleam_pos);
        }
        r = r + 1;
    }
    return out;
}

pub fn wm_render(g: CellGrid, name: String, tick: Int) -> CellGrid {
    let lines: List[String] = wm_banner_lines(name, g.cols, g.rows);
    let h: Int = list_len(lines);
    if h == 0 { return g; }
    let oy: Int = if g.rows > h { (g.rows - h) / 2 } else { 0 };
    return wm_render_at(g, name, oy, tick);
}
