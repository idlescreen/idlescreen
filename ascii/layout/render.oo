// # Wordmark Renderer - Bevelled Block Text onto the Cell Grid
//
// Logline: Rasterizes a wordmark preset onto the grid with drop shadow, gradient fill, and top-edge bevel highlight.
// Setup: Pure draw over CellGrid using the 7x7 font atlas and preset palettes. Zero ambient authority.
// Beats:
//   1. Centre the composed wordmark horizontally and vertically in the grid.
//   2. Stamp the shadow pass, then the gradient body pass letter by letter.
//   3. Overlay the lighter bevel on pixels that sit on a letter's top edge.

import "core/cell.oo";
import "core/grid.oo";
import "fonts.oo";
import "wordmark.oo";

pub fn wm_measure(name: String) -> Int {
    let t: String = wm_text(name);
    return chars_len(t) * (font7_width() + 1) - 1;
}

fn wm_light(c: Int) -> Int {
    let gain: Int = wm_hi_gain();
    let mut r: Int = rgb_r(c) + gain;
    let mut g: Int = rgb_g(c) + gain;
    let mut b: Int = rgb_b(c) + gain;
    if r > 255 { r = 255; }
    if g > 255 { g = 255; }
    if b > 255 { b = 255; }
    return rgb(r, g, b);
}

fn wm_pixel(c: TerminalCell, t: String, n: Int, ox: Int, oy: Int, x: Int, y: Int, tick: Int, name: String) -> TerminalCell {
    let mut res: TerminalCell = c;
    let mut i: Int = 0;
    while i < n {
        let lox: Int = ox + i * 8;
        let ch: String = char_at(t, i);
        let sx: Int = x - (lox + 2);
        let sy: Int = y - (oy + 1);
        if font7_char_at(ch, sx, sy) {
            res = cell_new("░", wm_shadow_color(), res.bg, false);
        }
        let bx: Int = x - lox;
        let by: Int = y - oy;
        if font7_char_at(ch, bx, by) {
            let edge: Bool = !font7_char_at(ch, bx, by - 1);
            let fg: Int = wm_column_color(name, i, n, tick);
            let col_fg: Int = if edge { wm_light(fg) } else { fg };
            res = cell_new("█", col_fg, res.bg, edge);
        }
        i = i + 1;
    }
    return res;
}

pub fn wm_render(g: CellGrid, name: String, tick: Int) -> CellGrid {
    let t: String = wm_text(name);
    let total: Int = chars_len(t) * (font7_width() + 1) - 1;
    if total > g.cols || font7_height() + 2 > g.rows { return g; }
    return wm_render_at(g, name, (g.rows - font7_height()) / 2, tick);
}

pub fn wm_render_at(g: CellGrid, name: String, oy: Int, tick: Int) -> CellGrid {
    let t: String = wm_text(name);
    let n: Int = chars_len(t);
    let total: Int = n * (font7_width() + 1) - 1;
    if total > g.cols { return g; }
    let ox: Int = (g.cols - total) / 2;
    let mut cells: List[TerminalCell] = list_new();
    let mut y: Int = 0;
    while y < g.rows {
        let mut x: Int = 0;
        while x < g.cols {
            let c: TerminalCell = grid_get(g, x, y);
            if y >= oy && y < oy + 8 && x >= ox && x < ox + total + 2 {
                cells = list_push(cells, wm_pixel(c, t, n, ox, oy, x, y, tick, name));
            } else {
                cells = list_push(cells, c);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return CellGrid { cols: g.cols, rows: g.rows, cells: cells };
}
