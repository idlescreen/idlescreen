// # Scene Canvas - Cell Draw Helpers, 16-Bit Pixel-Art Ramp, Hash Noise, Palette Ramps
//
// Logline: Drawing verbs shared by all scenes: put, text, fill, hash noise, 16-bit block glyph quantization, and HSV ramps.
// Setup: Pure integer arithmetic over CellGrid and Int-packed RGB.
// Beats:
//   1. Stamp cells, strings, and filled fields with 16-bit pixel-art glyph quantization.
//   2. Map intensity onto the 10-step Unicode block density ramp.
//   3. Fold coordinates and tick into hash noise and HSV colour ramps.

import "core/cell.oo";
import "core/grid.oo";
import "ascii/text.oo";

pub fn cv_put_b(g: CellGrid, x: Int, y: Int, ch: String, fg: Int, bg: Int, bold: Bool) -> CellGrid {
    let is_blk: Bool = ch == " " || ch == "█" || ch == "▀" || ch == "▄" ||
        ch == "▌" || ch == "▐" || ch == "░" || ch == "▒" || ch == "▓" ||
        ch == "▖" || ch == "▗" || ch == "▘" || ch == "▝" || ch == "▚" ||
        ch == "▞" || ch == "▙" || ch == "▛" || ch == "▜" || ch == "▟";
    if is_blk {
        let is_solid: Bool = ch == "█";
        return grid_put(g, x, y, ch, fg, bg, bold || is_solid);
    }
    let mut h: Int = (byte_at(ch, 0) * 31 + x * 17 + y * 13) & 2147483647;
    if h < 0 { h = 0 - h; }
    if ch == "@" || ch == "#" || ch == "%" || ch == "&" || ch == "W" || ch == "M" || ch == "B" || ch == "8" {
        let t0: Int = h % 5;
        let g0: String = if t0 == 0 { "▓" } else if t0 == 1 { "▛" } else if t0 == 2 { "▟" } else if t0 == 3 { "▙" } else { "▜" };
        return grid_put(g, x, y, g0, fg, bg, bold);
    }
    if ch == "." || ch == "," || ch == "'" || ch == "`" || ch == ":" || ch == ";" || ch == "-" || ch == "_" || ch == "~" || ch == "·" {
        let t1: Int = h % 5;
        let g1: String = if t1 == 0 { "░" } else if t1 == 1 { "▖" } else if t1 == 2 { "▗" } else if t1 == 3 { "▘" } else { "▝" };
        return grid_put(g, x, y, g1, fg, bg, bold);
    }
    if ch == "*" || ch == "+" || ch == "o" || ch == "O" || ch == "^" || ch == "/" || ch == "\\" || ch == "|" || ch == "=" {
        let t2: Int = h % 8;
        let g2: String = if t2 == 0 { "▀" } else if t2 == 1 { "▄" } else if t2 == 2 { "▌" } else if t2 == 3 {
            "▐"
        } else if t2 == 4 { "▞" } else if t2 == 5 { "▚" } else if t2 == 6 { "▘" } else { "▝" };
        return grid_put(g, x, y, g2, fg, bg, bold);
    }
    return grid_put(g, x, y, ch, fg, bg, bold);
}

pub fn cv_put(g: CellGrid, x: Int, y: Int, ch: String, fg: Int, bg: Int) -> CellGrid {
    return cv_put_b(g, x, y, ch, fg, bg, false);
}

pub fn cv_text(g: CellGrid, x: Int, y: Int, s: String, fg: Int, bg: Int) -> CellGrid {
    let mut out: CellGrid = g;
    let cs: List[String] = t_chars(s);
    let mut i: Int = 0;
    while i < list_len(cs) {
        out = grid_put(out, x + i, y, list_get(cs, i), fg, bg, true);
        i = i + 1;
    }
    return out;
}

pub fn cv_fill(g: CellGrid, ch: String, fg: Int, bg: Int) -> CellGrid {
    let mut out: CellGrid = g;
    let mut y: Int = 0;
    while y < g.rows {
        let mut x: Int = 0;
        while x < g.cols {
            out = grid_put(out, x, y, ch, fg, bg, false);
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}

pub fn cv_hash(x: Int, y: Int, t: Int) -> Int {
    let mut h: Int = (x * 374761393 + y * 668265263 + t * 2147483647) & 2147483647;
    h = (h * 1274126177) & 2147483647;
    h = h - (h >> 16);
    if h < 0 { return 0 - h; }
    return h;
}

pub fn cv_ramp(v: Int) -> String {
    if v <= 0 { return " "; }
    if v == 1 { return "░"; }
    if v == 2 { return "▖"; }
    if v == 3 { return "▘"; }
    if v == 4 { return "▒"; }
    if v == 5 { return "▞"; }
    if v == 6 { return "▓"; }
    if v == 7 { return "▛"; }
    if v == 8 { return "▟"; }
    return "█";
}

pub fn cv_hue(frac: Int) -> Int {
    let mut f: Int = frac % 600;
    if f < 0 { f = f + 600; }
    let seg: Int = f / 100;
    let k: Int = (f % 100) * 255 / 100;
    let q: Int = 255 - k;
    if seg == 0 { return rgb(255, k, 0); }
    if seg == 1 { return rgb(q, 255, 0); }
    if seg == 2 { return rgb(0, 255, k); }
    if seg == 3 { return rgb(0, q, 255); }
    if seg == 4 { return rgb(k, 0, 255); }
    return rgb(255, 0, q);
}

pub fn cv_mix(a: Int, b: Int, k: Int) -> Int {
    let mut kk: Int = k;
    if kk < 0 { kk = 0; }
    if kk > 255 { kk = 255; }
    let r: Int = (rgb_r(a) * (255 - kk) + rgb_r(b) * kk) / 255;
    let g: Int = (rgb_g(a) * (255 - kk) + rgb_g(b) * kk) / 255;
    let bch: Int = (rgb_b(a) * (255 - kk) + rgb_b(b) * kk) / 255;
    return rgb(r, g, bch);
}
