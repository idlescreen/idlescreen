// # ANSI Emitter - Cell Grid to 24-Bit Terminal Escape Stream
//
// Logline: Serialises a cell grid into a 24-bit truecolor ANSI frame with run-based escape coalescing.
// Setup: Pure string composition. Escape emission happens on caller-controlled writes only.
// Beats:
//   1. Walk the grid row-major and emit SGR sequences only when colour or weight changes.
//   2. Encode each foreground as 38;2 and each background as 48;2.
//   3. Reset attributes and advance lines between rows.

import "core/cell.oo";
import "core/grid.oo";

fn ansi_esc() -> String {
    let mut b: List[Int] = bytes_new();
    b = bytes_push(b, 27);
    let s: String = bytes_to_str(b);
    return s;
}

fn sgr_fg(c: Int, bold: Bool) -> String {
    let mut s: String = ansi_esc();
    s = s + "[38;2;";
    s = s + rgb_r(c).to_string();
    s = s + ";";
    s = s + rgb_g(c).to_string();
    s = s + ";";
    s = s + rgb_b(c).to_string();
    s = s + if bold { ";1m" } else { "m" };
    return s;
}

fn sgr_bg(c: Int) -> String {
    let mut s: String = ansi_esc();
    s = s + "[48;2;";
    s = s + rgb_r(c).to_string();
    s = s + ";";
    s = s + rgb_g(c).to_string();
    s = s + ";";
    s = s + rgb_b(c).to_string();
    s = s + "m";
    return s;
}

pub fn ansi_home() -> String {
    let mut s: String = ansi_esc();
    s = s + "[H";
    return s;
}

pub fn ansi_reset() -> String {
    let mut s: String = ansi_esc();
    s = s + "[0m";
    return s;
}

pub fn ansi_render_row(g: CellGrid, y: Int) -> String {
    let mut out: String = "";
    let mut last_fg: Int = -1;
    let mut last_bg: Int = -1;
    let mut last_bold: Bool = false;
    let mut x: Int = 0;
    while x < g.cols {
        let idx: Int = y * g.cols + x;
        let fg: Int = list_get(g.fgs, idx);
        let bg: Int = list_get(g.bgs, idx);
        let bold: Bool = list_get(g.bolds, idx) != 0;
        if fg != last_fg || bold != last_bold {
            let fs: String = sgr_fg(fg, bold);
            out = out + fs;
            last_fg = fg;
            last_bold = bold;
        }
        if bg != last_bg {
            let bs: String = sgr_bg(bg);
            out = out + bs;
            last_bg = bg;
        }
        let ch: String = list_get(g.chs, idx);
        out = out + ch;
        x = x + 1;
    }
    let rst: String = ansi_reset();
    out = out + rst;
    return out;
}

pub fn ansi_render(g: CellGrid) -> String {
    let mut out: String = "";
    let mut y: Int = 0;
    while y < g.rows {
        let row: String = ansi_render_row(g, y);
        out = out + row;
        if y + 1 < g.rows { out = out + "\r\n"; }
        y = y + 1;
    }
    return out;
}

pub fn ansi_frame(g: CellGrid) -> String {
    let body: String = ansi_render(g);
    let mut out: String = ansi_home();
    out = out + body;
    return out;
}
