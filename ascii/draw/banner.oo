// # Banner Draw - Scrolling Marquee and Scene Title Chrome
//
// Logline: Paints the scrolling text marquee and the framed scene title bar used by the tour chrome.
// Setup: Pure draw over CellGrid. Operates with zero ambient authority.
// Beats:
//   1. Marquee-scroll a message across a row by tick.
//   2. Draw the double-rule scene title bar on the top row.
//   3. Report the marquee window width for callers.

import "core/grid.oo";
import "ascii/canvas.oo";
import "ascii/text.oo";

pub fn banner_marquee(g: CellGrid, y: Int, text: String, tick: Int, fg: Int, bg: Int) -> CellGrid {
    if y < 0 || y >= g.rows { return g; }
    let w: Int = g.cols;
    let cs: List[String] = t_chars(text);
    let span: Int = list_len(cs) + w;
    let off: Int = tick % if span > 0 { span } else { 1 };
    let mut out: CellGrid = g;
    let mut i: Int = 0;
    while i < list_len(cs) {
        let pos: Int = i + w - off;
        if pos >= 0 && pos < w {
            out = cv_put(out, pos, y, list_get(cs, i), fg, bg);
        }
        i = i + 1;
    }
    return out;
}

pub fn banner_title(g: CellGrid, title: String, fg: Int, bg: Int) -> CellGrid {
    if g.cols < 8 || g.rows < 1 { return g; }
    let up: String = to_uppercase(title);
    let mut t: String = " " + up;
    t = t + " ";
    let mut line: String = "";
    let tw: Int = t_width(t);
    let pad_l: Int = if (g.cols - tw) / 2 > 0 { (g.cols - tw) / 2 } else { 0 };
    let mut i: Int = 0;
    while i < pad_l {
        line = line + "─";
        i = i + 1;
    }
    line = line + t;
    while t_width(line) < g.cols { line = line + "─"; }
    let mut out: CellGrid = g;
    let cs: List[String] = t_chars(line);
    i = 0;
    while i < g.cols && i < list_len(cs) {
        out = cv_put_b(out, i, 0, list_get(cs, i), fg, bg, true);
        i = i + 1;
    }
    return out;
}
