// # Scene Chaos - Logistic Map Bifurcation Dust
//
// Logline: The logistic-map bifurcation diagram rendered as glowing dust bands marching leftward.
// Setup: Pure integer arithmetic over CellGrid with milli-unit fixed point. Zero ambient authority.
// Beats:
//   1. Iterate the logistic map per column at a marching parameter.
//   2. Plot attractor values as bright dust on the row axis.
//   3. Fade older iterates into the indigo field.

import "core/cell.oo";
import "core/grid.oo";
import "ascii/canvas.oo";

pub fn scene_chaos(g: CellGrid, tick: Int) -> CellGrid {
    let mut out: CellGrid = cv_fill(g, " ", rgb(20, 15, 40), rgb(3, 2, 10));
    let mut x: Int = 0;
    while x < g.cols {
        let r: Int = 2900 + ((x + tick) % g.cols) * 900 / (if g.cols > 0 { g.cols } else { 1 });
        let mut v: Int = 500;
        let mut i: Int = 0;
        while i < 40 {
            v = r * v * (1000 - v) / 1000000;
            if i > 25 {
                let row: Int = (1000 - v) * (g.rows - 1) / 1000;
                let c: Int = cv_mix(rgb(20, 15, 40), rgb(255, 200, 120), 160 + (i - 25) * 6);
                out = cv_put(out, x, row, "·", c, rgb(3, 2, 10));
            }
            i = i + 1;
        }
        x = x + 1;
    }
    return out;
}
