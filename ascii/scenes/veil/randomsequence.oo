// # Scene RandomSequence - Deterministic Glyph Noise Field
//
// Logline: A fresh deterministic noise frame every four ticks, like channel static with coloured speckle.
// Setup: Pure arithmetic over CellGrid. Zero ambient authority.
// Beats:
//   1. Hash each cell against a quantized epoch so frames hold for four ticks.
//   2. Select glyph and colour speckle by hash bucket.
//   3. Keep a low floor so the static reads as texture not snow.

import "core/cell.oo";
import "ascii/canvas.oo";

pub fn scene_randomsequence(g: CellGrid, tick: Int) -> CellGrid {
    let epoch: Int = tick / 4;
    let mut out: CellGrid = cv_fill(g, " ", rgb(40, 40, 40), rgb(5, 5, 8));
    let mut y: Int = 0;
    while y < g.rows {
        let mut x: Int = 0;
        while x < g.cols {
            let h: Int = cv_hash(x, y, epoch);
            let k: Int = h % 20;
            if k < 6 {
                let ch: String = if k == 0 { "#" } else if k == 1 { "*" } else if k == 2 { "+" } else if k == 3 { "%" } else if k == 4 { ":" } else { "·" };
                let c: Int = rgb(80 + (h % 176), 80 + ((h / 7) % 176), 80 + ((h / 13) % 176));
                out = cv_put(out, x, y, ch, c, rgb(5, 5, 8));
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}
