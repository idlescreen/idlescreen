// # Scene Breakout - Paddle, Ball, and Brick Wall Tableau
//
// Logline: A self-playing breakout rally: paddle tracking the ball across a rainbow brick wall.
// Setup: Pure arithmetic over CellGrid. Zero ambient authority.
// Beats:
//   1. Lay the four-row rainbow brick wall at the top.
//   2. Trace the ball on a bouncing diagonal course.
//   3. Track the paddle under the ball and clear bricks it passes.

import "core/cell.oo";
import "core/grid.oo";
import "ascii/canvas.oo";

pub fn scene_breakout(g: CellGrid, tick: Int) -> CellGrid {
    let mut out: CellGrid = cv_fill(g, " ", rgb(30, 30, 40), rgb(4, 4, 8));
    let mut y: Int = 0;
    while y < 4 && y < g.rows {
        let band: List[Int]= list_push(
            list_push(list_push(list_push(list_new(), rgb(255, 90, 90)), rgb(255, 190, 80)), rgb(120, 230, 120)),
            rgb(90, 160, 255)
        );
        let mut x: Int = 1;
        while x < g.cols - 1 {
            if x % 4 != 0 && cv_hash(x, y, tick / 60) % 9 != 0 {
                out = cv_put(out, x, y, "█", list_get(band, y), rgb(4, 4, 8));
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let per: Int = g.cols * 2 - 4;
    let bx: Int = if (tick % per) < g.cols - 2 { 2 + (tick % per) } else { g.cols - (tick % per) + g.cols - 4 };
    let vper: Int = g.rows * 2 - 10;
    let by: Int = 5 + ((tick * 2) % if vper > 0 { vper } else { 1 }) % (g.rows - 7);
    let byy: Int = if by < 5 { 5 } else { by };
    out = cv_put_b(out, bx, byy, "●", rgb(255, 255, 200), rgb(4, 4, 8), true);
    let py: Int = g.rows - 2;
    let px: Int = bx - 3;
    let mut i: Int = 0;
    while i < 7 {
        out = cv_put(out, px + i, py, "▬", rgb(230, 230, 240), rgb(4, 4, 8));
        i = i + 1;
    }
    return out;
}
