// # Scene SynthGrid - Retro Perspective Grid Horizon
//
// Logline: Synthwave perspective grid rolling toward a neon horizon with a rising sun disc.
// Setup: Pure integer arithmetic over CellGrid. Zero ambient authority.
// Beats:
//   1. Draw the magenta sun disc on the horizon line.
//   2. Fan perspective grid lines toward a vanishing centre.
//   3. Scroll horizontal lines downward to fake forward motion.

import "core/cell.oo";
import "core/grid.oo";
import "core/imath.oo";
import "ascii/canvas.oo";

pub fn scene_synthgrid(g: CellGrid, tick: Int) -> CellGrid {
    let mut out: CellGrid = cv_fill(g, " ", rgb(20, 10, 40), rgb(8, 2, 18));
    let horizon: Int = g.rows / 3;
    let cx: Int = g.cols / 2;
    let mut y: Int = 0;
    while y < g.rows {
        let mut x: Int = 0;
        while x < g.cols {
            if y < horizon {
                let d: Int = idist((x - cx) * 55, (y - horizon + 6) * 100) / 100;
                if d <= 7 {
                    let band: Bool = d >= 6;
                    let k: Int = if band { 120 } else { 60 + d * 30 };
                    out = cv_put(out, x, y, if band { "▒" } else { "█" }, cv_mix(rgb(120, 20, 80), rgb(255, 160, 60), k), rgb(8, 2, 18));
                }
            } else {
                let depth: Int = (y - horizon) * 100 / (if g.rows - horizon > 0 { g.rows - horizon } else { 1 }) + 1;
                let lane: Int = iabs((x - cx) * 60 / depth) % 6;
                let scroll: Int = ((100 / depth) + tick / 2) % 4;
                if lane == 0 && x != cx {
                    out = cv_put(out, x, y, "│", rgb(60, 220, 255), rgb(8, 2, 18));
                } else if scroll == 0 && y % 2 == 0 {
                    out = cv_put(out, x, y, "─", rgb(200, 60, 180), rgb(8, 2, 18));
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}
