// # scenes Dispatch Anchor - 53-Scene Render Router
//
// Logline: Routes a roster index to the matching scene render function across the eight family anchors.
// Setup: Pure dispatch over CellGrid. Imports the eight family anchors.
// Beats:
//   1. Match the roster index to its scene renderer.
//   2. Return the rendered grid or the input grid on an unknown index.
//   3. Keep the roster order identical to effects.oo.

import "ascii/effects.oo";
import "wave/anchor.oo";
import "fall/anchor.oo";
import "grow/anchor.oo";
import "text/anchor.oo";
import "orbit/anchor.oo";
import "veil/anchor.oo";
import "deep/anchor.oo";
import "left/anchor.oo";
import "core/grid.oo";

fn scene_render_b(n: String, g: CellGrid, tick: Int) -> CellGrid {
    if n == "plasma" { return scene_plasma(g, tick); }
    if n == "pour" { return scene_pour(g, tick); }
    if n == "print" { return scene_print(g, tick); }
    if n == "radar" { return scene_radar(g, tick); }
    if n == "rain" { return scene_rain(g, tick); }
    if n == "randomsequence" { return scene_randomsequence(g, tick); }
    if n == "rings" { return scene_rings(g, tick); }
    if n == "ripple" { return scene_ripple(g, tick); }
    if n == "scattered" { return scene_scattered(g, tick); }
    if n == "slice" { return scene_slice(g, tick); }
    if n == "slide" { return scene_slide(g, tick); }
    if n == "smoke" { return scene_smoke(g, tick); }
    if n == "spotlights" { return scene_spotlights(g, tick); }
    if n == "spray" { return scene_spray(g, tick); }
    if n == "swarm" { return scene_swarm(g, tick); }
    if n == "sweep" { return scene_sweep(g, tick); }
    if n == "synthgrid" { return scene_synthgrid(g, tick); }
    if n == "tetris" { return scene_tetris(g, tick); }
    if n == "thunderstorm" { return scene_thunderstorm(g, tick); }
    if n == "tunnel" { return scene_tunnel(g, tick); }
    if n == "unstable" { return scene_unstable(g, tick); }
    if n == "vhstape" { return scene_vhstape(g, tick); }
    if n == "waves" { return scene_waves(g, tick); }
    if n == "wipe" { return scene_wipe(g, tick); }
    if n == "zero" { return scene_zero(g, tick); }
    return g;
}

pub fn scene_render(idx: Int, g: CellGrid, tick: Int) -> CellGrid {
    let n: String = effects_name(idx);
    if n == "aurora" { return scene_aurora(g, tick); }
    if n == "beams" { return scene_beams(g, tick); }
    if n == "binarypath" { return scene_binarypath(g, tick); }
    if n == "blackhole" { return scene_blackhole(g, tick); }
    if n == "bouncyballs" { return scene_bouncyballs(g, tick); }
    if n == "breakout" { return scene_breakout(g, tick); }
    if n == "bubbles" { return scene_bubbles(g, tick); }
    if n == "burn" { return scene_burn(g, tick); }
    if n == "chaos" { return scene_chaos(g, tick); }
    if n == "colorshift" { return scene_colorshift(g, tick); }
    if n == "cosmos" { return scene_cosmos(g, tick); }
    if n == "crumble" { return scene_crumble(g, tick); }
    if n == "decrypt" { return scene_decrypt(g, tick); }
    if n == "errorcorrect" { return scene_errorcorrect(g, tick); }
    if n == "expand" { return scene_expand(g, tick); }
    if n == "fireworks" { return scene_fireworks(g, tick); }
    if n == "highlight" { return scene_highlight(g, tick); }
    if n == "laseretch" { return scene_laseretch(g, tick); }
    if n == "life" { return scene_life(g, tick); }
    if n == "matrix" { return scene_matrix(g, tick); }
    if n == "metaballs" { return scene_metaballs(g, tick); }
    if n == "middleout" { return scene_middleout(g, tick); }
    if n == "mmx" { return scene_mmx(g, tick); }
    if n == "moire" { return scene_moire(g, tick); }
    if n == "mystify" { return scene_mystify(g, tick); }
    if n == "orbittingvolley" { return scene_orbittingvolley(g, tick); }
    if n == "overflow" { return scene_overflow(g, tick); }
    if n == "pipes" { return scene_pipes(g, tick); }
    return scene_render_b(n, g, tick);
}
