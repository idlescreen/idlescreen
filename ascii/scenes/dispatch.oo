// # scenes Dispatch Anchor - 53-Scene Render Router
//
// Logline: Routes a roster index to the matching scene render function across the eight family anchors.
// Setup: Pure dispatch over CellGrid. Imports the eight family anchors.
// Beats:
//   1. Match the roster index to its scene renderer.
//   2. Return the rendered grid or the input grid on an unknown index.
//   3. Keep the roster order identical to effects.oo.

import "ascii/effects.oo";
import "wave/anchor.oo";
import "fall/anchor.oo";
import "grow/anchor.oo";
import "text/anchor.oo";
import "orbit/anchor.oo";
import "veil/anchor.oo";
import "deep/anchor.oo";
import "left/anchor.oo";
import "core/grid.oo";

fn scene_render_b(n: String, g: CellGrid, tick: Int) -> CellGrid {
    let mut r: CellGrid = g;
    if n == "plasma" { r = scene_plasma(g, tick); }
    else if n == "pour" { r = scene_pour(g, tick); }
    else if n == "print" { r = scene_print(g, tick); }
    else if n == "radar" { r = scene_radar(g, tick); }
    else if n == "rain" { r = scene_rain(g, tick); }
    else if n == "randomsequence" { r = scene_randomsequence(g, tick); }
    else if n == "rings" { r = scene_rings(g, tick); }
    else if n == "ripple" { r = scene_ripple(g, tick); }
    else if n == "scattered" { r = scene_scattered(g, tick); }
    else if n == "slice" { r = scene_slice(g, tick); }
    else if n == "slide" { r = scene_slide(g, tick); }
    else if n == "smoke" { r = scene_smoke(g, tick); }
    else if n == "spotlights" { r = scene_spotlights(g, tick); }
    else if n == "spray" { r = scene_spray(g, tick); }
    else if n == "swarm" { r = scene_swarm(g, tick); }
    else if n == "sweep" { r = scene_sweep(g, tick); }
    else if n == "synthgrid" { r = scene_synthgrid(g, tick); }
    else if n == "tetris" { r = scene_tetris(g, tick); }
    else if n == "thunderstorm" { r = scene_thunderstorm(g, tick); }
    else if n == "tunnel" { r = scene_tunnel(g, tick); }
    else if n == "unstable" { r = scene_unstable(g, tick); }
    else if n == "vhstape" { r = scene_vhstape(g, tick); }
    else if n == "waves" { r = scene_waves(g, tick); }
    else if n == "wipe" { r = scene_wipe(g, tick); }
    else if n == "zero" { r = scene_zero(g, tick); }
    return r;
}

pub fn scene_render(idx: Int, g: CellGrid, tick: Int) -> CellGrid {
    let n: String = effects_name(idx);
    let mut r: CellGrid = g;
    if n == "aurora" { r = scene_aurora(g, tick); }
    else if n == "beams" { r = scene_beams(g, tick); }
    else if n == "binarypath" { r = scene_binarypath(g, tick); }
    else if n == "blackhole" { r = scene_blackhole(g, tick); }
    else if n == "bouncyballs" { r = scene_bouncyballs(g, tick); }
    else if n == "breakout" { r = scene_breakout(g, tick); }
    else if n == "bubbles" { r = scene_bubbles(g, tick); }
    else if n == "burn" { r = scene_burn(g, tick); }
    else if n == "chaos" { r = scene_chaos(g, tick); }
    else if n == "colorshift" { r = scene_colorshift(g, tick); }
    else if n == "cosmos" { r = scene_cosmos(g, tick); }
    else if n == "crumble" { r = scene_crumble(g, tick); }
    else if n == "decrypt" { r = scene_decrypt(g, tick); }
    else if n == "errorcorrect" { r = scene_errorcorrect(g, tick); }
    else if n == "expand" { r = scene_expand(g, tick); }
    else if n == "fireworks" { r = scene_fireworks(g, tick); }
    else if n == "highlight" { r = scene_highlight(g, tick); }
    else if n == "laseretch" { r = scene_laseretch(g, tick); }
    else if n == "life" { r = scene_life(g, tick); }
    else if n == "matrix" { r = scene_matrix(g, tick); }
    else if n == "metaballs" { r = scene_metaballs(g, tick); }
    else if n == "middleout" { r = scene_middleout(g, tick); }
    else if n == "mmx" { r = scene_mmx(g, tick); }
    else if n == "moire" { r = scene_moire(g, tick); }
    else if n == "mystify" { r = scene_mystify(g, tick); }
    else if n == "orbittingvolley" { r = scene_orbittingvolley(g, tick); }
    else if n == "overflow" { r = scene_overflow(g, tick); }
    else if n == "pipes" { r = scene_pipes(g, tick); }
    else { r = scene_render_b(n, g, tick); }
    return r;
}
