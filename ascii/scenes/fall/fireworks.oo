// # Scene Fireworks - Mortar Launch and Radial Burst
//
// Logline: Periodic mortar launches arcing up and detonating into fading radial spark bursts.
// Setup: Pure integer arithmetic over CellGrid. Zero ambient authority.
// Beats:
//   1. Schedule one shell per cycle window by hash.
//   2. Draw the ascending trail while the shell climbs.
//   3. Fan sparks radially after detonation, fading with age.

import "core/cell.oo";
import "core/grid.oo";
import "core/imath.oo";
import "ascii/canvas.oo";

pub fn scene_fireworks(g: CellGrid, tick: Int) -> CellGrid {
    let mut out: CellGrid = cv_fill(g, " ", rgb(20, 20, 40), rgb(1, 1, 8));
    let cycle: Int = 24;
    let shell: Int = tick / cycle;
    let phase: Int = tick % cycle;
    let bx: Int = g.cols / 4 + (cv_hash(shell, 1, 3) % (if g.cols / 2 > 0 { g.cols / 2 } else { 1 }));
    let peak: Int = 3 + cv_hash(shell, 2, 5) % (if g.rows / 3 > 0 { g.rows / 3 } else { 1 });
    let hue: Int = (shell * 137) % 600;
    if phase < g.rows - peak {
        let hy: Int = g.rows - 1 - phase;
        out = cv_put(out, bx, hy, "•", rgb(255, 230, 160), rgb(1, 1, 8));
        if hy + 1 < g.rows { out = cv_put(out, bx, hy + 1, ":", rgb(160, 120, 60), rgb(1, 1, 8)); }
        if hy + 2 < g.rows { out = cv_put(out, bx, hy + 2, "·", rgb(80, 60, 30), rgb(1, 1, 8)); }
    } else {
        let age: Int = phase - (g.rows - peak);
        let mut a: Int = 0;
        while a < 12 {
            let ang: Int = a * 30;
            let r: Int = age * 2;
            let sx: Int = bx + icos(ang) * r / 1000;
            let sy: Int = peak + isin(ang) * r / 2000 + age * age / 8;
            if sx >= 0 && sx < g.cols && sy >= 0 && sy < g.rows {
                let fade: Int = 200 - age * 40;
                if fade > 40 {
                    out = cv_put(out, sx, sy, if age < 3 { "*" } else { "·" }, cv_mix(0, cv_hue(hue), fade), rgb(1, 1, 8));
                }
            }
            a = a + 1;
        }
    }
    return out;
}
